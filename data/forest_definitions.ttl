    ex:minAreaSI "0.1"^^xsd:float .

ex:Def_def_pol_2012_937 a ex:Definition ;
    rdfs:label "Land covered with forest plants or lacking such plants for a temporary period of..." ;
    ex:appliesTo ex:Country_Poland ;
    ex:country "Poland" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land covered with forest plants or lacking such plants for a temporary period of time as well as land associate with forestry management. Land covered with forest crops, young woodland and older trees as well as plantations of poplar and other fast growing trees being maintained both on forest land as well as outside of forests is included in forest land surface area. Land that has been temporarily deprived of trees and which includes logged over forest, blanks, irregularly stocked open stand as well as pine plantations being maintained on forest land and outside of forest land as well as forest land deprived of trees as a result of industrial emissions or mining (flood lands, depressed land). Land connected with silviculture includes land used for purposes of forest management: buildings and structures, spatial division lines in forests, forest roads, forest nurseries, wood stockpiling areas, land reclamation equipment, land under power lines, forest parking lots and tourist equipment"@en .

ex:Def_def_pol_unknown_293 a ex:Definition ;
    rdfs:label "Forest land - Definition of „Forests“ in the Forest Act includes: * Forest Stand..." ;
