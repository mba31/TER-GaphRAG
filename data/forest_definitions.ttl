ex:Def_def_usa_1905_784 a ex:Definition ;
    rdfs:label "An area whose principal crop is trees. A forest includes both the forest cover a..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1905_784_criteria ;
    ex:hasSource ex:Source_USA-FED-DA_Bureau_of_Forestry ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "An area whose principal crop is trees. A forest includes both the forest cover and the soil beneath it. A forest judged by the character of the stand may be timberland or woodland. These constitute the two great classes of forest, between which it is possible to draw a practical but not an absolute distinction. Timberland may be broadly defined as that class of forest which contains in commercial quantities trees of sufficient size and of the required kind to furnish saw logs, pulp wood, ties, poles, or wood for similar uses. Woodland may be broadly defined as forest which contains trees fit for firewood or fencing, but none or very few trees which are suitable for the uses enumerated above. A timber tract is a body of timberland, usually of large area. A woodlot is a forest of small area in which the wood is used mainly for fuel, fencing, and other farm purposes"@en .

ex:Def_def_usa_1905_784_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float .

ex:Def_def_usa_1912_1084 a ex:Definition ;
    rdfs:label "State forests lands include all lands granted to the state by an act of congress..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Wisconsin ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "State forests lands include all lands granted to the state by an act of congress entitled, \"An act granting lands to the state of Wisconsin for forestry purposes,\" approved June 27, 1906; all lands donated to the state by the Nebagamon Lumber Company for forestry purposes; all lands acquired pursuant to chapter 450, laws of 1903, chapter 264, laws of 1905, chapter 638, laws of 1911, and chapter 639, laws of 1911, or under ss. 1494-41 to 1494-62, 1915 stats., and all lands subsequently acquired for forestry purposes. Unless an island is designated as state forest land by the department, state forest lands do not include lands granted to the state by an act of congress entitled, \"An act granting unsurveyed and unattached islands to the state of Wisconsin for forestry purposes,\" approved August 22, 1912. The department may designate as state forest lands any lands within state forest boundaries which were purchased with other conservation funds and where forestry would not conflict with a more intensive use. 28.02(1)"@en .

ex:Def_def_usa_1952_1007 a ex:Definition ;
    rdfs:label "(Woods, Woodland). Areas 1 acre or greater containing tree cover or brush that i..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1952_1007_criteria ;
    ex:hasSource ex:Source_USA-FED-DI-GS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "(Woods, Woodland). Areas 1 acre or greater containing tree cover or brush that is potential tree cover. The growth must be at least 6 feet tall and dense enough to impede foot travel or give cover for troops. Logged or burnt areas are classed as \"woods\" unless new growth is not going to be established. (USGS 1952)"@en .

ex:Def_def_usa_1952_1007_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "1.8288000000000002"^^xsd:float .

ex:Def_def_usa_1971_1081 a ex:Definition ;
    rdfs:label "An area of land proclaimed to be forest under a Forest Act or Ordinance. \"Termin..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kansas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "An area of land proclaimed to be forest under a Forest Act or Ordinance. \"Terminology of Forest Science, Technology, Practice & Products\" SAF, 1971. Robert L. Atchison ratchiso@oznet.ksu.edu"@en .

ex:Def_def_usa_1971_1129 a ex:Definition ;
    rdfs:label "Forest - Generally an ecosystem characterized by a more or less dense and extens..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kansas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest - Generally an ecosystem characterized by a more or less dense and extensive tree cover. More particularly, a plant community predominantly of trees and other woody vegetation, growing more or less closely together. \"Terminology of Forest Science, Technology, Practice & Products\" SAF, 1971. Robert L. Atchison ratchiso@oznet.ksu.edu"@en .

ex:Def_def_usa_1971_1210 a ex:Definition ;
    rdfs:label "An area managed for the production of timber and other forest produce, or mainta..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kansas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "An area managed for the production of timber and other forest produce, or maintained under woody vegetation for such indirect benefits as protection of catchment areas or recreation. \"Terminology of Forest Science, Technology, Practice & Products\" SAF, 1971. Robert L. Atchison ratchiso@oznet.ksu.edu"@en .

ex:Def_def_usa_1971_1443 a ex:Definition ;
    rdfs:label "(1971) Generally, a wooded area. More particularly, as in the tropics and wester..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(1971) Generally, a wooded area. More particularly, as in the tropics and western USA. plant communities in which trees, often small and characteristically short-holed relative to their depth of crown, are present but form only an open canopy, the intervening areas being occupied by lower vegetation, commonly grass, in contrast to a typical wood. (FORD-ROBERTSON 1971)"@en .

ex:Def_def_usa_1972_985 a ex:Definition ;
    rdfs:label "Land at least 10 percent stocked by forest trees of any size or formerly having ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1972_985_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land at least 10 percent stocked by forest trees of any size or formerly having had such tree cover, and not currently developed for nonforest use. (Note: Stocking is measured by comparison of basal area and/or number of trees, by age or size and spacing with specified standards. The minimum area for classification forest land is 1 acre. Roadside, streamside. and shelterbelt strips of timber must have a crown width of at least 120 feet wide to qualify as forest land. Unimproved roads and trails, streams, or other bodies of water or clearings in forest areas shall be classed as forest if less than 120 feet in width.) (FS 1972)"@en .

ex:Def_def_usa_1972_985_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_1973_1003 a ex:Definition ;
    rdfs:label "Land which is, or has been, at least 16.7 percent stocked by forest trees (10 pe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BLM ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land which is, or has been, at least 16.7 percent stocked by forest trees (10 percent of normal yield values), and not currently developed for nonforest use. This included land currently developed for nonforest use, such as urban or thickly settled residential or resort areas, city parks, orchards, improved roads, or pastureland improved by such measures as seeding or irrigation. (BLM 1973)"@en .

ex:Def_def_usa_1974_1203 a ex:Definition ;
    rdfs:label "Forest Land. Federal, state and private land growing forest tree species which a..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Idaho ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest Land. Federal, state and private land growing forest tree species which are, or could be at maturity, capable of furnishing raw material used in the manufacture of lumber or other forest products. The term includes federal, state and private land from which forest tree species have been removed but have not yet been restocked. It does not include land affirmatively converted to uses other than the growing of forest tree species"@en .

ex:Def_def_usa_1974_1219 a ex:Definition ;
    rdfs:label "These lands are at least 10% stocked with trees capable of producing timber or o..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1974_1219_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "These lands are at least 10% stocked with trees capable of producing timber or other wood products, and lands dedicated to forest production but temporarily cleared (i.e. logged). This lands include abandoned fields with woody brush that prevents classification as Agricultural land"@en .

ex:Def_def_usa_1974_1219_criteria ex:minHeight "209.0"^^xsd:float ;
    ex:minHeightSI "209.0"^^xsd:float .

ex:Def_def_usa_1974_1222 a ex:Definition ;
    rdfs:label "Forest land are lands that are at least 10 percent stocked with trees capable of..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1974_1222_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land are lands that are at least 10 percent stocked with trees capable of producing timber or other wood products that exert an influence on climate or water regime. Lands from which trees have been removed to less than 10 percent stocking but which have not been developed for other use are also included"@en .

ex:Def_def_usa_1974_1222_criteria ex:minHeight "209.0"^^xsd:float ;
    ex:minHeightSI "209.0"^^xsd:float .

ex:Def_def_usa_1976_1008 a ex:Definition ;
    rdfs:label "Land which has a tree-crown areal- density (crown closure percentage) of 10 perc..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-GS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land which has a tree-crown areal- density (crown closure percentage) of 10 percent or more, is stocked with trees capable of producing timber or other wood products, and exerts an influence on the climate or water regime. Land from which trees have been removed to less than 10 percent crown closure but which has not been developed for other uses also is included. (Anderson, et. al., 1976)"@en .

ex:Def_def_usa_1976_1740 a ex:Definition ;
    rdfs:label "Anderson, James R.; Hardy, Ernest E.; Roach, John T.; Witmer, Richard E. 1976. A..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "5.5 Considerations" ;
    ex:sectionSub "5.3.2 From a Land Cover Interpretation - If taken literally" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Anderson, James R.; Hardy, Ernest E.; Roach, John T.; Witmer, Richard E. 1976. A Land Use And Land Cover Classification System For Use With Remote Sensor Data. Geological Survey Professional Paper 964. A revision of the land use classification system as presented in U.S. Geological Survey Circular 671. 41 p. Washington, DC: U.S. Department of the Interior, Geological Survey"@en .

ex:Def_def_usa_1977_1160 a ex:Definition ;
    rdfs:label "\"Forest\" means the standing trees on forest land. Source: CHAPTER 152. FOREST PE..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Texas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means the standing trees on forest land. Source: CHAPTER 152. FOREST PEST CONTROL SUBCHAPTER A. GENERAL PROVISIONS and"@en .

ex:Def_def_usa_1977_787 a ex:Definition ;
    rdfs:label "Lands with at least 25 percent tree canopy cover or lands at least 16.7 stocked ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA-SCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Lands with at least 25 percent tree canopy cover or lands at least 16.7 stocked by forest trees of any size. Source: USDA- Soil Conserv. Serv. 1977. INTERA -FS/S'CS Agreement-Inventory, Appraisal, and Assessment Responsibilities. Memo dated 1/17/77. Note: this was an attempt to resolve differences in definitions between the USFS and the Soil Conservation Service - now NRCS. See also Lund, et. al. 1981"@en .

ex:Def_def_usa_1979_1471 a ex:Definition ;
    rdfs:label "(1979) An area on which the dominant vegetation is broadleaf or deciduous trees...." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(1979) An area on which the dominant vegetation is broadleaf or deciduous trees. (FS 1979B)"@en .

ex:Def_def_usa_1980_1472 a ex:Definition ;
    rdfs:label "(1980) A plant community composed of trees at least 4 meters tail with crown not..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1980_1472_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(1980) A plant community composed of trees at least 4 meters tail with crown not usually touching but with a foliar cover of over 25 percent but less than 61 percent at maturity. A herbaceous and/or scrub understory is usually present. (FS 1980)"@en .

ex:Def_def_usa_1980_1472_criteria ex:minCanopyCover "25.0"^^xsd:float ;
    ex:minCanopyCoverSI "25.0"^^xsd:float ;
    ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float .

ex:Def_def_usa_1980_999 a ex:Definition ;
    rdfs:label "Land at least 10 percent stocked by forest trees of any size, or formerly having..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1980_999_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-SCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land at least 10 percent stocked by forest trees of any size, or formerly having had such tree cover, and not currently developed for nonforest use. The minimum area is 1 acre and must be at least 100 feet wide. (Ten percent tree canopy cover is used to separate forest land from rangeland in the transition vegetation types.) (SCS 1980)"@en .

ex:Def_def_usa_1980_999_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "100.0"^^xsd:float ;
    ex:minHeightSI "30.48"^^xsd:float .

ex:Def_def_usa_1982_1000 a ex:Definition ;
    rdfs:label "Land at least 10 percent stocked by forest trees of any size, or formerly having..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1982_1000_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-SCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land at least 10 percent stocked by forest trees of any size, or formerly having had such tree cover and not currently developed for non-forest use. The minimum area for classification of forestland is one acre and must be at least 100 feet wide. Forestland is distinguished from rangeland in transition vegetation types if the tree canopy cover exceeds 10 percent. Forestlands include cut over areas temporarily unstocked as well as young stands and plantations established for forestry purposes which do not yet have 10 percent crown cover. [source: USDA-SCS 1982 NRI] and"@en .

ex:Def_def_usa_1982_1000_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "100.0"^^xsd:float ;
    ex:minHeightSI "30.48"^^xsd:float .

ex:Def_def_usa_1982_1217 a ex:Definition ;
    rdfs:label "Land used primarily for growth of trees to be harvested for commercial use; may ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maine ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land used primarily for growth of trees to be harvested for commercial use; may be either seedling, poletimber, or sawlog stands. Land which would otherwise be included in this definition shall not be excluded because of: (1) Multiple use for public recreation; (2) Statutory or governmental restrictions which prevent commercial harvesting of trees or require a primary use of the land other than commercial harvesting; (3) Deed restrictions, restrictive covenants or organizational charters that prevent commercial harvesting of trees or require a primary use of land other than commercial harvesting and that were effective prior to January 1, 1982; or (4) Past or present multiple use for mineral exploration"@en .

ex:Def_def_usa_1982_32 a ex:Definition ;
    rdfs:label "The purpose of human activity on the land; it is usually, but not always, relate..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA ;
    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "The purpose of human activity on the land; it is usually, but not always, related to land cover. The NRI uses the term \"land cover/use\" to identify the categories that account for all the surface area in the United States [BS-1982, NRI-92] ftp://ftp-fc.sc.egov.usda.gov/NCGC/products/nri/2004range/chapter6.pdf"@en .

ex:Def_def_usa_1985_979 a ex:Definition ;
    rdfs:label "Land at least ten percent stocked by trees of any size or formerly having had su..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-5-Agency1982 ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land at least ten percent stocked by trees of any size or formerly having had such tree cover and not currently built-up or developed for agricultural use. Forest land may include Grassland, Shrubland, Treeland, Wetland and/or Barren land. Examples of forest land use arc grazing, recreation and timber production. (Note we are not recommending that “ten percent stocked” be used to determine dominance in the classification categories.) (Land Use and Land Cover Common Terminology Work Group 1985)"@en .

ex:Def_def_usa_1988_1201 a ex:Definition ;
    rdfs:label "Land at least 10 percent stocked with trees and not now developed for nonforest ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1988_1201_criteria ;
    ex:hasSource ex:Source_USA-STATE-Hawaii-Kauai_Co ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land at least 10 percent stocked with trees and not now developed for nonforest use; also includes land 50 percent or more covered by shrubs. The minimum area recognized as forest land is 1 acre. This land includes both timberland and other forest land (Buck et al. 1988)"@en .

ex:Def_def_usa_1988_1201_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float .

ex:Def_def_usa_1990_1080 a ex:Definition ;
    rdfs:label "\"Forest\" means an area whose principal crop is trees. Illinois. 1990" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "\"Forest\" means an area whose principal crop is trees. Illinois. 1990"@en .

ex:Def_def_usa_1990_1240 a ex:Definition ;
    rdfs:label "Forestland - Land at least 16.7 percent stocked by forest trees of any size, or ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-North_Carolina ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland - Land at least 16.7 percent stocked by forest trees of any size, or formerly having had such tree cover, and not currently developed for nonforest use. Source: Forest Statistics for North Carolina, 1990. Resource Bulletin SE-120, by Tony G. Johnson. USDA-Forest Service, Southeastern Forest"@en .

ex:Def_def_usa_1992_1358 a ex:Definition ;
    rdfs:label "(Cover) An Earth Cover (Level 1) category with vegetative cover recognized as wo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1992_1358_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-NRCS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(Cover) An Earth Cover (Level 1) category with vegetative cover recognized as woody plants which usually have one perennial stem, a definitely formed crown of foliage, and a mature height of at least 4 meters. This category contains all trees, even those planted for the purposes of producing food and ornamentals, including Christmas trees. The second level categories of tree cover include fruit and nut trees, conifers, hardwoods, inter-mixed, and tropical species. [NRI-92]"@en .

ex:Def_def_usa_1992_1358_criteria ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float .

ex:Def_def_usa_1992_1469 a ex:Definition ;
    rdfs:label "(1992) Woodland, total. This category includes natural or planted woodlots or ti..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-CENSUS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(1992) Woodland, total. This category includes natural or planted woodlots or timber tracts, cutover and deforested land with young growth which has or will have value for wood products, land planted for Christmas tree production, and woodland pastured. Land covered by sagebrush or mesquite was to be reported as other pastureland and rangeland or other land"@en .

ex:Def_def_usa_1992_791 a ex:Definition ;
    rdfs:label "Forested Upland - Areas characterized by tree cover (natural or semi-natural woo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1992_791_criteria ;
    ex:hasSource ex:Source_USA-FED-DI-GS-NLCD ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forested Upland - Areas characterized by tree cover (natural or semi-natural woody vegetation, generally greater than 6 meters tall); tree canopy accounts for 25-100 percent of the cover NLCD 92"@en .

ex:Def_def_usa_1992_791_criteria ex:minCanopyCover "100.0"^^xsd:float ;
    ex:minCanopyCoverSI "100.0"^^xsd:float ;
    ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "6.0"^^xsd:float .

ex:Def_def_usa_1992_981 a ex:Definition ;
    rdfs:label "A classification of land use in the Natural Resources Inventory (NRI). It includ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1992_981_criteria ;
    ex:hasSource ex:Source_USA-FED-Congressional_Research_Service_and_House_of_Representatives ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "A classification of land use in the Natural Resources Inventory (NRI). It includes areas where trees cover at least 10% of the land and must be at least an acre in size. Forestland was found on 395 million acres, almost 30% of all private lands, in the 1992 NRI. Congressional Research Service Report for Congress Agriculture: A Glossary of Terms, Programs, and Laws and"@en .

ex:Def_def_usa_1992_981_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "395.0"^^xsd:float ;
    ex:minHeightSI "395.0"^^xsd:float .

ex:Def_def_usa_1992_994 a ex:Definition ;
    rdfs:label "A Land Cover/Use that is at least 10 percent stocked by single stemmed forest tr..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1992_994_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-NRCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "A Land Cover/Use that is at least 10 percent stocked by single stemmed forest trees of any size which will be at least 4 meters (13 feet) tall at maturity. When viewed vertically, canopy cover is 25 percent or greater. Also included are areas bearing evidence of natural regeneration of tree cover (cutover forest or abandoned farmland) and not currently developed for nonforest use. For classification as forest land, an area must be at least one acre and 100 feet wide. [NRI-92] Forest land, grazed. Forest land that is being grazed by livestock and managed using range management principles and practices adapted to the forest ecosystem. [NCPM]"@en .

ex:Def_def_usa_1992_994_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float .

ex:Def_def_usa_1993_1119 a ex:Definition ;
    rdfs:label "“Forest” means forest land occupied by forest trees and associated wildlife spec..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Hawaii ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "“Forest” means forest land occupied by forest trees and associated wildlife species, and timber thereon"@en .

ex:Def_def_usa_1993_1721 a ex:Definition ;
    rdfs:label "Nonforest land - Land that has never supported forests, and lands formerly fores..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1993_1721_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Nonforest land - Land that has never supported forests, and lands formerly forested where use of timber management is precluded by development for other uses. (Note: This includes area used for crops, improved pasture, residential areas, city parks, improved roads of any width and adjoining clearings, powerline clearings of any width, and 1- to 4.5-acre areas of water classified by the Bureau of the Census as land. If intermingled in forest areas, unimproved roads and nonforest strips must be more than 120 feet wide, and clearings, etc., more than 1 acre, to qualify as nonforest land. (Powell et al. 1993)"@en .

ex:Def_def_usa_1993_1721_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_1993_1722 a ex:Definition ;
    rdfs:label "Other forest land - Forest land other than timberland and productive reserved fo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Other forest land - Forest land other than timberland and productive reserved forest land. It includes available and reserved forest land, which is incapable of producing annually 20 cubic feet per acre of industrial wood under natural conditions, because of adverse site conditions, such as sterile soils, dry climate, poor drainage, high elevation, steepness, or rockiness. Urban forest land is also included. (Powell et al. 1993)"@en .

ex:Def_def_usa_1993_1724 a ex:Definition ;
    rdfs:label "Productive reserved forest land - Forest land that would otherwise be classified..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Productive reserved forest land - Forest land that would otherwise be classified as timberland, except that it is withdrawn from timber utilization by statute or administrative regulation. (Powell et al. 1993)"@en .

ex:Def_def_usa_1993_1726 a ex:Definition ;
    rdfs:label "Reserved Forest Land - Forest lands that have statutory or administrative restri..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Reserved Forest Land - Forest lands that have statutory or administrative restrictions prohibiting the harvest of trees. Examples include land within the wilderness preservation system, research natural areas, National Parks and Monuments, and state parks. In National Forests, reserved forest lands are referred to collectively as \"withdrawn forest land\" (Powell 1993)"@en .

ex:Def_def_usa_1993_1729 a ex:Definition ;
    rdfs:label "Timberland - Forest land that is producing or is capable of producing crops of i..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Timberland - Forest land that is producing or is capable of producing crops of industrial wood, and that is not withdrawn from timber utilization by statute or administrative regulation (Note: Areas qualifying as timberland are capable of producing more than 20 cubic feet per acre per year of industrial wood in natural stands. Currently inaccessible and inoperable areas are included.) (Powell et al. 1993). A subsequent report (Smith et al. 1994) provides the metric equivalent for timberland as 1.4 cubic meters per hectare per year"@en .

ex:Def_def_usa_1993_986 a ex:Definition ;
    rdfs:label "Land at least 10 percent stocked by forest trees of any size, including land tha..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1993_986_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land at least 10 percent stocked by forest trees of any size, including land that formerly had such tree cover and that will be naturally or artificially regenerated. Forest land includes transition zones, such as areas between heavily forested and nonforested lands that are at least 10 percent stocked with forest trees and forested areas adjacent to urban or built-up lands. Also included are pinyon juniper and chaparral areas in the West and afforested areas. The minimum area for classification of forest is 1 acre. Roadside, streamside, and shelterbelt strips of timber must have a crown width of at least 120 feet to qualify as forest land. Unimproved roads and trails, streams, and clearings in forest areas are classified as forest if less than 120 feet wide. (Powell et al. 1993) , and"@en .

ex:Def_def_usa_1993_986_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_1994_1001 a ex:Definition ;
    rdfs:label "Land on which forest trees of various sizes constitute at least 10 percent of th..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DD-AF ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land on which forest trees of various sizes constitute at least 10 percent of the area. This category includes open land that is capable of supporting trees and is planned for forest regeneration and management"@en .

ex:Def_def_usa_1994_1152 a ex:Definition ;
    rdfs:label "Forest lands are covered with deciduous or coniferous woody vegetation about 3 m..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1994_1152_criteria ;
    ex:hasSource ex:Source_USA-STATE-North_Carolina ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest lands are covered with deciduous or coniferous woody vegetation about 3 meters or more in height. Forest lands exhibit a tree-crown area density of at least 10 percent. Lands from which trees have been removed to less than 10 percent crown density should be included in Category 3 (Herbaceous Cover and Shrubland) or another land cover category if appropriate. This category includes upland forests and forest land on seasonally or permanently wet or inundated areas often called \"forested wetlands\" in other classification schemes. For lands on which there is forest rotation involving clear-cutting and block planting, the clear-cut or plantation areas are not included in this subcategory until planted trees reach a growth stage to meet the criteria for 10 percent crown density coverage. Otherwise, these areas are classified under Category 3. This category includes managed areas of tree growth such as orchards or Christmas tree farms that meet the basic criteria for forest areas. Where applicable, subcategory definitions include a reference to physiographic classes accepted by the Forest Resources Division of the North Carolina Department of Environment, Health and Natural Resources on which the forest stands most commonly occur. and"@en .

ex:Def_def_usa_1994_1152_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "3.0"^^xsd:float ;
    ex:minHeightSI "3.0"^^xsd:float .

ex:Def_def_usa_1994_792 a ex:Definition ;
    rdfs:label "Areas with tree 5 m in height or more and with crowns interlocking (60-100% crow..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1994_792_criteria ;
    ex:hasSource ex:Source_USA-FED-DI-NBS_NPS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Areas with tree 5 m in height or more and with crowns interlocking (60-100% crown cover). (TNC-NBS/NPS. 1994)"@en .

ex:Def_def_usa_1994_792_criteria ex:minCanopyCover "100.0"^^xsd:float ;
    ex:minCanopyCoverSI "100.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_usa_1995_1192 a ex:Definition ;
    rdfs:label "Forestland - an area at least 1 acre in size that is at least 10 percent stocked..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1995_1192_criteria ;
    ex:hasSource ex:Source_USA-STATE-Arkansas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland - an area at least 1 acre in size that is at least 10 percent stocked with trees, or formerly having such tree cover and not currently developed for nonforest uses. Forest Inventory and Analysis definition - Forest Statistics for Arkansas Counties - 1995 Jim Grant jim.grant@mail.state.ar.us - no official definitions in Arkansas law"@en .

ex:Def_def_usa_1995_1192_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float .

ex:Def_def_usa_1995_1473 a ex:Definition ;
    rdfs:label "Woody Land class includes any species with an aerial stem that persists for more..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DC-NOAA ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Woody Land class includes any species with an aerial stem that persists for more than one season. The Woody class is divided into three subclasses: 1.41 - Deciduous, 1.42 - Evergreen, and 1.43 - Mixed. 1995"@en .

ex:Def_def_usa_1996_1205 a ex:Definition ;
    rdfs:label "State forests shall include only such lands as are decided by the Department of ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "State forests shall include only such lands as are decided by the Department of Natural Resources to be more valuable for the growing of forests than for other purposes, and shall have for their purpose the production of forest products, the protection of watersheds that are subject to serious erosion, the maintenance of purity of springs and streams and to afford recreation places for the people of the State. (Source: P.A. 89-445, eff. 2-7-96.) Source"@en .

ex:Def_def_usa_1996_1235 a ex:Definition ;
    rdfs:label "\"Forest\" means forest land and the timber on the land. (5) \"Forest land\" means c..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1996_1235_criteria ;
    ex:hasSource ex:Source_USA-STATE-Montana ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest\" means forest land and the timber on the land. (5) \"Forest land\" means contiguous land of 15 acres or more in one ownership that is capable of producing timber that can be harvested in commercial quantity and is producing timber unless the trees have been removed by man through harvest, including clearcuts, or by natural disaster, including but not limited to fire. Forest land includes land: (a) that has not been converted to another use"@en .

ex:Def_def_usa_1996_1235_criteria ex:minArea "15.0"^^xsd:float ;
    ex:minAreaSI "6.07029"^^xsd:float .

ex:Def_def_usa_1996_1268 a ex:Definition ;
    rdfs:label "Land primarily devoted to growing trees for long-term commercial timber producti..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land primarily devoted to growing trees for long-term commercial timber production on land that can be economically and practically managed for such production, including Christmas trees subject to the excise tax imposed under RCW 84.33.100 through 84.33.140, and that has long-term commercial significance. In determining whether forest land is primarily devoted to growing trees for long-term commercial timber production on land that can be economically and practically managed for such production, the following factors shall be considered: (a) The proximity of the land to urban, suburban, and rural settlements; (b) surrounding parcel size and the compatibility and intensity of adjacent and nearby land uses; (c) long-term local economic conditions that affect the ability to manage for timber production; and (d) the availability of public facilities and services conductive to conversion of forest land to other uses. 1994 State Legislature"@en .

ex:Def_def_usa_1996_1269 a ex:Definition ;
    rdfs:label "Land primarily useful for growing trees, including Christmas trees subject to th..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land primarily useful for growing trees, including Christmas trees subject to the excise tax imposed under RCW 84.33.100 through 84.33.140, for commercial purposes, and that has long-term commercial significance for growing trees commercially. The Growth Management Act RCW 36.70A.30(8)"@en .

ex:Def_def_usa_1997_1083 a ex:Definition ;
    rdfs:label "A parcel of land of more than 10 acres that has been zoned in the comprehensive ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1997_1083_criteria ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "A parcel of land of more than 10 acres that has been zoned in the comprehensive plan for exclusive farm use, forest use or farm and forest use and that is, as of the assessment date for which value for the forest homesite is being determined: (A) Land that has as its highest and best use the growing and harvesting of trees of a marketable species; (B) Land that has been designated as forestland under ORS 321.257 to 321.381 or 321.805 to 321.825; or (C) Land that has been classified under ORS 321.705 to 321.765. 1997 Oregon Revised Statutes"@en .

ex:Def_def_usa_1997_1083_criteria ex:minArea "10.0"^^xsd:float ;
    ex:minAreaSI "4.04686"^^xsd:float .

ex:Def_def_usa_1997_1108 a ex:Definition ;
    rdfs:label "An area of trees with overlapping crowns (generally forming a 60 to 100 percent ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS-R8 ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "An area of trees with overlapping crowns (generally forming a 60 to 100 percent cover) USDA"@en .

ex:Def_def_usa_1997_1264 a ex:Definition ;
    rdfs:label "Forest Land - Land at least 10 percent stocked by trees of any size or formerly ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Virginia ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest Land - Land at least 10 percent stocked by trees of any size or formerly having had such tree cover and not currently built-up or developed for agricultural use. Forestland may include Grassland, Shrubland, Treeland, Wetland, and/or Barren land. Examples of forest land use are grazing, recreation, and timber production. See Forest Land Class for further breakdowns. Virginia Fire Law defines forestland as 80 woody stems per acre"@en .

ex:Def_def_usa_1997_1470 a ex:Definition ;
    rdfs:label "(1997) Woodland, total. This category includes natural or planted woodlots or ti..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-CENSUS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(1997) Woodland, total. This category includes natural or planted woodlots or timber tracts, cutover and deforested land with young growth which has or will have value for wood products, and woodland pastured. Land covered by sagebrush or mesquite was to be reported as other pastureland and rangeland or other land. Land planted for Christmas tree production was to be reported in cropland harvested, and land in tapped maple trees reported as woodland not pastured"@en .

ex:Def_def_usa_1997_1482 a ex:Definition ;
    rdfs:label "(1997) Woodland — All forest land consisting of non-timber species not tradition..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Nevada ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(1997) Woodland — All forest land consisting of non-timber species not traditionally used for industrial products. Such species include juniper, pinon pine, cottonwood, willow, aspen, as well as others. (Nevada Forest Stewardship Program, Five Year Plan, 1997 -2002, December 1997, NDF Forest Stewardship Coordinating Committee)"@en .

ex:Def_def_usa_1997_1720 a ex:Definition ;
    rdfs:label "Nonforest land - Land that has never supported forests or formerly was forested ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1997_1720_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Nonforest land - Land that has never supported forests or formerly was forested and currently is developed for nonforest uses. Included are lands used for agricultural crops, Christmas tree farms, improved pasture, residential areas, city parks, constructed roads, operating railroads and their right-of-way clearings, powerline and pipeline clearings, streams more than 30 feet wide, and 1- to 40-acre areas of water classified by the Bureau of the Census, U.S. Department of Commerce, as land. If intermingled in forest areas, unimproved roads and other nonforest strips must be more than 120 feet wide, and clearings or other areas must be 1 acre or larger to qualify as nonforest land. (Waddell and Bassett 1997)"@en .

ex:Def_def_usa_1997_1720_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "30.0"^^xsd:float ;
    ex:minHeightSI "9.144"^^xsd:float .

ex:Def_def_usa_1997_1727 a ex:Definition ;
    rdfs:label "Reserved other forest - Forest land incapable of growing 20 cubic feet per acre ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Reserved other forest - Forest land incapable of growing 20 cubic feet per acre per year (mean annual increment at culmination in fully stocked, natural stands) of industrial wood that has been dedicated to noncommodity use through statute, ordinance, or administrative order. (Waddell and Bassett 1997)"@en .

ex:Def_def_usa_1997_1728 a ex:Definition ;
    rdfs:label "Reserved timberland - Forest land capable of growing 20 cubic feet per acre per ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "3.6 REGENERATION" ;
    ex:sectionSub "3.6.3 Questions:" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Reserved timberland - Forest land capable of growing 20 cubic feet per acre per year (mean annual increment at culmination in fully stocked, natural stands) of industrial wood that has been dedicated to noncommodity use through statute, ordinance, or administrative order. Plots were not established in reserved areas; tree data therefore were not available to determine the mean annual increment (MAI) for these plots [sic]. Because of this, reserved forest land with an MAI of less than 20 cubic feet per acre per year may be classified as reserved timberland rather than reserved other forest land. (Waddell and Bassett 1997)"@en .

ex:Def_def_usa_1997_987 a ex:Definition ;
    rdfs:label "Land at least 10 percent stocked with live trees, or land that had this minimum ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_1997_987_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land at least 10 percent stocked with live trees, or land that had this minimum tree stocking in the past and is not currently developed for nonforest use. The minimum area recognized is 1 acre. (Waddell and Bassett 1997)"@en .

ex:Def_def_usa_1997_987_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float .

ex:Def_def_usa_1998_1143 a ex:Definition ;
    rdfs:label "Although we do not have \"official\" definitions, we commonly use the accepted SAF..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Missouri ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Although we do not have \"official\" definitions, we commonly use the accepted SAF definitions for these terms. See Dictionary of Forestry; John A. Helms, editor; published 1998 by the Sociecy of American Foresters. \"Mike Hoffmann\" hoffmm@mail.conservation.state.mo.us"@en .

ex:Def_def_usa_1998_1159 a ex:Definition ;
    rdfs:label "Forest: An ecosystem characterized by a more or less dense and extensive tree co..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-South_Dakota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest: An ecosystem characterized by a more or less dense and extensive tree cover, often consisting of stands varying in characteristics such as species composition, structure, age class, and associated processes, and commonly including meadows, streams, fish, and wildlife. Forests include special kinds such as industrial forests, nonindustrial private forests, plantations, public forests, protection forests, and urban forests, as well as parks and wilderness. Source - The Dictionary of Forestry, 1998, published by the Society of American Foresters, John A. Helms, editor. Greg.Josten@state.sd.us"@en .

ex:Def_def_usa_1998_1168 a ex:Definition ;
    rdfs:label "Forest (land use category) - Includes public or private forest lands and tree fa..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1998_1168_criteria ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest (land use category) - Includes public or private forest lands and tree farms, and may be designated for recreational uses. Forested Wetland - Any area of vegetated wetland where woody vegetation over 20 feet tall and dominated by trees (e.g., alder, cedar, hemlock, cottonwood, some willow species) comprises at least 30 percent areal cover"@en .

ex:Def_def_usa_1998_1168_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "6.096"^^xsd:float .

ex:Def_def_usa_1998_1258 a ex:Definition ;
    rdfs:label "Forest land: Land at least 10 percent stocked by forest trees of any size, inclu..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1998_1258_criteria ;
    ex:hasSource ex:Source_USA-STATE-South_Dakota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land: Land at least 10 percent stocked by forest trees of any size, including land that formerly had such tree cover and that will be naturally or artificially regenerated. Forest land includes (a) transition zones, such as areas between forested and nonforested lands that are at least 10 percent stocked with forest trees, and forest areas adjacent to urban and built-up lands, (b) pinion-juniper and chaparral areas. The minimum area for classification of forest land is 1 acre (0.4 ha); roadside, streamside, and shelterbelt strips of trees must have a crown width of at least 120 ft (36.6 m); unimproved roads and trails, streams, and clearings in forest areas are classified as forest if less than 120 ft (36.6 m) wide. Source - The Dictionary of Forestry, 1998, published by the Society of American Foresters, John A. Helms, editor. Greg.Josten@state.sd.us"@en .

ex:Def_def_usa_1998_1258_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "36.6"^^xsd:float ;
    ex:minHeightSI "36.6"^^xsd:float ;
    ex:minWidth "36.6"^^xsd:float ;
    ex:minWidthSI "36.6"^^xsd:float .

ex:Def_def_usa_1998_1369 a ex:Definition ;
    rdfs:label "TREE: It might seem silly, at first, to define a tree. Everyone knows what a tre..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1998_1369_criteria ;
    ex:hasSource ex:Source_USA-STATE-Michigan ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "TREE: It might seem silly, at first, to define a tree. Everyone knows what a tree is . . . don't they? The difference between and tree and shrub can be defined without difficulty. A tree is \"a woody perennial plant, typically large and with a well-defined stem or stems carrying a more or less definite crown --- note sometimes defined as attaining a minimum diameter of 5 inches and a minimum height of 15 feet at maturity, with no branches within 3 feet of the ground\" [Society of American Foresters, 1998]. The problem is that some species can grow as trees or shrubs depending on climate and site conditions. A good example is black cherry. Throughout most of its range, it grows as a tree. But put on a poor site or along the northern edge of its range and it grows as a shrub. Species that are obviously trees further south will sometimes occur only as shrubs in the far north"@en .

ex:Def_def_usa_1998_1369_criteria ex:minHeight "15.0"^^xsd:float ;
    ex:minHeightSI "4.572"^^xsd:float .

ex:Def_def_usa_1998_1370 a ex:Definition ;
    rdfs:label "Although we do not have \"official\" definitions, we commonly use the accepted SAF..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Missouri ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Although we do not have \"official\" definitions, we commonly use the accepted SAF definitions for these terms. See Dictionary of Forestry; John A. Helms, editor; published 1998 by the Society of American Foresters. \"Mike Hoffmann\" <hoffmm@mail.conservation.state.mo.us>"@en .

ex:Def_def_usa_1998_1516 a ex:Definition ;
    rdfs:label "A relative number of trees or volume per acre. A forest stand is most often desc..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.11 STOCKING (Stand Density, Crown Cover)" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.9 SEMI-NATURAL FOREST See: Lund, H. Gyde. 2016 revised. Definitions of old growth, pristine, climax, ancient forests, degradation, desertification, forest fragmentation, and similar terms. [Online publication], Gainesville, VA: Forest Information Services. Misc. pagination. DOI: 10.13140/RG.2.1.2963.73612.10" ;
    skos:note "A relative number of trees or volume per acre. A forest stand is most often described as being well-stocked, poorly stocked or overstocked. [Source: Glossary of Forestry Terms Commonly Used in Forest Management Plans From: \"Maksym Polyakov\" <mpoliak@pcomp.usau.kiev.ua Date: Wed, 17 Jun 1998 11:20:37 +0300 (MSD)]"@en .

ex:Def_def_usa_1998_785 a ex:Definition ;
    rdfs:label "Forests, upland - forests where palms do not predominate and where the water tab..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forests, upland - forests where palms do not predominate and where the water table is too low to support mangrove or swamp forest species (MacLean and others 1988a)"@en .

ex:Def_def_usa_1999_1062 a ex:Definition ;
    rdfs:label "Land on which the potential natural community is dominated by trees" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BLM ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Land on which the potential natural community is dominated by trees"@en .

ex:Def_def_usa_1999_1063 a ex:Definition ;
    rdfs:label "Land on which the vegetation is dominated by trees. Lands are classified forestl..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BLM ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Land on which the vegetation is dominated by trees. Lands are classified forestland if the trees now (not?) present will provide 25 percent or greater canopy cover at maturity. Lands not presently forestland that were originally or could become forested through natural succession may be classified as potential natural forestland. and"@en .

ex:Def_def_usa_1999_1117 a ex:Definition ;
    rdfs:label "Upland Forest -This category of land cover is reserved for those upland areas wh..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Florida ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Upland Forest -This category of land cover is reserved for those upland areas which support a tree canopy closure of ten (10) percent or more"@en .

ex:Def_def_usa_1999_1126 a ex:Definition ;
    rdfs:label "\"Forest\" means stands of native or introduced trees containing at least two hund..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Iowa ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means stands of native or introduced trees containing at least two hundred trees per acre and located on privately owned land. However, a stand of fruit trees is not a forest"@en .

ex:Def_def_usa_1999_1198 a ex:Definition ;
    rdfs:label "Forests (Upland) - This category of land cover is reserved for those upland area..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Florida ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forests (Upland) - This category of land cover is reserved for those upland areas which support a tree canopy closure of ten (10) percent or more. The Upland Forests include both the xeric (drysite) and mesic (moderately moist site) forest communities. Wetland, or hydric, forest communities fall under the broad wetland category. Also included in the Upland Forest category are areas in which timber harvesting has occurred but which exhibit no evidence of being developed for other intended uses (clear-cuts in an area in which rotation forest management is practiced is a prime example of such a case)"@en .

ex:Def_def_usa_1999_1209 a ex:Definition ;
    rdfs:label "\"Forest\" means stands of native or introduced trees containing at least two hund..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Iowa ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest\" means stands of native or introduced trees containing at least two hundred trees per acre and located on privately owned land. However, a stand of fruit trees is not a forest. 1999"@en .

ex:Def_def_usa_1999_1284 a ex:Definition ;
    rdfs:label "Sec. 1. For the purpose of property taxation, forest land may be classified and ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Indiana ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Sec. 1. For the purpose of property taxation, forest land may be classified and assessed under this chapter if the land satisfies the conditions prescribed in this chapter for classification as native forest land or a forest plantation. (Formerly: Acts 1975, P.L.47, SEC.1.) IC 6-1.1-6-2 Sec. 2. Land may be classified as a forest plantation if it is cleared land which has growing on it a good stand of timber producing trees as that concept is understood by competent foresters. (Formerly: Acts 1975, P.L.47, SEC.1.) IC 6-1.1-6-3 Sec. 3. Land may be classified as native forest land if it has never been plowed or cultivated and contains at least forty (40) square feet of basal area per acre or at least one thousand (1,000) timber producing trees, of any size, per acre. (Formerly: Acts 1975, P.L.47, SEC.1.) IC 6-1.1-6-4 Sec. 4. For purposes of this chapter, the following types of trees are not considered timber producing trees: dogwoods (Cornus); water-beech (Carpinus); ironwood (Ostrya); red bud (Cercis); sassafras; persimmon; pawpaw; black haw; willows (Salix); pomaceous trees; and Christmas trees which are grown for commercial purposes. (Formerly: Acts 1975, P.L.47, SEC.1.). Source: Chapter 6. Assessment of Certain Forest Lands IC 6-1.1-6-1"@en .

ex:Def_def_usa_1999_1398 a ex:Definition ;
    rdfs:label "USA-FED-DI-BLM 1999, 2001) A woody perennial, usually single-stemmed plant that ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1999_1398_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "USA-FED-DI-BLM 1999, 2001) A woody perennial, usually single-stemmed plant that has a definite crown shape and characteristically reaches a mature height of at least 5 meters (16 feet). Some plants, such as oaks (Quercus spp.), may grow as either trees or shrubs , and"@en .

ex:Def_def_usa_1999_1398_criteria ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_usa_2000_1185 a ex:Definition ;
    rdfs:label "Land that is at least 10 percent stocked by forest trees of any size (or 5 perce..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2000_1185_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS-INT ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land that is at least 10 percent stocked by forest trees of any size (or 5 percent crown cover where stocking cannot be determined), or land formerly having such tree cover, and is not currently developed for a nonforest use. The minimum area for classification as forest land is one acre. Roadside, stream-side, and shelterbelt strips of timber must be at least 120 feet wide to qualify as forest land. Unimproved roads and trails or natural clearings in forested areas shall be classified as forest, if less than 120 feet in width or an acre in size. Streams and other bodies of water within forest will be considered forest land if they are less than 1 acre and 30-feet wide. Grazed woodlands, reverting fields, and pastures that are not actively maintained are included if the above qualifications are satisfied. (Also see definitions of nonforest land, idle farmland and improved/maintained pasture.) Note: In some instances, area previously stocked with woodland species that have had some type of treatment (e.g., chaining or other mechanical treatment) are classified as nonforest land. Interior West FIA annual manual 5/2000 – Terms not in National Manual"@en .

ex:Def_def_usa_2000_1185_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_2000_1187 a ex:Definition ;
    rdfs:label "Land at least 10.0 percent stocked by forest trees of any size, or land formerly..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
