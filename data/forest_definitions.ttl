    skos:note "“Reserved Forest” means any area which is constituted as reserved forest under the Assam Forest Regulation, 1891 as adopted"@en .

ex:Def_def_ind_2014_256 a ex:Definition ;
    rdfs:label "Deemed Forests - basically not recorded forest areas as per government records" ;
    ex:appliesTo ex:Country_India ;
