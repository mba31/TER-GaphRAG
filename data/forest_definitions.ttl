ex:Def_def_usa_2019_1130 a ex:Definition ;
    rdfs:label "(USA-STATE-Maine) Forestland--means land used primarily for growth of trees to b..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maine ;
    skos:note "(USA-STATE-Maine) Forestland--means land used primarily for growth of trees to be harvested for commercial use; may be either seedling, pole timber, or saw log stands. Forestland does not include ledge, marsh, open swamp, bog, water and similar areas that are unsuitable for growing a forest product or for harvesting for commercial use even though these areas may exist within forestlands. http://www.state.me.us/revenue/propertytax/Bulletins/Tax%20Bulletin%2019.htm"@en .

