ex:Def_def_ira_1962_537 a ex:Definition ;
    rdfs:label "FOREST LAND: It is an area which comply with one of the following; a-Lands in wh..." ;
    ex:appliesTo ex:Country_Iran ;
    ex:country "Iran" ;
    ex:definitionType "Land Cover" ;
