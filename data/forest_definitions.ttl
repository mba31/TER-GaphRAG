ex:Def_def_col_2014_834 a ex:Definition ;
    rdfs:label "For the purposes of the National REDD + Strategy (ENREDD +), and in particular f..." ;
    ex:appliesTo ex:Country_Colombia ;
    ex:country "Colombia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_col_2014_834_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "For the purposes of the National REDD + Strategy (ENREDD +), and in particular for the construction of this FREL, forest is defined as: Land mainly covered by trees which might contain shrubs, palms, guaduas, grass and vines, in which tree cover predominates with a minimum canopy density of 30%, a minimum canopy height (in situ) of 5 meters at the time of identification , and a minimum area of 1.0 ha. Commercial forest plantations, palm crops and planted trees for agricultural production are excluded. In this frame, the minimum mapping unit used for the FREL is 1.0 ha"@en .

