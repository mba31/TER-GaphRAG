    ex:minCanopyCoverSI "50.0"^^xsd:float ;
    ex:minHeight "9.0"^^xsd:float ;
    ex:minHeightSI "9.0"^^xsd:float .

ex:Def_def_unk_unknown_212 a ex:Definition ;
    rdfs:label "(Gambia1998) \"Forest\" means a land area with at least 10% tree cover, naturally ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_212_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "(Gambia1998) \"Forest\" means a land area with at least 10% tree cover, naturally grown or planted, and or 50% or more shrub and tree regeneration cover and includes Government forest parks, community forests and protected forests irrespective of their tree and shrub cover; provided that vegetation on fallow land is not a forest except as specified in section 5 of this Act http://extwprlegs1.fao.org/docs/pdf/gam19052.pdf"@en .

ex:Def_def_unk_unknown_212_criteria ex:minCanopyCover "50.0"^^xsd:float ;
    ex:minCanopyCoverSI "50.0"^^xsd:float .

ex:Def_def_unk_unknown_22 a ex:Definition ;
    rdfs:label "(Recommended Definition) -While a definition of \"forest\" that is globally accept..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_22_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Recommended Definition) -While a definition of \"forest\" that is globally acceptable and appropriate for monitoring using standard remote sensing options will necessarily be based on a small set of easily measured parameters, there are dangers when simple definitions are applied locally. At the very least, we recommend that natural forest be differentiated from plantations and that for defining \"forest\" the lower height limit defining \"trees\" be set at more than 5 m tall with the minimum cover of trees be set at more than 40%. These changes will help reduce greenhouse gas emissions from what is now termed forest \"degradation\" without increasing monitoring costs. Furthermore, these minor changes in the definition of \"forest\" will promote the switch from degradation to responsible forest management, which will help mitigate global warming while protecting biodiversity and contributing to sustainable development. http://www.forestcarbonportal.com/resource/critical-need-new-definitions-forest-and-forest-degradation-global-climate-change-agreement"@en .

ex:Def_def_unk_unknown_22_criteria ex:minCanopyCover "40.0"^^xsd:float ;
    ex:minCanopyCoverSI "40.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_unknown_246 a ex:Definition ;
    rdfs:label "(Lao KP) GOL has already submitted a forest definition to UNFCCC (minimum 20% fo..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_246_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    skos:note "(Lao KP) GOL has already submitted a forest definition to UNFCCC (minimum 20% forest cover, minimum area 0.5 ha, minimum tree height 5 m, and palm trees and bamboo considered as non-forest). http://www.dof.maf.gov.la/docs/Lao_FIP_Investment%20Plan%20Master_2nd%20draft-for-public%20review.pdf"@en .

ex:Def_def_unk_unknown_246_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_unknown_25 a ex:Definition ;
    rdfs:label "“Urban forest\" means those native or introduced trees and related vegetation in ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "“Urban forest\" means those native or introduced trees and related vegetation in the urban and near-urban areas including, but not limited to, urban watersheds, soils and related habitats, street trees, park trees, residential trees, natural riparian habitats, and trees on other private and public properties http://www.marinreleaf.org/"@en .

ex:Def_def_unk_unknown_27 a ex:Definition ;
    rdfs:label "A dense grove of trees and underbrush covering a large tract. Grove - A small wo..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A dense grove of trees and underbrush covering a large tract. Grove - A small wood without underbrush. Wood - A dense grove of trees usually greater in extent than a grove and smaller than a forest. Thicket - A dense growth of shrubbery or small trees. http://www.thealmightyguru.com/Pointless/NatureDefinitions.html"@en .

ex:Def_def_unk_unknown_28 a ex:Definition ;
    rdfs:label "A large wooded area having a thick growth of trees and plants http://dictionary...." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A large wooded area having a thick growth of trees and plants http://dictionary.reverso.net/english-definition/forest%20reserve"@en .

ex:Def_def_unk_unknown_29 a ex:Definition ;
    rdfs:label "A piece of land that is thickly covered with trees is the general of definition ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A piece of land that is thickly covered with trees is the general of definition of a forest. Forest is also known as woods, weald or woodlands. http://hassam.hubpages.com/hub/Types-Of-Forests"@en .

ex:Def_def_unk_unknown_290 a ex:Definition ;
    rdfs:label "(Trinidad and Tobago) Forest Reserve - means and includes a forest and every par..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Trinidad and Tobago) Forest Reserve - means and includes a forest and every part of a forest declared to be a Forest Reserve under the Land Regulations for the time being in force – Forest Act: Chapter 66:01. Narine Lackhan, Director of Forestry."@en .

ex:Def_def_unk_unknown_30 a ex:Definition ;
    rdfs:label "Areas with a? minimum of 10% crown cover of trees and/or bamboos, generally asso..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_30_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Areas with a? minimum of 10% crown cover of trees and/or bamboos, generally associated with wild flora and fauna and natural soil conditions, and are not subject to agricultural practices. Note that in some countries, some areas are statutorily defined as ?Forest Area? that contain no tree cover http://sedac.ciesin.org/guides/lu/glossary.jsp"@en .

ex:Def_def_unk_unknown_30_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_unk_unknown_31 a ex:Definition ;
    rdfs:label "Ecosystem characterized by more or less dense and extensive tree cover, i.e., la..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Ecosystem characterized by more or less dense and extensive tree cover, i.e., larger than what might be called a grove. http://www.Colorado.Edu/INSTAAR/TEAML/atlas/chapters/definitions.html#Forest and http://www.arcticatlas.org/glossary/index"@en .

ex:Def_def_unk_unknown_33 a ex:Definition ;
    rdfs:label "Forest refers to primarily closed canopy humid tropical forest, and includes clo..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Forest refers to primarily closed canopy humid tropical forest, and includes cloud forest. http://www.geog.umd.edu/tropical/per80v141README"@en .

ex:Def_def_unk_unknown_338 a ex:Definition ;
    rdfs:label "(Iceland) Forest land (skoglendi) - Land that is or will be, mostly or fully, co..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Iceland) Forest land (skoglendi) - Land that is or will be, mostly or fully, covered by forest vegetation, natural or planted, forest or scrub*. *The Icelandic word \"kjarr\", which is translated as scrub, refers to low-growing and crooked birch and in some cases willows. Source: Latest draft of a new forestry act : Þröstur Eysteinsson <throstur@simnet.is"@en .

ex:Def_def_unk_unknown_346 a ex:Definition ;
    rdfs:label "(Korea, Republic of) Forest is defined as one of followings: 1. collectively sta..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Korea, Republic of) Forest is defined as one of followings: 1. collectively standing and growing trees and bamboos, and the land that have them. 2. the land that temporarily lost standing trees and bamboos. 3. the land that is used for collectively growing trees and bamboos. 4. forestry roads. 5. rockland and wetland within 1, 2 and 3. Forest does not include followings 1. Orchard 2. the land that have growing trees and bamboos within buildings 3. the road with growing street trees. 4. stream banks. Korean Forestry Law. \"Matthias ChangDuck Koo\" koochangd@hotmail.com."@en .

ex:Def_def_unk_unknown_352 a ex:Definition ;
    rdfs:label "(Luxembourg) Terres représentant un couvert forestier (ou peuplement équivalent)..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_352_criteria ;
    ex:hasSource ex:Source_United_Nations ;
    skos:note "(Luxembourg) Terres représentant un couvert forestier (ou peuplement équivalent) de plus de 10 % et une superficie supérieure à 0,5 ha. Les arbres doivent pouvoir atteindre une hauteur abattable minimale de 5 mètres. Ces forêts peuvent comprendre soit des formations forestières denses dont les divers étages et le sous-bois couvrent une forte proportion du sol, soit des formations forestières claires avec une strate herbacée continue dans lesquelles les cimes couvrent plus de 10 % de la superficie. Sont également compris dans les forêts les jeunes peuplements naturels ou toutes plantations créées à des fins forestières, mais dont les cimes ne couvrent pas encore 10 % de la superficie ou dont les arbres sont encore inférieurs à 5 mètres, tout comme les zones qui font normalement partie de la région forestière et qui sont temporairement déboisées par le fait de l'intervention de l'homme ou de causes naturelles, mais qui sont appelées à redevenir des forêts. Ces terres comprennent : les pépinières, les vergers à graine qui font partie intégrante de la forêt ; les routes forestières , les zones coupées à blanc, les pare-feu et autres petites clairières. Source: Definitions De La Foret Utilisees Dans Le Cadre De L'inventaire Forestier National Au Luxembourg (Marc Wagner)"@en .

ex:Def_def_unk_unknown_352_criteria ex:minArea "5.0"^^xsd:float ;
    ex:minAreaSI "5.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_unknown_37 a ex:Definition ;
    rdfs:label "Plant community predominately of trees and other woody plants, growing more or l..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Plant community predominately of trees and other woody plants, growing more or less closely together. http://www.Colorado.Edu/INSTAAR/TEAML/atlas/chapters/definitions.html#Forest and http://www.arcticatlas.org/glossary/index"@en .

ex:Def_def_unk_unknown_375 a ex:Definition ;
    rdfs:label "(Taiwan, ROC) Forest land - the land that is at least 0.5 hectare in size with a..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_375_criteria ;
    ex:hasSource ex:Source_The_Third_Forest_Resources_and_Land_Use_Inventory_in_Taiwan ;
    skos:note "(Taiwan, ROC) Forest land - the land that is at least 0.5 hectare in size with at least 10% of the area covered with tree crowns or commercial bamboo, the forest belt beside road or river is at least 50 meters wide. The road, river, other water area or open lands in forest is less than 20 meters wide. The open land over than 0.5 hectare which is considered to reforestation or afforestation. Source: The Third Forest Resources and Land Use Inventory in Taiwan&uml; - \"&ordf;L&deg;È&sect;&frac12;service\" service@dns.forest.gov.tw"@en .

ex:Def_def_unk_unknown_375_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "50.0"^^xsd:float ;
    ex:minHeightSI "50.0"^^xsd:float ;
    ex:minWidth "50.0"^^xsd:float ;
    ex:minWidthSI "50.0"^^xsd:float .

ex:Def_def_unk_unknown_38 a ex:Definition ;
    rdfs:label "Something resembling a large wooded area.esp. in density. http://dictionary.reve..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Something resembling a large wooded area.esp. in density. http://dictionary.reverso.net/english-definition/forest%20reserve."@en .

ex:Def_def_unk_unknown_397 a ex:Definition ;
    rdfs:label "(Kazakhatan) \"forest\" means a natural complex formed on a certain territory base..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "(Kazakhatan) \"forest\" means a natural complex formed on a certain territory based on the aggregate of trees and shrubs vegetations and other wildlife components interacting with environment and having environmental, economic and social importance; http://faolex.fao.org/docs/texts/kaz41426E.doc"@en .

ex:Def_def_unk_unknown_40 a ex:Definition ;
    rdfs:label "(American Legislative Exchange Council) “Forest” means a parcel of land in which..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(American Legislative Exchange Council) “Forest” means a parcel of land in which at least 80% of the parcel is producing or is capable of producing at least 20 cubic feet of merchantable timber per acre per year {or as defined by state statute}. https://www.alec.org/model-policy/the-right-to-practice-forestry-act/"@en .

ex:Def_def_unk_unknown_41 a ex:Definition ;
    rdfs:label "An area managed for the production of timber and other forest products, or maint..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "An area managed for the production of timber and other forest products, or maintained under woody vegetation for indirect benefits as protection of a watershed, recreation, or wildlife habitat. When used as a proper noun, it refers to the Chattahoochee or Oconee National Forest (both if plural). http://www.safc.org/resources/glossary.htm#F"@en .

ex:Def_def_unk_unknown_42 a ex:Definition ;
    rdfs:label "An ecosystem characterized by more or less dense and extensive tree cover, often..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "An ecosystem characterized by more or less dense and extensive tree cover, often consisting of stands varying in characteristics such as species compositions, structure, age class and associated processes, and commonly including meadows, streams, fish, and wildlife. Thus forest could be defined as a set of land parcels that has or could have tree vegetation and is managed as a whole to achieve the objective of the owner. http://www.environmental-auditing.org/LinkClick.aspx?fileticket=fbx%2FbAIVeFU%3D&tabid=128&mid=568"@en .

ex:Def_def_unk_unknown_43 a ex:Definition ;
    rdfs:label "Areas with a? minimum of 10% crown cover of trees and/or bamboos, generally asso..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_43_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Areas with a? minimum of 10% crown cover of trees and/or bamboos, generally associated with wild flora and fauna and natural soil conditions, and are not subject to agricultural practices. Note that in some countries, some areas are statutorily defined as ?Forest Area? that contain no tree cover. http://sedac.ciesin.columbia.edu/tg/guide_frame.jsp?rd=LU&ds=1"@en .

ex:Def_def_unk_unknown_43_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_unk_unknown_44 a ex:Definition ;
    rdfs:label "Forest is defined as >30% crown cover and the tree height shall be >7 m. Seedlin..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_44_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Forest is defined as >30% crown cover and the tree height shall be >7 m. Seedlings under forest are also included in this class. Areas occupied by forest and woodlands with a vegetation pattern composed of native or exotic coniferous trees, and which can be used for the production of timber or other forest products. The forest trees are under normal climatic conditions higher than 5 m with a canopy closure of 30% at least. http://www.grida.no/baltic/related/balans_landcover_classification_methodology_ver2.pdf"@en .

ex:Def_def_unk_unknown_44_criteria ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float ;
    ex:minHeight "7.0"^^xsd:float ;
    ex:minHeightSI "7.0"^^xsd:float .

ex:Def_def_unk_unknown_47 a ex:Definition ;
    rdfs:label "Forestland means land, other than land owned by the federal government, that was..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Forestland means land, other than land owned by the federal government, that was, as of the effective date of this section, available for and capable of growing a crop of trees of any commercial species used to produce lumber and other forest products, including Christmas trees. Commercial species are those species so designated by the board. http://www.ancienttrees.org/fulltext.php"@en .

ex:Def_def_unk_unknown_49 a ex:Definition ;
    rdfs:label "Land that is at least 10 percent stocked by forest trees of any size, or land fo..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_49_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Land that is at least 10 percent stocked by forest trees of any size, or land formerly having such tree cover, and is not currently developed for a nonforest use. The minimum area for classification as forest land is one acre. Roadside, stream-side, and shelterbelt strips of timber must have a crown width at least 120 feet wide to qualify as forest land. Unimproved roads and trails, streams and other bodies of water, or natural clearings in forested areas shall be classified as forest, if less than 120 feet in width or an acre in size. Grazed woodlands, reverting fields, and pastures that are not actively maintained are included if the above qualifications are satisfied. (Also see definitions of nonforest land, idle farmland and improved/maintained pasture.) www.socrates.lv-hrc.nevada.edu/fia/dab/core1-7/appendix7_12_00.doc"@en .

ex:Def_def_unk_unknown_49_criteria ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_unk_unknown_50 a ex:Definition ;
    rdfs:label "A collection of biological organisms and non-biological factors. From an ecologi..." ;
    ex:definitionType "Ecological" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A collection of biological organisms and non-biological factors. From an ecological perspective, the definition of a forest includes all these things, from the trees to the bacteria, and the soil type to the microclimates http://mff.dsisd.net/Environment/EcologyForests.htm"@en .

ex:Def_def_unk_unknown_51 a ex:Definition ;
    rdfs:label "Land on which the native vegetation (climax or natural potential) is forest. htt..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Land on which the native vegetation (climax or natural potential) is forest. http://www.tamu.edu/classes/rang/rknight/rlem102/lecture3/rangeland-definitions.pdf"@en .

ex:Def_def_unk_unknown_52 a ex:Definition ;
    rdfs:label "Land with woody vegetation that meets an internationally accepted definition (e...." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "Land with woody vegetation that meets an internationally accepted definition (e.g., UNFCCC, FAO or IPCC) of what constitutes a forest, which includes threshold parameters, such as minimum forest area, tree height and level of crown cover, and may include mature, secondary, degraded and wetland forests. http://www.v-c-s.org/docs/Program%20Definitions,%20Consultation%202011.pdf"@en .

ex:Def_def_unk_unknown_53 a ex:Definition ;
    rdfs:label "The term ‘forest’ refers to woody vegetation, but it is also linked to specific ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The term ‘forest’ refers to woody vegetation, but it is also linked to specific institutions empowered to manage forests. http://www.asb.cgiar.org/pdfwebdocs/ASBPB13.pdf"@en .

ex:Def_def_unk_unknown_554 a ex:Definition ;
    rdfs:label "(Isle of Man) The term \"tree\" is generally not defined. In certain Acts the term..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Isle of Man) The term \"tree\" is generally not defined. In certain Acts the term is given a special meaning, e.g. - In the Forestry Act \"trees\" is defined as including shrubs. \"IOM Gov DAFF\" <daff@gov.im"@en .

ex:Def_def_unk_unknown_555 a ex:Definition ;
    rdfs:label "(Luxembourg) Eléments ligneux pérennes comportant un tronc principal unique ou ,..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_United_Nations ;
    skos:note "(Luxembourg) Eléments ligneux pérennes comportant un tronc principal unique ou , s'agissant de taillis, comprennant plusieurs tiges, un houppier plus ou moins caractérisé. Source: Definitions De La Foret Utilisees Dans Le Cadre De L'inventaire Forestier National Au Luxembourg (Marc Wagner)"@en .

ex:Def_def_unk_unknown_570 a ex:Definition ;
    rdfs:label "The following table (table 3) focuses on national definitions of forest. Some co..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The following table (table 3) focuses on national definitions of forest. Some countries reported having no national or official definitions of forest or tree. This information is also useful. Countries reporting no official definitions include:"@en .

ex:Def_def_unk_unknown_571 a ex:Definition ;
    rdfs:label "Seychelles (uses the international convention for these definitions - but conven..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Seychelles (uses the international convention for these definitions - but conventions not specified) Source: M.K Vielle Assistant Director Forestry. : \"doe\" <doe@seychelles.net"@en .

ex:Def_def_unk_unknown_581 a ex:Definition ;
    rdfs:label "A forest with low tree densities, often defined as less than 20% to 30% crown co..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_581_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A forest with low tree densities, often defined as less than 20% to 30% crown cover when trees are mature. http://www.sfrc.ufl.edu/Extension/ssfor11.htm"@en .

ex:Def_def_unk_unknown_581_criteria ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float .

ex:Def_def_unk_unknown_582 a ex:Definition ;
    rdfs:label "An area planted to trees for fuel, or timber. http://www.echonet.org/Technotes/A..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "An area planted to trees for fuel, or timber. http://www.echonet.org/Technotes/AgroforestryPrinciples.html#definitions"@en .

ex:Def_def_unk_unknown_583 a ex:Definition ;
    rdfs:label "Area that has some forest characteristics but does not meet the definition of fo..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Area that has some forest characteristics but does not meet the definition of forest given above. Includes areas occupied by windbreaks groups of trees, fallow land, and shrubland. http://www.wrm.org.uy/actors/WB/1991policy3.html and. https://www.uni-hohenheim.de/i490a/teaching/M4901-430/ws_03_04/reading_materials/New_Neef_Schwarzmeier_Studie.pdf."@en .

ex:Def_def_unk_unknown_585 a ex:Definition ;
    rdfs:label "In ecological terms, a forest may be differentiated from a woodland: a forest is..." ;
    ex:definitionType "Ecological" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "In ecological terms, a forest may be differentiated from a woodland: a forest is considered to have a more or less closed canopy, where the branches and foliage of trees meet or interlock; a woodland is considered to have an open canopy, where some sunlight penetrates between the trees (see also: savanna). http://explanation-guide.info/meaning/Forest.html"@en .

ex:Def_def_unk_unknown_586 a ex:Definition ;
    rdfs:label "Trees outside forests (ToF). Trees and tree environments on lands not defined as..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_586_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "Trees outside forests (ToF). Trees and tree environments on lands not defined as forest or other wooded lands. Include: (a) groups of trees covering an area of less 0.5 ha, including lines and shelterbelts along infrastructure features and agricultural fields; (b) scattered trees in agricultural landscapes; (c) tree plantations mainly for other purposes than wood, such a fruit orchards and palm plantations; and trees in parks and gardens and around buildings. ToF are not assigned an area in the overall land use classification, but occurs inside Other wooded land and Other land. Although the definition of ToF is based on the trees, the concept includes also the site and other vegetation at the location. (FAO 2000b)"@en .

ex:Def_def_unk_unknown_586_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float .

ex:Def_def_unk_unknown_587 a ex:Definition ;
    rdfs:label "Wood lot means any piece of land of which trees in each hectare being not less t..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Wood lot means any piece of land of which trees in each hectare being not less than twenty-five; http://www.goaforest.com/regulation/body_preservoftrees2.htm"@en .

ex:Def_def_unk_unknown_588 a ex:Definition ;
    rdfs:label "Wooded area - Corresponds to the FAO definition of forest and woodland. It refer..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "Wooded area - Corresponds to the FAO definition of forest and woodland. It refers to land under natural or planted stands of trees, whether productive or not, and includes land from which forests have been cleared but that will be reforested in the foreseeable future. http://www.tpesp.es/informe/HTMNF/COMPENDI/CHAP8.HTM"@en .

ex:Def_def_unk_unknown_596 a ex:Definition ;
    rdfs:label "The amount of live trees on a given area in relation to what is considered the o..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USDA ;
    skos:note "The amount of live trees on a given area in relation to what is considered the optimum. [Source: USDA Forest Service General Technical Report WO-44. Forest Stand Density and Stocking: concepts, terms, and use of the stocking guides. 8 p.]"@en .

ex:Def_def_unk_unknown_598 a ex:Definition ;
    rdfs:label "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking l..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years."@en .

ex:Def_def_unk_unknown_6 a ex:Definition ;
    rdfs:label "Our search focused on the key terms - forest, afforestation, deforestation and r..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Our search focused on the key terms - forest, afforestation, deforestation and reforestation. However, we found that we need to discuss and have a common of understanding of other terms as well. Groupings are based upon literal interpretations of the definitions. The decision on which terms and definitions presented here must be considered in light with the end point in mind. Most importantly, we need a clear understanding of what it is that we are interested in and how we wish to use the information. It may turn out that none of the terms listed below are what is needed."@en .

ex:Def_def_unk_unknown_601 a ex:Definition ;
    rdfs:label "(Czech Republic1995) Afforestation shall mean the establishment of forest stand,..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Czech Republic1995) Afforestation shall mean the establishment of forest stand, http://www.uhul.cz/images/ke_stazeni/legislativa_jazyky/Lesni_zakon_en.pdf"@en .

ex:Def_def_unk_unknown_609 a ex:Definition ;
    rdfs:label "Generally refers to the planting of trees on ground where trees have never exist..." ;
    ex:definitionType "Ecological" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Generally refers to the planting of trees on ground where trees have never existed or were last present hundreds of years ago. Afforestation carbon offset projects bear an additional burden of showing ecological compatibility. http://www.usask.ca/agriculture/caedac/dbases/glossary.htm and http://www.undp.org/seed/forest/pdf/InnovatForesFinanc.pdf."@en .

ex:Def_def_unk_unknown_611 a ex:Definition ;
    rdfs:label "Is afforestation by natural means a sink that we need to track?" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Is afforestation by natural means a sink that we need to track?"@en .

ex:Def_def_unk_unknown_624 a ex:Definition ;
    rdfs:label "A fancy word that means exactly what you probably think it means: the destructio..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A fancy word that means exactly what you probably think it means: the destruction of forested lands. http://science.howstuffworks.com/environmental/conservation/issues/what-is-deforestation.htm"@en .

ex:Def_def_unk_unknown_626 a ex:Definition ;
    rdfs:label "Forest loss; typically defined as a forest losing 40 percent or more of the tree..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Forest loss; typically defined as a forest losing 40 percent or more of the trees. http://www.oznet.ksu.edu/library/MISC2/SB661.PDF"@en .

ex:Def_def_unk_unknown_627 a ex:Definition ;
    rdfs:label "The clearing, destroying, or otherwise removal of trees through deliberate, natu..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The clearing, destroying, or otherwise removal of trees through deliberate, natural or accidental means. http://www.pachamama.org/effects-of-deforestation"@en .

ex:Def_def_unk_unknown_633 a ex:Definition ;
    rdfs:label "Forest conversion to other uses, leaving out logged areas to regenerate. http://..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Forest conversion to other uses, leaving out logged areas to regenerate. http://www.auburn.edu/~hurlbkl/definition.htm"@en .

ex:Def_def_unk_unknown_639 a ex:Definition ;
    rdfs:label "The clearing of virgin forests, or intentional destruction or removal of trees a..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The clearing of virgin forests, or intentional destruction or removal of trees and other vegetation for agricultural, commercial, housing, or firewood use without replanting (reforesting) and without allowing time for the forest to regenerate itself. Deforestation is one of the major factors contributing to the greenhouse effect and desertification. http://www.businessdictionary.com/definition/deforestation.html"@en .

ex:Def_def_unk_unknown_641 a ex:Definition ;
    rdfs:label "The permanent destruction of forests and woodlands; it occurs as the forests are..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The permanent destruction of forests and woodlands; it occurs as the forests are converted for agricultural uses. http://www.auburn.edu/~hurlbkl/definition.htm"@en .

ex:Def_def_unk_unknown_643 a ex:Definition ;
    rdfs:label "The willful and permanent transition in vegetative cover from that which is clea..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The willful and permanent transition in vegetative cover from that which is clearly \"forest\" (regardless of the commercial or aesthetic value of the trees) to that which is clearly devoted to other uses - with trees seen as undesirable invaders. On this definition, the clear cutting of portions of a forest with the intention of allowing regeneration of trees does not qualify as deforestation - even though all the trees are removed at a certain time (Daniel W. Bromley, Deforestation: Institutional Causes And Solutions, in World Forests, Society and Environment, Volume I. In press)."@en .

ex:Def_def_unk_unknown_644 a ex:Definition ;
    rdfs:label "Simply means to \"divest of forests\". http://www.britell.com/misc/lex.html" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Simply means to \"divest of forests\". http://www.britell.com/misc/lex.html"@en .

ex:Def_def_unk_unknown_655 a ex:Definition ;
    rdfs:label "Generally refers to planting trees on land that has been cleared of forest withi..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Generally refers to planting trees on land that has been cleared of forest within the relatively recent past. May or may not refer to planting trees on land that has just been harvested. . http://www.climateservices.com/glossary.htm and http://www.undp.org/seed/forest/pdf/InnovatForesFinanc.pdf"@en .

ex:Def_def_unk_unknown_659 a ex:Definition ;
    rdfs:label "(WCMC) Forest restoration - the establishment of forests containing native speci..." ;
    ex:definitionType "Ecological" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(WCMC) Forest restoration - the establishment of forests containing native species with a high ecological integrity. Restoration is defined as the deliberate alteration of ecological patterns and processes for the purpose of recreating some presumed set of natural, predisturbance ecosystem conditions. http://www.panda.org/downloads/forests/wcmcflrmapping.pdf"@en .

ex:Def_def_unk_unknown_660 a ex:Definition ;
    rdfs:label "Do we need to track reforestation by natural means as a sink?" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Do we need to track reforestation by natural means as a sink?"@en .

ex:Def_def_unk_unknown_664 a ex:Definition ;
    rdfs:label "Renewal of a forest crop by natural, artificial or vegetative (regrowth) means. ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_664_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Renewal of a forest crop by natural, artificial or vegetative (regrowth) means. Also the new crop so obtained. The new crop is generally less than 1.3 m high. http://nrcan.gc.ca/cfs/proj/iepb/nfdp/regen/regen_e/s18.htm"@en .

ex:Def_def_unk_unknown_664_criteria ex:minHeight "1.3"^^xsd:float ;
    ex:minHeightSI "1.3"^^xsd:float .

ex:Def_def_unk_unknown_665 a ex:Definition ;
    rdfs:label "Renewal of a tree crop, either by natural or artificial means. -Young tree crop ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Renewal of a tree crop, either by natural or artificial means. -Young tree crop (17). http://rredc.nrel.gov/biomass/forest/tim_glossary/t_glossary.html#F"@en .

ex:Def_def_unk_unknown_669 a ex:Definition ;
    rdfs:label "If change of a designation of forest land to protected, wilderness, or national ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "If change of a designation of forest land to protected, wilderness, or national park is considered a change in land administration or use, and if change in land use is considered deforestation and if deforestation is considered an emission, then a nation may be reluctant to protect or preserve its forest resources."@en .

ex:Def_def_unk_unknown_670 a ex:Definition ;
    rdfs:label "Implications - Deforestation definition may not be politically acceptable. If bi..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Implications - Deforestation definition may not be politically acceptable. If biomass is not tracked, one could remove the overstory to within the crown cover threshold and be required to report removal as an emission."@en .

ex:Def_def_unk_unknown_671 a ex:Definition ;
    rdfs:label "Failing the acceptance of a land cover approach, a nation may use any definition..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Failing the acceptance of a land cover approach, a nation may use any definition of forest land it chooses, but would have to keep and use the same definition over the reporting periods. However, we would not be able to make country to country comparisons or analyses unless all countries used the same definition."@en .

ex:Def_def_unk_unknown_672 a ex:Definition ;
    rdfs:label "Here are some generic, politically-correct definitions of deforestation, refores..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "Here are some generic, politically-correct definitions of deforestation, reforestation and afforestation applicable to any definition of \"forest land.\""@en .

ex:Def_def_unk_unknown_673 a ex:Definition ;
    rdfs:label "The purpose of this paper is not to come up with final definitions, but to show ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The purpose of this paper is not to come up with final definitions, but to show the breadth of definitions in use. There is a test at the end of this document. Ultimately, all countries should come up with the same answers. In the meantime, we can ponder such things as are natural tree invasions, in the case of afforestation, and natural regeneration, in the case of reforestation, acknowledged or accepted? Do the terms reforestation and afforestation imply that there will be timber crops produced or just tree cover increased? . Do human-induced \"afforestation, deforestation, and reforestation\" cover all forestry activities that affect carbon emissions and sinks we need to track? What about natural deforestation, afforestation, and reforestation? Do we need other terms to describe other situations - such as the restocking of a recent clearcut area?"@en .

ex:Def_def_unk_unknown_674 a ex:Definition ;
    rdfs:label "If one is speaking of carbon sequestration, the fact that some lands with trees ..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "If one is speaking of carbon sequestration, the fact that some lands with trees are considered forests and others are considered agricultural lands is unimportant. Rather than getting embroiled with definitions of forests, etc., we may prefer to speak of vegetated, revegetated, and devegetated lands where woody vegetation is the primary interest. Thus, one would include all lands with trees on them (forests, agricultural lands, urban areas, etc) and the changes in that cover."@en .

