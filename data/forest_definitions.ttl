ex:Def_def_vie_2016_1055 a ex:Definition ;
    rdfs:label "(Viet Nam 2016) The definition of forests used for the construction of FREL/FRL ..." ;
    ex:appliesTo ex:Country_Vietnam ;
    ex:country "Vietnam" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_vie_2016_1055_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    skos:note "(Viet Nam 2016) The definition of forests used for the construction of FREL/FRL for Vietnam, applies the definitions provided under Circular No. 34/2009/TT-BNNPTNT on criteria for forest identification and classification, defining forests as: minimum 10% tree cover, at a minimum height of 5 meters, over a minimum area of 0.5 ha or forest tree strips of at least 20 meters in width and of at least 3 tree lines. Agricultural and aqua-cultural ecosystems with scattered perennial trees, bamboos or palms etc. will not be regarded as forests. http://redd.unfccc.int/files/2016_submission_frel_viet_nam.pdf"@en .

ex:Def_def_vie_2016_1055_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

