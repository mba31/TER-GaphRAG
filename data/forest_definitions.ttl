ex:Def_def_usa_1996_1141 a ex:Definition ;
    rdfs:label "(USA-STATE-Montana 1996) \"Forest\" means forest land and the timber on the land. ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_1996_1141_criteria ;
    ex:hasSource ex:Source_USA-STATE-Montana ;
    skos:note "(USA-STATE-Montana 1996) \"Forest\" means forest land and the timber on the land. (5) \"Forest land\" means contiguous land of 15 acres or more in one ownership that is capable of producing timber that can be harvested in commercial quantity and is producing timber unless the trees have been removed by man through harvest, including clearcuts, or by natural disaster, including but not limited to fire. Forest land includes land: (a) that has not been converted to another use. http://data.opi.mt.gov/bills/1997/Bills/Senate/SB0100_ENR.htm"@en .

ex:Def_def_usa_1996_1141_criteria ex:minArea "15.0"^^xsd:float ;
    ex:minAreaSI "6.07029"^^xsd:float .

