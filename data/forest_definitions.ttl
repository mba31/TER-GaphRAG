    ex:hasCriteria ex:Def_def_unk_2000_1243_criteria ;
    ex:hasSource ex:Source_United_Nations ;
    skos:note "(UN-FRA 2000) Refers to change of land cover with depletion of tree crown cover to less than 10 percent. Changes within the forest class (e.g. from closed to open forest) which negatively affect the stand or site and, in particular, lower the production capacity, are termed forest degradation. (UN-ECE/FAO 1997 and FAO 1998)"@en .

ex:Def_def_unk_2000_1243_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

