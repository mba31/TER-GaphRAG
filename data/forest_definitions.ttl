    ex:hasCriteria ex:Def_def_unk_1990_1233_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A group of trees reasonably similar in age structure and species composition, usually occupying at least 5 acres (Hunter 1990). http://depts.clemson.edu/extfor/publications/fortp19/definitions.htm"@en .

