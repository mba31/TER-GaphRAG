    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2017_348_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Liberia KP) Liberia is proposing a forest definition that consists of a minimum canopy cover of 30%, trees greater than 5 meters, and a minimum mapping unit of 1 hectare. http://www.forestcarbonpartnership.org/fcp/sites/forestcarbonpartnership.org/files/Documents/PDF/May2011/Liberia%20R-PP%20revised%20draft%20for%20presubmission%2017-03-11.pdf"@en .

