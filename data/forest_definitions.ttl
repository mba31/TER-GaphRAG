ex:Def_def_unk_2000_1033 a ex:Definition ;
    rdfs:label "‘Forest’ is understood to include all forest ecosystems (from coastal scrub and ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "‘Forest’ is understood to include all forest ecosystems (from coastal scrub and mangroves through to cloud forests) and non-agricultural trees, as well as the goods and services that they provide. (Grenada’ means ‘Grenada, Carriacou and Petit Martinique)"@en .

ex:Def_def_unk_2000_125 a ex:Definition ;
    rdfs:label "items are most relevant for the present study: • Forest land: Forest is defined ..." ;
