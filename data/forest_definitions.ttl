    skos:note "Land which is currently producing (or, in some cases, capable of producing) a forest. and"@en .

ex:Def_def_unk_unknown_94 a ex:Definition ;
    rdfs:label "Forestry - Compact forest complexes covering 75-80% of the area" ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_94_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:region "Europe" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
