    skos:note "Stocking - An indication of the number of trees in a stand as compared to the desirable number for best growth and management, such as well-stocked, overstocked, partially stocked"@en .

ex:Def_def_usa_unknown_1524 a ex:Definition ;
    rdfs:label "Stocking - The number of trees in a forest stand. Often, stocking level is compa..." ;
