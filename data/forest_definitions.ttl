ex:Def_def_unk_2017_1457 a ex:Definition ;
    rdfs:label "Woodlands - Wooded areas where trees and shrubs are predominant. There are wet a..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_2017_1457_criteria ;
