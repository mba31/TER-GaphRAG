    skos:note "Forestry - Compact forest complexes covering 75-80% of the area"@en .

ex:Def_def_unk_unknown_943 a ex:Definition ;
    rdfs:label "Forest lands include lands covered by forest vegetation or those not covered by ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest lands include lands covered by forest vegetation or those not covered by it but intended for its restoration (cutovers, slashes, perished forest stands, open stands [comment: better-sparse forests], wastelands, glades [comment: better-grassy glades and barrens], areas occupied by nurseries, free-growing forest cultures [comment; i.e., forest plantations], and others"@en .

ex:Def_def_unk_unknown_94_criteria ex:minCanopyCover "80.0"^^xsd:float ;
    ex:minCanopyCoverSI "80.0"^^xsd:float .

ex:Def_def_unk_unknown_958 a ex:Definition ;
    rdfs:label "Forest area is land under natural or planted stands of trees of at least 5 meter..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_958_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest area is land under natural or planted stands of trees of at least 5 meters in situ, whether productive or not, and excludes tree stands in agricultural production systems (for example, in fruit plantations and agroforestry systems) and trees in urban parks and gardens"@en .

ex:Def_def_unk_unknown_958_criteria ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_unknown_96 a ex:Definition ;
    rdfs:label "An ecosystem with a minimum of 10 percent crown cover of trees, and other wooded..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "An ecosystem with a minimum of 10 percent crown cover of trees, and other wooded lands are those which are covered by trees, bushes or scattered shrubs, whether natural or planted by people, and which may be cultivated (as agro-forestry lands) or not and which are generally associated with wild flora and fauna. \"Moussa, Omnia (FAORNE)\"Omnia.Moussa@fao.org"@en .

ex:Def_def_unk_unknown_967 a ex:Definition ;
    rdfs:label "Forest land - the land that is at least 0.5 hectare in size with at least 10% of..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_967_criteria ;
    ex:hasSource ex:Source_The_Third_Forest_Resources_and_Land_Use_Inventory_in_Taiwan ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest land - the land that is at least 0.5 hectare in size with at least 10% of the area covered with tree crowns or commercial bamboo, the forest belt beside road or river is at least 50 meters wide. The road, river, other water area or open lands in forest is less than 20 meters wide. The open land over than 0.5 hectare which is considered to reforestation or afforestation. Source: The Third Forest Resources and Land Use Inventory in Taiwan&uml; - \"&ordf;L&deg;È&sect;&frac12;service\" service@dns.forest.gov.tw"@en .

ex:Def_def_unk_unknown_967_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "50.0"^^xsd:float ;
    ex:minHeightSI "50.0"^^xsd:float ;
    ex:minWidth "50.0"^^xsd:float ;
    ex:minWidthSI "50.0"^^xsd:float .

ex:Def_def_uru_1988_776 a ex:Definition ;
    rdfs:label "A los efectos de la aplicación de esa Ley, se consideran bosques las asociacione..." ;
    ex:appliesTo ex:Country_Uruguay ;
    ex:country "Uruguay" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_uru_1988_776_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "A los efectos de la aplicación de esa Ley, se consideran bosques las asociaciones vegetales que tengan ciertas características y que ocupen una superficie mínima de 2 500 m&sup2;. Además, se designan como terrenos forestales ciertas zonas o grupos de suelos (costas arenosas, orillas de ríos, etc.) y se habilita al departamento competente para designar otras por razones de conveniencia pública y teniendo en cuenta la aptitud forestal de los suelos. Por otra parte, el presente Decreto establece los requisitos y los criterios según los cuales los \"bosques particulares\" pueden calificarse como protectores o productores. Cuando sus características no permitan incluirlos en la calificación indicada se considerarán \"bosques generales\". Asimismo se declara obligatoria la plantación de ciertos terrenos forestales que ocupen una superficie mínima de 10 hectáreas. Por último se dictan varias disposiciones cuyo objeto es la conservación de los recursos forestales y, en particular, la prohibición de las cortas que sean perjudiciales para los bosques protectores. LEX-FAOC003578. URUGUAY: Decreto 452/988 por el que se dictan normas reglamentarias para considerar bosques aquellas asociaciones vegetales de determinadas características. Date of text: 06 July 1988"@en .

ex:Def_def_uru_1988_776_criteria ex:minHeight "500.0"^^xsd:float ;
    ex:minHeightSI "500.0"^^xsd:float .

ex:Def_def_uru_2006_777 a ex:Definition ;
