ex:Def_def_chi_2008_401 a ex:Definition ;
    rdfs:label "Bosque: sitio poblado con formaciones vegetales en las que predominan árboles y ..." ;
    ex:appliesTo ex:Country_Chile ;
    ex:country "Chile" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
