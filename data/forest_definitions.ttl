ex:Def_def_uk_2010_1453 a ex:Definition ;
    rdfs:label "‘Ancient woodland in England is defined as an area that has been wooded continuo..." ;
    ex:appliesTo ex:Country_UK ;
    ex:country "UK" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "‘Ancient woodland in England is defined as an area that has been wooded continuously since at least 1600 AD. Ancient woodland is divided into ancient semi-natural woodland and plantations on ancient woodland sites. Both types of stand are classed as ancient woods.’"@en .

ex:Def_def_uk_2010_1454 a ex:Definition ;
    rdfs:label "Recent woodland (less than 400 years old), is where a wood has either been plant..." ;
    ex:appliesTo ex:Country_UK ;
