ex:Def_def_bul_2007_824 a ex:Definition ;
    rdfs:label "“Area over 0.1 ha, covered with forest tree species higher than 5 meters and tre..." ;
    ex:appliesTo ex:Country_Bulgaria ;
    ex:country "Bulgaria" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_bul_2007_824_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "“Area over 0.1 ha, covered with forest tree species higher than 5 meters and tree crown cover over 10% or with trees which can reach these parameters in natural environment. Forests are also: 1. areas which are in a process of recovering and are still under the parameters, but it is expected to reach forest crown cover over 10% and tree height 5 meters; 2. areas, which as the result of anthropogenic factors of or natural reasons are temporary deforested, but will be reforested; 3. protective forest belts, as well as tree lines with area over 0.1 ha and width over 10 meters; 4. cork oak stands.”"@en .

