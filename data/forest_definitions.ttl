ex:Def_def_spa_2008_710 a ex:Definition ;
    rdfs:label "Forest surface is considered the land populated by forest tree species and whose..." ;
    ex:appliesTo ex:Country_Spain ;
    ex:country "Spain" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_spa_2008_710_criteria ;
