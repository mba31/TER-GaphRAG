    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Continuously forested areas with a land spanning of more than one hectare with trees higher than five metres and a canopy cover of more than 30%, or trees able to reach those thresholds in situ"@en .

ex:Def_def_unk_2009_121_criteria ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float .

ex:Def_def_unk_2009_126 a ex:Definition ;
    rdfs:label "the UN defines a forest as any area larger than 500 square metres with crown cov..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_United_Nations ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "the UN defines a forest as any area larger than 500 square metres with crown cover of 10 per cent and trees capable of growing two metres high. The differences between native forests and monoculture industrial tree plantations cannot be identified by this definition (UN-REDD, 2009)"@en .

ex:Def_def_unk_2009_1343 a ex:Definition ;
    rdfs:label "“Tree” means forest trees including bushes, palms, bamboos, shrubs, brushwood, c..." ;
    ex:appliesTo ex:Country_Unknown ;
