ex:Def_def_unk_2009_276 a ex:Definition ;
    rdfs:label "(Slovak Republilc 2009) National definition: Forest is land spanning more than 0..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2009_276_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Slovak Republilc 2009) National definition: Forest is land spanning more than 0.3 ha with trees taller than 5 m and a canopy cover of more than 20%, or trees able to reach these thresholds in situ. Ministry of Agriculture of the Slovak Republic, 2009. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf"@en .

