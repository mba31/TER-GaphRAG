    ex:country "Czech Republic" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Czech Republic 1995) - stand shall mean the basic unit of spatial arrangement of the forest identifiable in the terrain and shown on a forestry map http://www.uhul.cz/images/ke_stazeni/legislativa_jazyky/Lesni_zakon_en.pdf"@en .

ex:Def_def_cze_1995_320 a ex:Definition ;
    rdfs:label "(Czech Republic 1995) Forest stands with its environment and land designated for..." ;
    ex:appliesTo ex:Country_Czech_Republic ;
    ex:country "Czech Republic" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cze_1995_320_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Czech Republic 1995) Forest stands with its environment and land designated for the fulfillment of forest functions. Forest functions shall mean benefits towards the general well-being of the society conditional on the existence of forests, which consist of wood-producing and non-wood-producing functions. Forest stands shall mean trees and shrubs of forest tree species which, in their particular environment, fulfil forest functions. [Source: Act on Forests and Amendments to Some Acts (the Forest Act) dated 3 November 1995. Ministry of Agriculture of the Czech Republic. Prague, 1996. 58 pp. From: \"Maksym Polyakov\" <mpoliak@pcomp.usau.kiev.ua Date: Mon, 15 Jun 1998 11:32:47 +0300 (MSD)] and http://www.uhul.cz/images/ke_stazeni/legislativa_jazyky/Lesni_zakon_en.pdf"@en .

ex:Def_def_cze_1995_320_criteria ex:minHeight "1995.0"^^xsd:float ;
    ex:minHeightSI "1995.0"^^xsd:float .

