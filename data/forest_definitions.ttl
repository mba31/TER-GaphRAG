    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float .

ex:Def_def_usa_2003_778 a ex:Definition ;
    rdfs:label "Minimum area = 0.5 ha, minimum tree crown cover =30%, minimum tree height = Vari..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
