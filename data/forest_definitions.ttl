    skos:note "Forest land includes the area of forest stands, nurseries, plantations, temporary clearings where forest is under regeneration, forest roads, meadows and other areas"@en .

ex:Def_def_slo_unknown_950 a ex:Definition ;
    rdfs:label "Forest Land includes: land with minimum tree crown cover of 20 % for trees capab..." ;
    ex:appliesTo ex:Country_Slovakia ;
    ex:country "Slovakia" ;
