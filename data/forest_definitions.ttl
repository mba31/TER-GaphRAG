ex:Def_def_gre_2012_498 a ex:Definition ;
    rdfs:label "A forest is an area where wild trees with wooden trunk exist and forest lands wh..." ;
    ex:appliesTo ex:Country_Greece ;
    ex:country "Greece" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "A forest is an area where wild trees with wooden trunk exist and forest lands where wild plants with hard branches like bushes, low or tall, even rocky areas that are surrounded by areas with such vegetation. Any piece of land if not cultivated can become a forest land. Chryssy Potsiou . chryssyp@survey.ntua.gr 5 Feb. 2012"@en .

ex:Def_def_gre_2013_871 a ex:Definition ;
    rdfs:label "NEW DEFINTION: Forest is a land with 10% crown cover with minimum height of tree..." ;
