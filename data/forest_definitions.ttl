ex:Def_def_unk_unknown_1492 a ex:Definition ;
    rdfs:label "In a woodland, trees are spaced further apart. In a forest, the treetops touch e..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "In a woodland, trees are spaced further apart. In a forest, the treetops touch each other to form a canopy"@en .

ex:Def_def_unk_unknown_1493 a ex:Definition ;
    rdfs:label "In a woodland, trees grow far apart, so that the canopy is open. In a forest the..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "In a woodland, trees grow far apart, so that the canopy is open. In a forest the crowns of individual trees touch to form a single canopy"@en .

ex:Def_def_unk_unknown_1494 a ex:Definition ;
    rdfs:label "In ecological terms, a forest may be differentiated from a woodland: a forest is..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "In ecological terms, a forest may be differentiated from a woodland: a forest is considered to have a more or less closed canopy, where the branches and foliage of trees meet or interlock; a woodland is considered to have an open canopy, where some sunlight penetrates between the trees (see also: savanna)"@en .

ex:Def_def_unk_unknown_1495 a ex:Definition ;
    rdfs:label "Includes natural or planted woodlots or timber tract, cutover and deforested lan..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Includes natural or planted woodlots or timber tract, cutover and deforested land with young growth that have or will have value for wood products, land planted for Christmas tree production, and pastured woodland"@en .

ex:Def_def_unk_unknown_1496 a ex:Definition ;
    rdfs:label "Land supporting a stand of trees up to 20 m in height, with an open or continuou..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_unknown_1496_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Land supporting a stand of trees up to 20 m in height, with an open or continuous but not thickly interlaced canopy, and a canopy cover of not less than 20%. Shrubs, if present, constitute less than one-tenth of the canopy cover. Grasses and other herbs dominate the ground cover. Epiphytic ferns are rare. Often subject to periodic burning. Tree thicket (Wt) or coppice woodland (Wc) can be recognised. Sub-types by genera e.g. Brachystegia . Julbernardia woodland; Acacia seyal woodland"@en .

ex:Def_def_unk_unknown_1496_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float ;
    ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "20.0"^^xsd:float .

ex:Def_def_unk_unknown_1497 a ex:Definition ;
    rdfs:label "Other wooded areas are the wooded formations of any kind less than 0,5 ha in siz..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
