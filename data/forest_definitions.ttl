ex:Def_def_tan_2016_1048 a ex:Definition ;
    rdfs:label "(Tanzania 2016). Forest in this NFP means a land area of more than 0.5 ha, crown..." ;
    ex:appliesTo ex:Country_Tanzania ;
    ex:country "Tanzania" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_tan_2016_1048_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Tanzania 2016). Forest in this NFP means a land area of more than 0.5 ha, crown cover of 10%, trees of at least 2.5 m height, which is not primarily under agricultural or other specific non-forest land use. In line with the Constitution, the NFP also operates with “tree cover”, e.g. trees on farms. http://www.environment.go.ke/wp-content/uploads/2016/07/Kenya-NFP-draft-doc-2016-07-12-small-v2-1.pdf"@en .

ex:Def_def_tan_2016_1048_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "2.5"^^xsd:float ;
    ex:minHeightSI "2.5"^^xsd:float .

