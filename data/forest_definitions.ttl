ex:Def_def_usa_unknown_45 a ex:Definition ;
    rdfs:label "We found over 1,700 definitions. Thresholds for tree cover vary from 0% to 80%. ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_usa_unknown_45_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    skos:note "We found over 1,700 definitions. Thresholds for tree cover vary from 0% to 80%. [Note: John Dwyer has done some work which shows that average forest cover in urban USA is about 33% (From: Smith_Brad/wo@fs.fed.us)]. A crosswalk of various forest classification systems may be found at We can group forest definitions according to their source - those found in general dictionaries and glossaries, definitions from the International Community, National definitions, and state, provincial or local definitions. We can further group these into 4 categories - those that are declared or administrative units, those that mean a land cover, those that mean a land use and a miscellaneous category"@en .

ex:Def_def_usa_unknown_45_criteria ex:minCanopyCover "0.0"^^xsd:float ;
    ex:minCanopyCoverSI "0.0"^^xsd:float .

ex:Def_def_usa_unknown_6 a ex:Definition ;
