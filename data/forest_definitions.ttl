ex:Def_def_tur_2012_1324 a ex:Definition ;
    rdfs:label "(Turkey 2012) Woodlands are defined as; ‘long-lived copse with the expanding top..." ;
    ex:appliesTo ex:Country_Turkey ;
    ex:country "Turkey" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_tur_2012_1324_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Turkey 2012) Woodlands are defined as; ‘long-lived copse with the expanding top as a result of growth and overly developed side branches, showing the width growing manner in general, not reaching 8 m in length, at any age or diameter. According to the Regulation of the Forest Cadaster and 2/B Application dated 20.11.2012, (see the article 14, subparagraph B in the regulation)."@en .

ex:Def_def_tur_2012_1324_criteria ex:minHeight "8.0"^^xsd:float ;
    ex:minHeightSI "8.0"^^xsd:float ;
    ex:minWidth "8.0"^^xsd:float ;
    ex:minWidthSI "8.0"^^xsd:float .

