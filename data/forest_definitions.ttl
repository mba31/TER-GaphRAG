    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Other wooded area; woodland. Area that has some forest characteristics but does not meet the definition of forest given above. Includes areas occupied by windbreaks groups of trees, fallow land, and shrubland"@en .

ex:Def_def_tha_2001_737 a ex:Definition ;
    rdfs:label "Closed forest. Forest in which the stand density is greater than 20 percent of t..." ;
    ex:appliesTo ex:Country_Thailand ;
    ex:country "Thailand" ;
