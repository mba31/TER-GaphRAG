ex:Def_def_kyr_unknown_569 a ex:Definition ;
    rdfs:label "Forest -One of the main types of vegetation, comprised of the concomitance (?) o..." ;
    ex:appliesTo ex:Country_Kyrgyzstan ;
    ex:country "Kyrgyzstan" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest -One of the main types of vegetation, comprised of the concomitance (?) of trees, shrub, grass and other plants, also including animals and microorganisms , biologically interrelated in their development and influencing each other and environment. At the same time forest is a very important part of the biosphere and an element of geographical landscape. Forest is a raw material source. Source: Irina Yunusova <irina@lesic.elcat.kg"@en .

ex:Def_def_kyr_unknown_894 a ex:Definition ;
    rdfs:label "(forest?) areas - - Areas both covered and not covered with the forest territori..." ;
    ex:appliesTo ex:Country_Kyrgyzstan ;
