    skos:note "(Canada) Deforestation - The conversion of forested land to nonforested land as a direct result of human activities. http://carbon.cfs.nrcan.gc.ca/definitions_e.html"@en .

ex:Def_def_can_unknown_646 a ex:Definition ;
    rdfs:label "(Canada - BC) Regeneration (reforestation): The renewal of a tree crop either by..." ;
    ex:appliesTo ex:Country_Canada ;
    ex:country "Canada" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Canada - BC) Regeneration (reforestation): The renewal of a tree crop either by natural means (seeded on-site from adjacent stands or deposited by wind, birds, or animals) or by planted seedlings or direct seeding. http://www.for.gov.bc.ca/pab/publctns/westland/gloss.htm"@en .

ex:Def_def_can_unknown_647 a ex:Definition ;
    rdfs:label "(Canada) - The conversion of non-forested land to forested land through human ac..." ;
