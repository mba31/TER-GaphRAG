ex:Def_def_gre_2003_216 a ex:Definition ;
    rdfs:label "(Greece 2003) Forest is defined as an area made up of wild trees species creatin..." ;
    ex:appliesTo ex:Country_Greece ;
    ex:country "Greece" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_gre_2003_216_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Greece 2003) Forest is defined as an area made up of wild trees species creating a canopy with a crown density >25%. Forestland is defined as an area made up of wild woody vegetation (scattered trees, shrubs, or open land within forests and open land above tree line) with > 25% vegetation. There is a controversy over the threshold percent cover to characterize as forest or forest land (protection afforded by law) as formerly 15 % was used. Law 86/1969: “Forest Code”. Law 998/1979, 3208/2003.. Mouflis, George et al. n.d. Session 1: Vegetation, bioclimatic zones, forest service and forest management in Greece. Training, Networking and capacity building for Sustainable forest in Povolgie. Aristotle University of Thessaloniki. 48 slides. http://tempus.marstu.net/presentations/mouflis1(eng)_s2.pdf"@en .

ex:Def_def_gre_2003_216_criteria ex:minCanopyCover "15.0"^^xsd:float ;
    ex:minCanopyCoverSI "15.0"^^xsd:float .

