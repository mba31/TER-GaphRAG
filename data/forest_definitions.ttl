    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Applies to any tree the circumference of which is one metre or more at a point half a metre or more from the ground but does not apply to a tree the killing of which if for the prevention of imminent danger or is in compliance with an obligation under any other enactment. LEX-FAOC002736. BARBADOS: Trees (Preservation) Act, 1981 (Act No. 49). Date of text: 07 December 1981"@en .

ex:Def_def_unk_1982_1739 a ex:Definition ;
    rdfs:label "5-Agency. 1982. Recommended Land Use and Land Cover Terms and Definitions. USGS,..." ;
