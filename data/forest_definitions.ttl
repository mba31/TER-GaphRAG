ex:Def_def_bul_2013_383 a ex:Definition ;
    rdfs:label "Article 2, paragraph 1 of the Law - \"Forest for the purposes of this Act is land..." ;
    ex:appliesTo ex:Country_Bulgaria ;
    ex:country "Bulgaria" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_bul_2013_383_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Article 2, paragraph 1 of the Law - \"Forest for the purposes of this Act is land occupied by forest vegetation an area not less than 1 ha.\" In practice - any land area greater than 1 ha and a width of not less than 10 m (measured to the width of tree roots). Article 2, paragraph 2 ZGor - \"Forest Fund under this Act is the territory intended primarily for forest covering forests and shrubs, as well as land for afforestation and agricultural land referred to in the cadastre"@en .

