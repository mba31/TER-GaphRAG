    skos:note "Stocking - The number of trees in a forest stand. Often, stocking level is compared to the desirable number of trees for best growth and management, such as partially stocked, well stocked or over-stocked"@en .

ex:Def_def_usa_unknown_1536 a ex:Definition ;
    rdfs:label "A term used in this plan to designate a contiguous area of land in the same vege..." ;
