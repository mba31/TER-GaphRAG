ex:Def_def_por_1994_669 a ex:Definition ;
    rdfs:label "According to minimum tree densities which vary from species to species (as low a..." ;
    ex:appliesTo ex:Country_Portugal ;
    ex:country "Portugal" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_por_1994_669_criteria ;
