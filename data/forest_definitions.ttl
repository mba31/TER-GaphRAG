ex:Def_def_kaz_2002_1063 a ex:Definition ;
    rdfs:label "(Kazakhstan 2002) \"forest\" means a natural complex formed on a certain territory..." ;
    ex:appliesTo ex:Country_Kazakhstan ;
    ex:country "Kazakhstan" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "(Kazakhstan 2002) \"forest\" means a natural complex formed on a certain territory based on the aggregate of trees and shrubs vegetations and other wildlife components interacting with environment and having environmental, economic and social importance; Forest Code of the Republic of Kazakhstan: faolex.fao.org/docs/texts/kaz41426E.doc"@en .

ex:Def_def_kaz_2002_398 a ex:Definition ;
    rdfs:label "(Kazakhstan 2002) \"forest\" means a natural complex formed on a certain territory..." ;
