ex:Def_def_cam_1994_1717 a ex:Definition ;
    rdfs:label "(Cameroon 1994) Cameroon is based on the 1994 Forest Code, in which community fo..." ;
    ex:appliesTo ex:Country_Cameroon ;
    ex:country "Cameroon" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cam_1994_1717_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Cameroon 1994) Cameroon is based on the 1994 Forest Code, in which community forests are defined as forest areas in the ‘non-Permanent Forest Domain’ (NPFD), a land use designation that permits timber extraction, agriculture, mining, and other utilisation activities. Each community forest must not exceed 5,000 hectares, and must be managed by village communities following a simplified management plan that excludes the use of heavy machinery. http://files.forestsnetwork.org/Chapter4.pdf"@en .

ex:Def_def_cam_1994_1717_criteria ex:minArea "0.0"^^xsd:float ;
    ex:minAreaSI "0.0"^^xsd:float .

