    ex:hasSource ex:Source_Unknown ;
    skos:note "(Ethiopia 2007) \"forest land\" means a land that is demarcated for the purpose of forest development and conservation. http://www.pfmp-farmsos.org/Docs/forest%20proclamation_english.pdf"@en .

ex:Def_def_unk_2007_1171 a ex:Definition ;
    rdfs:label "(Ethiopia 2007) \"tree\" means any woody plant regardless of its species, age or s..." ;
