    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Usually trees are defined as having a large, single trunk rising above the ground. The trunk is composed of wood and is divided usually into a series of branches"@en .

ex:Def_def_unk_unknown_14 a ex:Definition ;
