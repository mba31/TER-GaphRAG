ex:Def_def_tan_2008_1600 a ex:Definition ;
    rdfs:label "(Tanzania 2008 KP) a forest is areas with trees of a height of more than 3m, wit..." ;
    ex:appliesTo ex:Country_Tanzania ;
    ex:country "Tanzania" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_tan_2008_1600_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Tanzania 2008 KP) a forest is areas with trees of a height of more than 3m, with a crown cover of 30%, covering one hectare of land. (In a communication in October 2008 between Sangito Sumari, Managing Director of GreenResources Ltd and Dr Tango, Ministry of National Resources and Tourism, Tanzania, a definition of 2.5m,30% and 1 ha was indicated). http://www.climate-standards.org/projects/files/tanzania/ufp_mfp_combined_validation_VCS_PDD-1.pdf"@en .

ex:Def_def_tan_2008_1600_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "1.0"^^xsd:float ;
    ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float ;
    ex:minHeight "3.0"^^xsd:float ;
    ex:minHeightSI "3.0"^^xsd:float .

