ex:Def_def_spa_2008_1293 a ex:Definition ;
    rdfs:label "(Spain 2008) - Forest surface is considered the land populated by forest tree sp..." ;
    ex:appliesTo ex:Country_Spain ;
    ex:country "Spain" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_spa_2008_1293_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Spain 2008) - Forest surface is considered the land populated by forest tree species and whose dominant canopy cover (FCC) is more than 10%. It consists of: (i) woodland - land with trees whose FCC> = 20%; (ii) sparse woodland - 10% = <FCC <20%. It also includes land with scrub or grassland species dominant plant natural expression, but a FCC of between 10% and 20%. Ministerio de Medio Ambiente y Medio Rural y Marino, 2008. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf"@en .

ex:Def_def_spa_2008_1293_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

