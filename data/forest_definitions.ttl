    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest (in context of private forest) as area of 10 hectare or more having at least 200 trees per hectare. Source: Narendra Kumar nkumar@bom6.vsnl.net.in"@en .

ex:Def_def_ind_unknown_1103_criteria ex:minArea "10.0"^^xsd:float ;
    ex:minAreaSI "10.0"^^xsd:float .

ex:Def_def_ind_unknown_1320 a ex:Definition ;
    rdfs:label "In this report, denotes all perennial woody vegetation (including bamboos, palms..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_ind_unknown_1320_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "In this report, denotes all perennial woody vegetation (including bamboos, palms, coconut, neem, peepal, fruit trees, etc.). It excludes non-perennial non-woody species (e.g., banana) and tall shrubs or climbers (e.g., lantana or canes). For the purpose of assessing tree cover, only those trees having diameter of 10 cm or more at breast height (1.37 m) have been considered. In case of trees having multiple branches below breast height, the individual stems with diameter over 10 cm at breast height have been considered as individual trees"@en .

ex:Def_def_ind_unknown_1320_criteria ex:minHeight "1.37"^^xsd:float ;
    ex:minHeightSI "1.37"^^xsd:float .

ex:Def_def_ind_unknown_1321 a ex:Definition ;
    rdfs:label "The term used in this report refers to the notional area covered by crown of tre..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "The term used in this report refers to the notional area covered by crown of trees that is too small to be delineated by digital interpretation of remote sensing data used for forest cover delineation"@en .

ex:Def_def_ind_unknown_1594 a ex:Definition ;
    rdfs:label "Definitions are grouped depending on if they are changes in land cover, land use..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "3.2 DEFORESTATION" ;
    ex:sectionSub "3.1.5 Questions:" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "Definitions are grouped depending on if they are changes in land cover, land use, or both. Additional discussions of the meaning of \"deforestation\" may be found in Sunderlin, William D.; Resosudarmo, Ida Aju Pradnja. Rate and Causes of Deforestation in Indonesia: Towards a Resolution of the Ambiguities"@en .

ex:Def_def_ind_unknown_257 a ex:Definition ;
    rdfs:label "Forests include all lands classed as forest under any legal enactment dealing wi..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Forests include all lands classed as forest under any legal enactment dealing with forests or administered as forests, whether state owned or private, & whether wooded or maintained as potential forest land. The area of crops raised in the forests & grazing lands or the area open for grazing within the forests should remain included under the forest area"@en .

ex:Def_def_ind_unknown_258 a ex:Definition ;
    rdfs:label "In India, the Recorded Forest Area is defined as \"all lands statutorily notified..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "In India, the Recorded Forest Area is defined as \"all lands statutorily notified as forest though they may not necessarily bear tree cover\". T P Singh tpsingh@teri.res.in"@en .

ex:Def_def_ind_unknown_526 a ex:Definition ;
    rdfs:label "Forest cover - All lands, more than one hectare in area, with a tree canopy dens..." ;
    ex:appliesTo ex:Country_India ;
