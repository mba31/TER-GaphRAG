ex:Def_def_per_2014_657 a ex:Definition ;
    rdfs:label "Activity data used for constructing the proposed FREL is based on the following ..." ;
    ex:appliesTo ex:Country_Peru ;
    ex:country "Peru" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_per_2014_657_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Activity data used for constructing the proposed FREL is based on the following definition of \"forest\" of the National Forest Inventory (MINAM and MINAGRI, 2014.a) taking the minimum area to the technological requirements of a methodology: • Minimum Mapping Unit: 1 Landsat pixel (0.09 hectares); • Minimum tree height at maturity in situ: 5.00 . The Ministry of the Environment chose the third definition for REDD+ reporting purposes taking into consideration the scale of land-use change in the Amazon and the technical specifications of the activity data processing chain. This definition captures the spatiotemporal patterns of predominantly smaller deforestation events. Moreover, the definition is compatible with the forest definition applied in the National Forest Inventory which requires a larger minimum forest area to accommodate the inventory clusters. Both forest definitions, the one used in the NFI and the definition used to provide activity data on deforestation, are used in the National GHG Inventories 2010 (submitted as part of the BUR in 2014) and 2012 submitted within the Third National Communication in 2015. The Government of Peru will harmonize its forest definitions, once new remote sensing technologies provide the data and means to accurately capture land-use changes dynamics across different biomes"@en .

ex:Def_def_per_2014_657_criteria ex:minArea "0.09"^^xsd:float ;
    ex:minAreaSI "0.09"^^xsd:float .

ex:Def_def_per_2015_658 a ex:Definition ;
    rdfs:label "Currently being implemented, the National Forest Inventory applies specific fore..." ;
    ex:appliesTo ex:Country_Peru ;
    ex:country "Peru" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_per_2015_658_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Currently being implemented, the National Forest Inventory applies specific forest definitions for the three biomes Costa, Sierra, and the Amazon. In case of the Amazon, the following parameters are used: • Minimum area: 0.50 hectares; • Minimum width: 20.00 m • Minimum tree height at maturity in situ: 5.00 m; • Minimum crown cover: 10%"@en .

ex:Def_def_per_2015_658_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "20.0"^^xsd:float ;
    ex:minWidth "20.0"^^xsd:float ;
    ex:minWidthSI "20.0"^^xsd:float .

ex:Def_def_per_2015_659 a ex:Definition ;
    rdfs:label "The Peruvian Designated National Authority (DNA) of the Clean Development Mechan..." ;
    ex:appliesTo ex:Country_Peru ;
    ex:country "Peru" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_per_2015_659_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "The Peruvian Designated National Authority (DNA) of the Clean Development Mechanism (CDM) reported to the UNFCCC the following definition of “forest”, which is used in the context of afforestation and reforestation project activities under the CDM. • Minimum area: 0.50 hectares; • Minimum tree height at maturity in situ: 5.00 m; • Minimum crown cover: 30%"@en .

