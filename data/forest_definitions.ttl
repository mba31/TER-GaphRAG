    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Law defines ‘communal forest’ as “A small described forest area immediately adjacent to one or more villages to be used exclusively by the local inhabitants and shall not be used for any commercial purposes.”"@en .

ex:Def_def_uk_unknown_278 a ex:Definition ;
    rdfs:label "The Act creating a Protected Forest Area System in Liberia defines communal fore..." ;
