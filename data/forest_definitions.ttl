ex:Def_def_bol_2002_1002 a ex:Definition ;
    rdfs:label "(Bolivia 2002) By principal land use: in Bolivia, forest land refers to areas co..." ;
    ex:appliesTo ex:Country_Bolivia ;
    ex:country "Bolivia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "(Bolivia 2002) By principal land use: in Bolivia, forest land refers to areas covered with natural forest, cultivated, intended for various uses, and also treeless lands which may be reforested. Meadows and pasture, with scattered trees or shrubs, do not constitute forest lands. http://www.fao.org/docrep/005/y2328e/y2328e03.htm"@en .

