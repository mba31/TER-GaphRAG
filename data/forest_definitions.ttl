ex:Def_def_kyr_2000_1711 a ex:Definition ;
    rdfs:label "(Kyrgyzstan 2000) Forest in strict sense (conifer/broadleaf/mixed - see definiti..." ;
    ex:appliesTo ex:Country_Kyrgyzstan ;
    ex:country "Kyrgyzstan" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_kyr_2000_1711_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Kyrgyzstan 2000) Forest in strict sense (conifer/broadleaf/mixed - see definitions at 3.3) is defined as vegetation consisting of forest species (according to the species list in annex 2) with the objective of timber production and various protection and other functions. The horizontal forest area has a minimum crown cover density of 20 % (see Figure 2-4, Figure 2-5 and Figure 2-6), a minimum width of 25 metres and a minimum height of 2.0 metres. In case of forest cultures no minimum height has to be considered. http://kirfor.ucentralasia.org/bitcache/833d526f022370574cea70a841a6474fef581009?vid=610&disposition=attachment&op=download"@en .

ex:Def_def_kyr_2000_1711_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float ;
    ex:minHeight "25.0"^^xsd:float ;
    ex:minHeightSI "25.0"^^xsd:float ;
    ex:minWidth "25.0"^^xsd:float ;
    ex:minWidthSI "25.0"^^xsd:float .

