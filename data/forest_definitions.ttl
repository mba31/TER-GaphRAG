ex:Def_def_col_2014_1005 a ex:Definition ;
    rdfs:label "(Colombia 2014) For the purposes of the National REDD + Strategy (ENREDD +), and..." ;
    ex:appliesTo ex:Country_Colombia ;
    ex:country "Colombia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_col_2014_1005_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    skos:note "(Colombia 2014) For the purposes of the National REDD + Strategy (ENREDD +), and in particular for the construction of this FREL, forest is defined as: Land mainly covered by trees which might contain shrubs, palms, guaduas, grass and vines, in which tree cover predominates with a minimum canopy density of 30%, a minimum canopy height (in situ) of 5 meters at the time of identification , and a minimum area of 1.0 ha. Commercial forest plantations, palm crops and planted trees for agricultural production are excluded. In this frame, the minimum mapping unit used for the FREL is 1.0 ha. http://redd.unfccc.int/files/20.10.15col__frel_english_clean_numbers.pdf"@en .

ex:Def_def_col_2014_1005_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "1.0"^^xsd:float ;
    ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

