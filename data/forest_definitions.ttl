    ex:hasSource ex:Source_USA-STATE-Hawaii ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A unit of vegetation dominated by trees whose crowns generally are not touching. Plant communities with trees having a crown cover of 25 to 60 percent are considered woodlands"@en .

ex:Def_def_usa_unknown_1478_criteria ex:minCanopyCover "60.0"^^xsd:float ;
    ex:minCanopyCoverSI "60.0"^^xsd:float .

ex:Def_def_usa_unknown_1480 a ex:Definition ;
