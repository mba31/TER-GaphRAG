    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2001_155 a ex:Definition ;
    rdfs:label "(from the Marrakesh Accords of the Kyoto Protocol): An area of land: that is at ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2001_155_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "(from the Marrakesh Accords of the Kyoto Protocol): An area of land: that is at least 0.05 – 1.0 hectares in size; which has more than 10-30 per cent of tree crown cover (or equivalent stocking levels); and which has trees that have the potential to reach a minimum height at maturity in situ of 2-5 metres. It may consist either of closed forest formations or open forest. Closed forest formations involve to a high proportion of the ground being covered by trees of various storeys and undergrowth"@en .

