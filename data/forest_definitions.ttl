ex:Def_def_slo_unknown_143 a ex:Definition ;
    rdfs:label "(Slovakia) Forest includes forest stands with its environment and other areas de..." ;
    ex:appliesTo ex:Country_Slovakia ;
    ex:country "Slovakia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_slo_unknown_143_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Slovakia) Forest includes forest stands with its environment and other areas designated for the fulfillment of forest functions. Forest stand means tree and shrub species which, in their environment, fulfill forest functions. No area limit, classification into forest and non-forest according to the cadastre; limit of 0.01 ha in the Guidelines for forest managm. planning. http://www.fris.sk/Phare/Projects/ManagementOfForestInEurope/PDF/annex2.pdf"@en .

ex:Def_def_slo_unknown_143_criteria ex:minArea "0.01"^^xsd:float ;
    ex:minAreaSI "0.01"^^xsd:float .

