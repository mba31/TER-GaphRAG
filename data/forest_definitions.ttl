    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest - A plant community predominantly of trees and other woody vegetation, usually with a closed canopy. Definition adopted from the British Commonwealth Forest Terminology Part-I, 1953. Source: Mumtaz Ahmad, Section Forest Officer, Pakistan Min. of Environment, Local Government, and Rural Development"@en .

ex:Def_def_pak_1953_930 a ex:Definition ;
    rdfs:label "Forest - An area set aside for the production of timber and other forest produce..." ;
    ex:appliesTo ex:Country_Pakistan ;
    ex:country "Pakistan" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Mumtaz_Ahmad_Section_Forest_Officer_Pakistan_Min ;
