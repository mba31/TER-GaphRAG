ex:Def_def_cze_unknown_843 a ex:Definition ;
    rdfs:label "definition of forest is given by law: \"Forest land is land destined to fulfil th..." ;
    ex:appliesTo ex:Country_Czech_Republic ;
    ex:country "Czech Republic" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
