ex:Def_def_ind_2004_1475 a ex:Definition ;
    rdfs:label "(Indonesia 2004) As a formal right, forest in this document is defined as “Land ..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_ind_2004_1475_criteria ;
    ex:hasSource ex:Source_UNFCCC ;
    skos:note "(Indonesia 2004) As a formal right, forest in this document is defined as “Land spanning more than 0.25 hectares with trees higher than 5 meters at maturity and a canopy cover of more than 30 percent, or trees able to reach these thresholds in situ”. This is the definition of forest stated in the Minister of Forestry Decree No 14/2004 on A/R CDM (MoFor, 2004). The definition of forest used in the MoFor decree was established to meet the requirement of climate change mitigation scheme under CDM and thus relevant to be used in FREL construction. This definition was used by the Ministry of Forestry for the purpose of ground-truthing in order to support satellite image classification. http://redd.unfccc.int/files/national_frel_for_redd__in_indonesia_2015.pdf"@en .

ex:Def_def_ind_2004_1475_criteria ex:minArea "0.25"^^xsd:float ;
    ex:minAreaSI "0.25"^^xsd:float ;
    ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
