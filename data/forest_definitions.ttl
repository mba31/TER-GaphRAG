    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "“Forest” is a minimum area of land of 0.05-1.0 hectares with tree crown cover (or equivalent stocking level) of more than 10-30 per cent with trees with the potential to reach a minimum height of 2-5 metres at maturity in situ. A forest may consist either of closed forest formations where trees of various storeys and undergrowth cover a high proportion of the ground or open forest. Young natural stands and all plantations which have yet to reach a crown density of 10-30 per cent or tree height of 2-5 metres are included under forest, as are areas normally forming part of the forest area which are temporarily unstocked as a result of human intervention such as harvesting or natural causes but which are expected to revert to forest. (From Marrakesh Accords) and. ftp://ftp.fao.org/docrep/fao/009/j9345e/j9345e00.pdf"@en .

ex:Def_def_unk_2001_214_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "1.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2001_283 a ex:Definition ;
    rdfs:label "“Classified forest” means a forest reserve, a community forest or a forest manag..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "“Classified forest” means a forest reserve, a community forest or a forest management area"@en .

ex:Def_def_unk_2001_73 a ex:Definition ;
    rdfs:label "(2001) A forest is considered an area with at least 10 per cent tree canopy cove..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "(2001) A forest is considered an area with at least 10 per cent tree canopy cover"@en .

ex:Def_def_unk_2002_131 a ex:Definition ;
    rdfs:label "A land area of more than 0.5 ha, with a tree canopy cover of more than 10 percen..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2002_131_criteria ;
    ex:hasSource ex:Source_UNEP ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "A land area of more than 0.5 ha, with a tree canopy cover of more than 10 percent, which is not primarily under agriculture or other specific non-forest land use. In the case of young forest or regions where tree growth is climatically suppressed, the trees should be capable of reaching a height of 5 m in situ, and of meeting the canopy cover requirement"@en .

ex:Def_def_unk_2002_131_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2002_1404 a ex:Definition ;
    rdfs:label "Trees growing outside the forest and not belonging to the category of forests, f..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Trees growing outside the forest and not belonging to the category of forests, forest lands, or other wooded land. According to this definition, Trees outside forests are located on \"other land\", such as agricultural land, built-up areas such as settlements and infrastructure, and bare land (dunes, former mining areas, etc.). (Bellefontaine, Ronald et al. 2002. Trees outside forests - Towards a better awareness. FAO Conservation Giude 35"@en .

ex:Def_def_unk_2002_17 a ex:Definition ;
    rdfs:label "Land cover classification - A process of stratification and systematic grouping ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "Land cover classification - A process of stratification and systematic grouping of land cover into multi-level, mutually exclusive classes according to selected criteria. It is independent of map scale, data source and geographic area. (Kalensky et al. 2002)"@en .

ex:Def_def_unk_2002_179 a ex:Definition ;
    rdfs:label "A land area with a minimum 10% tree crown coverage (or equivalent stocking level..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2002_179_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "A land area with a minimum 10% tree crown coverage (or equivalent stocking level), or formerly having such tree cover and that is being naturally or artificially regenerated or that is being afforested"@en .

ex:Def_def_unk_2002_179_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_unk_2002_18 a ex:Definition ;
    rdfs:label "Land cover map legend - A subset of land cover classes compatible with the map s..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "Land cover map legend - A subset of land cover classes compatible with the map scale, map type (forest map, forest change map, agricultural land map, land degradation map, etc.) and map accuracy requirements. Furthermore, the map legend is specific to a geographic area of the map. (Kalensky et al. 2002)"@en .

ex:Def_def_unk_2002_429 a ex:Definition ;
    rdfs:label "Old definition: Forest Land with tree crown cover of more that 10 % and area of ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2002_429_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Old definition: Forest Land with tree crown cover of more that 10 % and area of more than 1 ha. Cyprus Department of forests ministry of agriculture, natural resources and environment, 2006. Kyriacou K. 2002"@en .

ex:Def_def_unk_2002_429_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "1.0"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_unk_2002_540 a ex:Definition ;
    rdfs:label "There are no legal definitions for the terms forest and forestry in Ireland. A p..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2002_540_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "There are no legal definitions for the terms forest and forestry in Ireland. A practical definition for forest is an area of at least 0.5 ha (sometimes, in the case of broadleaves, 0.2 ha) with a minimum width of 40 m over no more than two-thirds of its length, with at least 50% canopy cover by trees"@en .

ex:Def_def_unk_2002_540_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "50.0"^^xsd:float ;
    ex:minCanopyCoverSI "50.0"^^xsd:float ;
    ex:minHeight "40.0"^^xsd:float ;
    ex:minHeightSI "40.0"^^xsd:float ;
    ex:minWidth "40.0"^^xsd:float ;
    ex:minWidthSI "40.0"^^xsd:float .

ex:Def_def_unk_2002_839 a ex:Definition ;
    rdfs:label "It corresponds to FRA definition except the threshold value for minimum area, wh..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2002_839_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "It corresponds to FRA definition except the threshold value for minimum area, which is 1 ha, with trees higher than 5 m and a crown cover of more than 10%, or trees able to reach these thresholds in situ. Land predominantly under agricultural or urban use not included. Old definition: Forest Land with tree crown cover of more that 10 % and area of more than 1 ha. Cyprus Department of forests ministry of agriculture, natural resources and environment, 2006. Kyriacou K. 2002"@en .

ex:Def_def_unk_2002_839_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "1.0"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2003_115 a ex:Definition ;
    rdfs:label "A vegetation type dominated by trees. Many definitions of the term forest are in..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_IPCC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "A vegetation type dominated by trees. Many definitions of the term forest are in use throughout the world, reflecting wide differences in bio-geophysical conditions, social structure, and economics. For a discussion of the term forest )"@en .

ex:Def_def_unk_2003_117 a ex:Definition ;
    rdfs:label "An area of land tree crown cover more than ten per cent with the potential to re..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "An area of land tree crown cover more than ten per cent with the potential to reach a minimum height of two meters at maturity in situ. ISO TC207/WG5 N70 ISO/WD 14064-1.1 Secretariat: DSM/CSA. January 13, 2003. Principles and requirements for measuring, monitoring and reporting entity- and project-level greenhouse gas emissions and/or removals. 30 p"@en .

ex:Def_def_unk_2003_1405 a ex:Definition ;
    rdfs:label "Trees on land not defined as forest and other wooded land. Includes: trees on la..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_2003_1405_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Trees on land not defined as forest and other wooded land. Includes: trees on land that fulfils the requirements of forest and other wooded land except that the area is less than 0.5 ha; trees able to reach a height of at least 5 m at maturity in situ where the stocking level is below 5 percent; trees not able to reach a height of 5 m at maturity in situ where the stocking level is below 20 percent; scattered trees in permanent meadows and pastures; permanent tree crops such as fruit-trees and coconuts; trees in parks and gardens, around buildings and in lines along streets, roads, railways, rivers, streams and canals; trees in shelterbelts of less than 20 m width and 0.5 ha area (Rawat, J.K. et al. 2003. Training Manual on Inventory of Trees Outside Forests (TOF). FAO FAO. 2001. Global forest resources assessment 2000. Main report. Food and Agriculture Organization of the United Nations, Rome. )"@en .

ex:Def_def_unk_2003_1405_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float ;
    ex:minWidth "2000.0"^^xsd:float ;
    ex:minWidthSI "2000.0"^^xsd:float .

ex:Def_def_unk_2003_145 a ex:Definition ;
    rdfs:label "Forest land is defined as having more than 10 percent crown cover and an area of..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2003_145_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Forest land is defined as having more than 10 percent crown cover and an area of more than 0.5 ha, and excludes land predominantly used for agriculture"@en .

ex:Def_def_unk_2003_145_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float .

ex:Def_def_unk_2003_1577 a ex:Definition ;
    rdfs:label "Planting of new forests on lands that historically have not contained forests" ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_UNEP ;
    ex:sectionMain "2.14 STAND" ;
    ex:sectionSub "3.1.2 Land Cover" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "Planting of new forests on lands that historically have not contained forests"@en .

ex:Def_def_unk_2003_167 a ex:Definition ;
    rdfs:label "include all areas dominated by evergreen or deciduous trees with a canopy cover ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2003_167_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "include all areas dominated by evergreen or deciduous trees with a canopy cover of greater than 60% and a height exceeding 2 meters. Both broadleaf and needleleaf trees are included"@en .

ex:Def_def_unk_2003_167_criteria ex:minCanopyCover "60.0"^^xsd:float ;
    ex:minCanopyCoverSI "60.0"^^xsd:float ;
    ex:minHeight "2.0"^^xsd:float ;
    ex:minHeightSI "2.0"^^xsd:float .

ex:Def_def_unk_2003_211 a ex:Definition ;
    rdfs:label "Land under forestry or no land use, spanning more than 0.5 hectares; with trees ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2003_211_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "Land under forestry or no land use, spanning more than 0.5 hectares; with trees higher than 5 meters and a canopy cover of more than 10 percent, or trees able to reach these thresholds in situ. NOTE: Forests are determined both by the presence of trees and the absence of other predominant land uses. The trees should be able to reach a minimum height of 5 meters in situ. Areas under reforestation which have yet to reach a crown density of 10 percent or tree height of 5 meters are included, as are temporarily unstocked areas, resulting from human intervention or natural causes that are expected to regenerate. The term specifically includes forest roads, firebreaks and other small open areas; forest in national parks, nature reserves and other protected areas such as those of specific scientific, historical, cultural or spiritual interest; windbreaks, shelterbelts and corridors of trees with an area of more than 0.5 hectare and width of more than 20 meters; plantations primarily used for forestry purposes, including rubberwood plantations and cork oak stands. The term specifically excludes tree stands used in agricultural production systems, for example in fruit plantations and agroforestry systems. The term also excludes trees in urban parks and gardens. (Source: Smith, W.B. 2003. Thoughts to simplify FRA Core Data Attributes and Definitions. 8 p. USDA Forest Service, Washington, DC.)"@en .

ex:Def_def_unk_2003_211_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float ;
    ex:minWidth "20.0"^^xsd:float ;
    ex:minWidthSI "20.0"^^xsd:float .

ex:Def_def_unk_2003_23 a ex:Definition ;
    rdfs:label "The total of arrangements, activities and inputs undertaken (a set of human acti..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_IPCC ;
    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "The total of arrangements, activities and inputs undertaken (a set of human actions) in a certain land cover type. The term “land use” is also used in the sense of the social and economic purposes for which land is managed (e.g., grazing, timber extraction, and conservation). (Source: Second Order Draft Glossary IPCC WGI Fourth Assessment Rept"@en .

ex:Def_def_unk_2003_300 a ex:Definition ;
    rdfs:label "“Forest Reserve” means any area set aside in accordance with the provisions of S..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "“Forest Reserve” means any area set aside in accordance with the provisions of Section 16 of this Act, for the purpose of Conservation, Protection and management of natural forests, its habitat and Environment and in which tree cutting and certain other activities of forest or its habitat and Environment are prohibited or controlled in accordance with the provisions of Sections 17, and 20 of this Act. Wildlife Conservation Act of 2003"@en .

ex:Def_def_unk_2003_443 a ex:Definition ;
    rdfs:label "Forests include all areas dominated by evergreen or deciduous trees with a canop..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2003_443_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forests include all areas dominated by evergreen or deciduous trees with a canopy cover of greater than 60% and a height exceeding 2 meters. Both broadleaf and needleleaf trees are included"@en .

ex:Def_def_unk_2003_443_criteria ex:minCanopyCover "60.0"^^xsd:float ;
    ex:minCanopyCoverSI "60.0"^^xsd:float ;
    ex:minHeight "2.0"^^xsd:float ;
    ex:minHeightSI "2.0"^^xsd:float .

ex:Def_def_unk_2003_589 a ex:Definition ;
    rdfs:label "Land with tree crown cover (or equivalent stocking level) of more than 10% and a..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2003_589_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Land with tree crown cover (or equivalent stocking level) of more than 10% and area of more than 0.5 ha. The trees should be able to reach a minimum height of 5 m at maturity in situ. Le gouvernement du Grand Duchè du Luxembourg, 2003"@en .

ex:Def_def_unk_2003_589_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2003_916 a ex:Definition ;
    rdfs:label "Forest area is land under natural or planted stands of trees of at least 5 m in ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2003_916_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest area is land under natural or planted stands of trees of at least 5 m in situ, whether productive or not, and excludes tree stands in agricultural production systems (for example, in fruit plantations and agroforestry systems) and trees in urban parks and gardens. EarthTrends, 2003"@en .

ex:Def_def_unk_2003_916_criteria ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2004_1460 a ex:Definition ;
    rdfs:label "Other wooded land - Land not classified as Forest, spanning more than 0.5 hectar..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_2004_1460_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Other wooded land - Land not classified as Forest, spanning more than 0.5 hectares; with trees higher than 5 meters and a canopy cover of 5-10 percent, or trees able to reach these thresholds in situ; or with a combined cover of shrubs, bushes and trees above 10 percent. It does not include land that is predominantly under agricultural or urban land use. and"@en .

ex:Def_def_unk_2004_1460_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2004_1583 a ex:Definition ;
    rdfs:label "The establishment of forest on land that has been without forest for a period of..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_World_Agroforestry ;
    ex:sectionMain "2.14 STAND" ;
    ex:sectionSub "3.1.2 Land Cover" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "The establishment of forest on land that has been without forest for a period of time and was previously under a different land-use"@en .

ex:Def_def_unk_2004_159 a ex:Definition ;
    rdfs:label "An ecosystem in which the dominant plants are trees covering a vast tract of lan..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_World_Agroforestry ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "An ecosystem in which the dominant plants are trees covering a vast tract of land"@en .

ex:Def_def_unk_2004_1643 a ex:Definition ;
    rdfs:label "The conversion of forest to another land use or the long-term reduction of the t..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_2004_1643_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "3.2 DEFORESTATION" ;
    ex:sectionSub "3.2.4 As a change in land cover and use" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "The conversion of forest to another land use or the long-term reduction of the tree canopy cover below the minimum 10 percent threshold. Explanatory notes: 1. Deforestation implies the long-term or permanent loss of forest cover and implies transformation into another land use. Such a loss can only be caused and maintained by a continued human-induced or natural perturbation. 2. Deforestation includes areas of forest converted to agriculture, pasture, water reservoirs and urban areas. 3. The term specifically excludes areas where the trees have been removed as a result of harvesting or logging, and where the forest is expected to regenerate naturally or with the aid of silvicultural measures. Unless logging is followed by the clearing of the remaining logged-over forest for the introduction of alternative land uses, or the maintenance of the clearings through continued disturbance, forests commonly regenerate, although often to a different, secondary condition. In areas of shifting agriculture, forest, forest fallow and agricultural lands appear in a dynamic pattern where deforestation and the return of forest occur frequently in small patches. To simplify reporting of such areas, the net change over a larger area is typically used. 4. Deforestation also includes areas where, for example, the impact of disturbance, overutilization or changing environmental conditions affects the forest to an extent that it cannot sustain a tree cover above the 10 percent threshold"@en .

ex:Def_def_unk_2004_1643_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_unk_2004_1694 a ex:Definition ;
    rdfs:label "The establishment of forest on land previously under a forest land-use" ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_World_Agroforestry ;
    ex:sectionMain "3.4 FORESTATION" ;
    ex:sectionSub "3.5.1 Restoration of Land Cover" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "The establishment of forest on land previously under a forest land-use"@en .

ex:Def_def_unk_2004_199 a ex:Definition ;
    rdfs:label "Land spanning more than 0.5 hectares with trees higher than 5 meters and a canop..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2004_199_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "Land spanning more than 0.5 hectares with trees higher than 5 meters and a canopy cover of more than 10 percent, or trees able to reach these thresholds in situ. It does not include land that is predominantly under agricultural or urban land use. Explanatory notes: 1. Forest is determined both by the presence of trees and the absence of other predominant land uses. The trees should be able to reach a minimum height of 5 meters in situ. Areas under reforestation that have not yet reached but are expected to reach a canopy cover of 10 percent and a tree height of 5 m are included, as are temporarily unstocked areas, resulting from human intervention or natural causes, which are expected to regenerate. 2. Includes areas with bamboo and palms provided that height and canopy cover criteria are met. 3. Includes forest roads, firebreaks and other small open areas; forest in national parks, nature reserves and other protected areas such as those of specific scientific, historical, cultural or spiritual interest. 4. Includes windbreaks, shelterbelts and corridors of trees with an area of more than 0.5 ha and width of more than 20 m. 5. Includes plantations primarily used for forestry or protection purposes, such as rubberwood plantations and cork oak stands. 6. Excludes tree stands in agricultural production systems, for example in fruit plantations and agroforestry systems. The term also excludes trees in urban parks and gardens"@en .

ex:Def_def_unk_2004_199_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float ;
    ex:minWidth "20.0"^^xsd:float ;
    ex:minWidthSI "20.0"^^xsd:float .

