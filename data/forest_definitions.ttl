ex:Def_def_uga_2017_1451 a ex:Definition ;
    rdfs:label "Wooded areas where trees and shrubs are predominant. There are wet and dry types..." ;
    ex:appliesTo ex:Country_Uganda ;
    ex:country "Uganda" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_uga_2017_1451_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Wooded areas where trees and shrubs are predominant. There are wet and dry types. The wet type occurs as a zone along wetlands (riverine forest) and the dry type is found on grass-covered upland areas. To qualify as woodland the average height of the trees must exceed 4 m.” Woodland can be categorized as closed or open woodland according to its canopy cover. Closed woodland has a canopy cover > 40 percent and open woodland has a canopy cover of 10–40 percent"@en .

