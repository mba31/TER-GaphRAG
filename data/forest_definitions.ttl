    ex:minCanopyCoverSI "70.0"^^xsd:float .

ex:Def_def_sou_1998_699 a ex:Definition ;
    rdfs:label "Forest is defined as more than two trees whose canopies touch. 1998 Forest Act" ;
    ex:appliesTo ex:Country_South_Africa ;
    ex:country "South Africa" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:region "Africa" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest is defined as more than two trees whose canopies touch. 1998 Forest Act"@en .

ex:Def_def_sou_1998_700 a ex:Definition ;
    rdfs:label "Forested (wetland) A class is characterised by woody vegetation that is taller t..." ;
    ex:appliesTo ex:Country_South_Africa ;
    ex:country "South Africa" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_sou_1998_700_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:region "Africa" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forested (wetland) A class is characterised by woody vegetation that is taller than 6 m. These habitats normally possess an overstorey of trees, an understorey of young trees or shrubs, and a herbaceous layer. South African National Wetland Inventory . Proposed wetland classification system for South Africa . J. Dini, G. Cowan & P. Goodman. FIRST DRAFT. August 1998"@en .

ex:Def_def_sou_1998_700_criteria ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "6.0"^^xsd:float .

ex:Def_def_sou_1998_956 a ex:Definition ;
    rdfs:label "In terms of the National Forests Act, 1998, forests include all natural forests,..." ;
    ex:appliesTo ex:Country_South_Africa ;
    ex:country "South Africa" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:region "Africa" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "In terms of the National Forests Act, 1998, forests include all natural forests, woodlands and plantations as well as the forest produce produced in it. In keeping with this definition, reference in this paper to forestry development and forest activities includes the use of these three categories of forest resources, as well as the primary processing of all timber, nontimber and non-wood forest products derived from these sources"@en .

ex:Def_def_sou_1999_701 a ex:Definition ;
    rdfs:label "Forest is a continuous stand of trees at least 10m tall, with their crowns inter..." ;
    ex:appliesTo ex:Country_South_Africa ;
    ex:country "South Africa" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_sou_1999_701_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:region "Africa" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest is a continuous stand of trees at least 10m tall, with their crowns interlocking. It is generally multi-layered vegetation unit dominated by trees (largely evergreen or semi-deciduous) whose combined strata have overlapping crowns (i.e. crown cover is > 75 percent). (Bailey, et.al., 1999)"@en .

ex:Def_def_sou_1999_701_criteria ex:minCanopyCover "75.0"^^xsd:float ;
    ex:minCanopyCoverSI "75.0"^^xsd:float ;
    ex:minHeight "10.0"^^xsd:float ;
    ex:minHeightSI "10.0"^^xsd:float .

ex:Def_def_sou_2002_702 a ex:Definition ;
    rdfs:label "Indigenous forest is defined as \"a generally multilayered vegetation unit domina..." ;
    ex:appliesTo ex:Country_South_Africa ;
    ex:country "South Africa" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_sou_2002_702_criteria ;
