ex:Def_def_aus_1999_1208 a ex:Definition ;
    rdfs:label "(Australia) Wooded Land - Land with vegetation with a projected foliage cover of..." ;
    ex:appliesTo ex:Country_Australia ;
    ex:country "Australia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_aus_1999_1208_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Australia) Wooded Land - Land with vegetation with a projected foliage cover of less than 10% (this is equivalent to a crown cover of 0.25 to 20%) and included Tall, Medium and Low Trees (>30, 10-30 and <10 m respectively) and Tall Shrubs (>2 m). The Tall Shrubs category excludes eucalypts as these are included under 'forest' as Mallees.\" Karol.Andrzejewski@affa.gov.au NFI (1999) definition of Other Wooded land."@en .

