    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest is defined as areas dominated by trees having usually a single stem and a mature or potentially mature stand height exceeding 5 metres, and with existing or potential projective cover of overstorey strata about equal to or greater than 30 per cent; while woodland is similarly defined but with a projective cover of overstorey strata of less than 30 per cent"@en .

ex:Def_def_aus_1996_344_criteria ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

