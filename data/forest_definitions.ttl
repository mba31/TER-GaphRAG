    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Land that has at least 50% canopy cover qualifies as woodland for purposes of assessment. The amount of canopy cover usually is measured from aerial photographs"@en .

ex:Def_def_usa_unknown_1480_criteria ex:minCanopyCover "50.0"^^xsd:float ;
    ex:minCanopyCoverSI "50.0"^^xsd:float .

ex:Def_def_usa_unknown_1483 a ex:Definition ;
    rdfs:label "Woodland forest is a transition zone between prairie and bottomland. It is domin..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oklahoma-Norman_City ;
