ex:Def_def_gre_unknown_1471 a ex:Definition ;
    rdfs:label "(Greece) Forest is defined as land with tree crown cover (stand density) of more..." ;
    ex:appliesTo ex:Country_Greece ;
    ex:country "Greece" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_gre_unknown_1471_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Greece) Forest is defined as land with tree crown cover (stand density) of more than about 20% of the area, and with trees which usually grow to more than about 7 m in height and are able to produce wood. This includes both, closed forest formations where trees of various storeys and undergrowth cover a high proportion of the ground, and open forest formations with a continuous grass layer in which tree synusia cover at least 10% of the ground. http://www.lasy.gov.pl/dokumenty/in_english/files/forest_and_forestry_in_eu-pdf/at_download/file"@en .

ex:Def_def_gre_unknown_1471_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float ;
    ex:minHeight "7.0"^^xsd:float ;
    ex:minHeightSI "7.0"^^xsd:float .

