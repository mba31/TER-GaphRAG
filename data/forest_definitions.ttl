ex:Def_def_unk_2005_200 a ex:Definition ;
    rdfs:label "Forest land is land not classified as mainly “agricultural land” and is land wit..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2005_200_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "Forest land is land not classified as mainly “agricultural land” and is land with crown cover of more than 10 percent of trees able to reach a mature height of 5 metres or more. It includes natural and plantation forests. Areas that are temporarily not under trees but are expected to revert to forest are included. Forest tree nurseries that form an integral part of the forest should be included"@en .

