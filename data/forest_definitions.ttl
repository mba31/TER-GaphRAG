ex:Def_def_ind_2003_1114 a ex:Definition ;
    rdfs:label "(INDIA-Kerala 2003) “forest” means any land principally covered with naturally g..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(INDIA-Kerala 2003) “forest” means any land principally covered with naturally grown trees and under growth and includes any forest statutorily recognized and declared as reserved forest, protected forest or otherwise, but does not include any land which is used principally for the cultivation of crops of long duration such as tea, coffee, rubber, pepper, cardamom, coconut, arecanut or cashew or any other sites of residential buildings and surroundings essential for the convenient use of such buildings; http://www.kerenvis.nic.in/legislation/Microsoft%20Word%20-%20Act2003.pdf"@en .

