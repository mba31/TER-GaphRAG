    rdfs:label "(Indonesia 2000) \"Forest means a unit of ecosystem….comprising biological resour..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Indonesia 2000) \"Forest means a unit of ecosystem….comprising biological resources, dominated by trees in their natural forms and environment….\". Indonesia. http://www.fire.uni-freiburg.de/iffn/country/id/id_25.htm"@en .

