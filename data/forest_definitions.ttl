ex:Def_def_alb_unknown_332 a ex:Definition ;
    rdfs:label "‘Forest’ is defined as dense woodland with a surface larger than 1000 m2 with a ..." ;
    ex:appliesTo ex:Country_Albania ;
    ex:country "Albania" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
