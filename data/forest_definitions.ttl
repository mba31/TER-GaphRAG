    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest means any land under forest which no person has acquired a permanent heritable and transferable right of use and occupancy"@en .

ex:Def_def_unk_1970_717 a ex:Definition ;
    rdfs:label "forests and woodlands as ‘any area of vegetation dominated by trees of any size’" ;
