ex:Def_def_rom_unknown_674 a ex:Definition ;
    rdfs:label "According to the definition given in our “Forest Code”, forest is considered lan..." ;
    ex:appliesTo ex:Country_Romania ;
    ex:country "Romania" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_rom_unknown_674_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "According to the definition given in our “Forest Code”, forest is considered land covered by forest vegetation with an area of more than 0.25 ha. In order to approximate the TBFRA definition of the forest, the item “Forest” includes lands needed for culture (nurseries, orchards...), for production (game food...), for administration (forest roads, fire breaks...) and temporarily excluded from the “forest fund”. These are separately recorded in our statistics and in addition to forest area make “forest fund"@en .

