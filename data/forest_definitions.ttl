    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land at least 10.0 percent stocked by forest trees of any size, or land formerly having such tree cover, and is not currently developed for non-forest use. The minimum area for classification of forestland is 1 acre. Roadside, streamside, and shelterbelt strips of timber must have a width of at least 120 feet wide to qualify as forestland. Unimproved roads, and trails, streams and other bodies of water, or natural clearings in forested areas shall be classified as forest, if less than 120 feet in width or an acre in size. Grazed woodlands, reverting fields, and pastures that are not actively maintained are included if the above qualifications are satisfied. (Also see definitions of non-forest land, idle farmland and improved/maintained pasture.) Southern Region FIA manual 5/2000 – Terms not in National Manual"@en .

ex:Def_def_usa_2000_1187_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_2000_1265 a ex:Definition ;
    rdfs:label "Forestland is defined as lands with at least a stocking of 10% cover of live for..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2000_1265_criteria ;
    ex:hasSource ex:Source_USA-STATE-Virginia ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland is defined as lands with at least a stocking of 10% cover of live forest trees of any size, or formerly having such tree cover, and not currently developed for non-forest use. The minimum area for classification of forestland is usually 1 acre with a minimum width of 120 feet stem-to-stem. Forested strips must be at least 120 feet wide for a continuous length of at least 363 feet in order to meet the acre threshold. Unimproved roads and trails, and clearings in forest areas are classified as forest if less than 120 feet wide or smaller than 1 acre"@en .

ex:Def_def_usa_2000_1265_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_2000_1367 a ex:Definition ;
    rdfs:label "Tree – trees are greater than 5.0 inches diameter at breast height (DBH) and gre..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2000_1367_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Tree – trees are greater than 5.0 inches diameter at breast height (DBH) and greater than 20 feet tall dnrweb.dnr.state.md.us/download/education/wetlands.doc"@en .

ex:Def_def_usa_2000_1367_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "6.096"^^xsd:float .

ex:Def_def_usa_2000_995 a ex:Definition ;
    rdfs:label "A site type of “forestland” is assigned and described where a 25% overstory cano..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA-NRCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "A site type of “forestland” is assigned and described where a 25% overstory canopy of trees, as determined by crown perimeter-vertical projection, dominated this historic vegetation"@en .

ex:Def_def_usa_2001_1244 a ex:Definition ;
    rdfs:label "\"Forest land\" means land for which the primary purpose is the growing, managing ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Ohio ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land for which the primary purpose is the growing, managing and harvesting of a merchantable forest product of commercial species under accepted silvicultural systems through natural or artificial reforestation methods and for which there is an approved forest management plan. The forest land shall consist of a stand or stands of commercial species of forest trees which contain at least fifty square feet of basal area or at least three hundred stems per acre which shall be evenly distributed throughout the stand. and"@en .

ex:Def_def_usa_2001_1270 a ex:Definition ;
    rdfs:label "“Forest land\" means all land which is capable of supporting a merchantable stand..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "“Forest land\" means all land which is capable of supporting a merchantable stand of timber and is not being actively used for a use which is incompatible with timber growing. Forest land does not include agricultural land that is or was enrolled in the conservation reserve enhancement program by contract if such agricultural land was historically used for agricultural purposes and the landowner intends to continue to use the land for agricultural purposes in the future"@en .

ex:Def_def_usa_2001_795 a ex:Definition ;
    rdfs:label "The term forest means a concentration of trees and related vegetation in non-urb..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2001_795_criteria ;
    ex:hasSource ex:Source_USA-FED-EPA ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "The term forest means a concentration of trees and related vegetation in non-urban areas sparsely inhabited by and infrequently used by humans; characterized by natural terrain and drainage patterns"@en .

ex:Def_def_usa_2001_795_criteria ex:minHeight "14.0"^^xsd:float ;
    ex:minHeightSI "14.0"^^xsd:float .

ex:Def_def_usa_2001_988 a ex:Definition ;
    rdfs:label "Land that is at least 10 percent stocked by forest trees of any size, or land fo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2001_988_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land that is at least 10 percent stocked by forest trees of any size, or land formerly having such tree cover, and is not currently developed for a nonforest use. The minimum area for classification as forest land is one acre. Roadside, stream-side, and shelterbelt strips of timber must have a crown width at least 120 feet wide to qualify as forest land. Unimproved roads and trails, streams and other bodies of water, or natural clearings in forested areas shall be classified as forest, if less than 120 feet in width or an acre in size. Grazed woodlands, reverting fields, and pastures that are not actively maintained are included if the above qualifications are satisfied. (Also see definitions of nonforest land, idle farmland and improved/maintained pasture.) Forest land is divided into timberland, reserved timberland and woodland. SRS FIA Southern Research Station Field Guide; Version 1.5; January 8, 2001, Updated March 23, 2001; Based upon FIA National Core Field Guide, Version 1.5, January, 2001 and FIA National Manual v1.4"@en .

ex:Def_def_usa_2001_988_criteria ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_2002_1112 a ex:Definition ;
    rdfs:label "A forest is a complex interrelationship of soil, air, water, climate, trees, pla..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-California ;
    ex:region "California" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "A forest is a complex interrelationship of soil, air, water, climate, trees, plants, fish, wildlife, grazing animals, and people, together with their machines and structures"@en .

ex:Def_def_usa_2002_1148 a ex:Definition ;
    rdfs:label "This Level I category contains any lands covered by woody vegetation other than ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-New_Jersey ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "This Level I category contains any lands covered by woody vegetation other than wetlands. These areas are capable of producing timber and other wood products, and of supporting many kinds of outdoor recreation. Forestland is an important category environmentally, because it affects air quality, water quality, wildlife habitat, climate, and many other aspects of the ecology of an area. The Level II categories under Forestland are Deciduous; Coniferous; Mixed Deciduous-Coniferous; and Brushland"@en .

ex:Def_def_usa_2002_1165 a ex:Definition ;
    rdfs:label "Forest – vegetation dominated by trees (= 6m [20 ft] tall) producing a more or l..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2002_1165_criteria ;
    ex:hasSource ex:Source_USA-STATE-Virginia ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest – vegetation dominated by trees (= 6m [20 ft] tall) producing a more or less closed canopy, typically with 60-100% cover; some forests may temporarily have < 60% canopy cover following disturbances such as windthrow, disease, etc"@en .

ex:Def_def_usa_2002_1165_criteria ex:minCanopyCover "60.0"^^xsd:float ;
    ex:minCanopyCoverSI "60.0"^^xsd:float ;
    ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "6.0"^^xsd:float .

ex:Def_def_usa_2002_1232 a ex:Definition ;
    rdfs:label "“Forest” means a tract of land that is at least 10% stocked by trees of any size..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2002_1232_criteria ;
    ex:hasSource ex:Source_USA-STATE-Michigan ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "“Forest” means a tract of land that is at least 10% stocked by trees of any size, whether of commercial or noncommercial species, or formerly having tree cover and not currently developed for nonforest use, including woodlands, woodlots, windbreaks, and shelter belts"@en .

ex:Def_def_usa_2002_1232_criteria ex:minHeight "3.0"^^xsd:float ;
    ex:minHeightSI "3.0"^^xsd:float .

ex:Def_def_usa_2002_1281 a ex:Definition ;
    rdfs:label "‘‘Forest’’ means lands that support, or can support,’’ at least 10 percent tree ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-California ;
    ex:region "California" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "‘‘Forest’’ means lands that support, or can support,’’ at least 10 percent tree canopy cover and that allow for management of one or more forest resources including timber, fish and wildlife, biodiversity, water quality, recreation, aesthetics and other public benefits"@en .

ex:Def_def_usa_2002_996 a ex:Definition ;
    rdfs:label "A land cover/use category that is at least 10 percent stocked by single-stemmed ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2002_996_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-NRCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "A land cover/use category that is at least 10 percent stocked by single-stemmed woody species of any size that will be at least 4 meters (13 feet) tall at maturity. Also included is land bearing evidence of natural regeneration of tree cover (cutover forest or abandoned farmland) and not currently developed for non-forest use. Ten percent stocked, when viewed from a vertical direction is a canopy cover of leaves and branches of 25 percent or greater. The minirnum area is 0.40 ha (1.0 ac) and.width is 30.5 m (100 ft.) '(Perry et al 2005 and Natural Resources Conservation Service, 2002, ftp://ftp-fc.sc.egov.usda.gov/NCGC/products/nri/2004range/appendixd.pdf )"@en .

ex:Def_def_usa_2002_996_criteria ex:minArea "0.4"^^xsd:float ;
    ex:minAreaSI "0.4"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float ;
    ex:minWidth "30.5"^^xsd:float ;
    ex:minWidthSI "30.5"^^xsd:float .

ex:Def_def_usa_2003_1004 a ex:Definition ;
    rdfs:label "Land that is now, or is capable of becoming, at least 10 percent stocked with fo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BLM ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land that is now, or is capable of becoming, at least 10 percent stocked with forest trees, and that has been developed for nontimber use. Pinedale Resource Management Plan"@en .

ex:Def_def_usa_2003_1005 a ex:Definition ;
    rdfs:label "Those lands with 10 percent or greater stocking (or the potential to in tree spe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BLM ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Those lands with 10 percent or greater stocking (or the potential to in tree species which are typically used in commercially processed wood products (lumber, plywood, paper, etc.), such as ponderosa pine, lodgepole pine, Douglas-fir, white spruce, white fir, grandfir, hemlock, and aspen. Stocking can be measure by either crown density, stem density, or basal area. Include land that formerly had such tree cover and that will be managed to be naturally or artificially regenerated with tree cover"@en .

ex:Def_def_usa_2003_1058 a ex:Definition ;
    rdfs:label "“We rely on respondent ‘self’ definition for the 5 year Census of Agriculture vi..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA-NASS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "“We rely on respondent ‘self’ definition for the 5 year Census of Agriculture via mail out/mail back. Our June area survey, we rely on data collected from trained enumerators who usually represent the ‘local’ definition”. Linda Hutton. lhutton@nass.usda.gov.. 12 August 2003"@en .

ex:Def_def_usa_2003_1127 a ex:Definition ;
    rdfs:label "“Forest land” means land with stands of native or introduced trees containing at..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Iowa ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "“Forest land” means land with stands of native or introduced trees containing at least 200 trees per acre. Stands of fruit trees shall not be considered as forest land"@en .

ex:Def_def_usa_2003_1144 a ex:Definition ;
    rdfs:label "An area dominated by trees forming a closed canopy and interspersed with multila..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2003_1144_criteria ;
    ex:hasSource ex:Source_USA-STATE-Missouri ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "An area dominated by trees forming a closed canopy and interspersed with multilayer shade tolerant sub-canopy trees, shrubs, vines, ferns and herbs. Trees attain a height of 60 to over 100 feet. The ground-flora is rich in spring ephemerals"@en .

ex:Def_def_usa_2003_1144_criteria ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float .

ex:Def_def_usa_2003_1145 a ex:Definition ;
    rdfs:label "An ecosystem characterized by a more or less dense and extensive tree cover, oft..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2003_1145_criteria ;
    ex:hasSource ex:Source_USA-STATE-MissourI ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "An ecosystem characterized by a more or less dense and extensive tree cover, often consisting of stands varying in characteristics such as species or composition, structure, age class, and associated processes, and commonly including meadows, streams, fish, and wildlife – note: forests include special kinds such as industrial forests, non-industrial private forests, plantations, public forests, protection forests, and urban forests, as well as parks and wilderness"@en .

ex:Def_def_usa_2003_1145_criteria ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float .

ex:Def_def_usa_2003_1218 a ex:Definition ;
    rdfs:label "Forest Land means land used primarily to grow trees to be harvested for commerci..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maine-Acton ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest Land means land used primarily to grow trees to be harvested for commercial use, but does not include marsh, open swamp, bog, water and similar areas, which are unsuitable for growing a forest product or for harvesting for commercial use even though these areas may exist within forest lands"@en .

ex:Def_def_usa_2003_1245 a ex:Definition ;
    rdfs:label "Forest means a tract of land that is at least ten percent (10%) stocked by trees..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oklahoma ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest means a tract of land that is at least ten percent (10%) stocked by trees of any size, whether of commercial or noncommercial species, or formerly having tree cover and not currently developed for nonforest use, including woodlands, woodlots, windbreaks, and shelterbelts"@en .

ex:Def_def_usa_2003_1278 a ex:Definition ;
    rdfs:label "\"Forest Land\" means any area on which trees exist, standing or fallen, alive or ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Wisconsin ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest Land\" means any area on which trees exist, standing or fallen, alive or dead, that are primarily grown because they are valuable for forest products, watershed or wildlife protection or non-residential recreational uses in contrast to areas where shade or ornamental trees are grown primarily because they are valuable for landscape, aesthetic, agricultural or similar purposes"@en .

ex:Def_def_usa_2003_1283 a ex:Definition ;
    rdfs:label "'Forest' means lands that support, or can support, at least 10 percent tree cano..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Georgia ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "'Forest' means lands that support, or can support, at least 10 percent tree canopy cover and that allow for management of one or more forest resources including but not limited to timber, fish and wildlife, biodiversity, water quality, air quality, soil conservation, recreation, aesthetics, or other benefits"@en .

ex:Def_def_usa_2003_1360 a ex:Definition ;
    rdfs:label "A tall woody plant having comparatively great height and a single trunk from whi..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-EPA ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A tall woody plant having comparatively great height and a single trunk from which an annual fruit or vegetable crop is produced for commercial purposes, such as maple tree for syrup, papaya tree, or orchard tree. Plantain and banana plants are also included. Trees used for pulp or timber are not considered trees under this part"@en .

ex:Def_def_usa_2003_4 a ex:Definition ;
    rdfs:label "The vegetation and artificial built-up materials covering the land surface. This..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-Climate_Change_Science_Program ;
    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "The vegetation and artificial built-up materials covering the land surface. This includes areas of vegetation (forests, shrublands, crops, deserts, lawns), bare soil, developed surfaces (paved land, buildings), and wet areas and bodies of water (watercourses, wetlands)"@en .

ex:Def_def_usa_2003_680 a ex:Definition ;
    rdfs:label "Minimum area = 0.5 ha, minimum tree crown cover =30%, minimum tree height = Vari..." ;
    ex:appliesTo ex:Country_USA ;
