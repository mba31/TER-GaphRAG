    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_unknown_798_criteria ;
    ex:hasSource ex:Source_USA-FED-EPA ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Vegetative communities comprised principally of trees potentially over 10m in height and typically characterized by closed or multi-layered canopies"@en .

ex:Def_def_usa_unknown_798_criteria ex:minHeight "10.0"^^xsd:float ;
    ex:minHeightSI "10.0"^^xsd:float .

ex:Def_def_usa_unknown_799 a ex:Definition ;
    rdfs:label "A dense growth of trees, plants, and underbrush covering a large area. and" ;
    ex:appliesTo ex:Country_USA ;
