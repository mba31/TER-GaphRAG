ex:Def_def_ita_unknown_1668 a ex:Definition ;
    rdfs:label "(ricostituzione boschiva) - A forest activity aimed to restore or improve the fo..." ;
    ex:appliesTo ex:Country_Italy ;
    ex:country "Italy" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
