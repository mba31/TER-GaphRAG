ex:Def_def_unk_2063_1218 a ex:Definition ;
    rdfs:label "A stand of trees, up to 18 m in height, with an open or continuous but not thick..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2063_1218_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "A stand of trees, up to 18 m in height, with an open or continuous but not thickly interlaced canopy, sometimes with shrubs interspersed, and a canopy cover of more than 20%. Grasses and herbs dominate the ground cover; epiphytic ferns are rare. Often subject to periodic burning. Woodland thicket )-defined as for bushland thicket-may also be recognized. http://www.kalro.org:8080/repository/bitstream/0/5057/1/REPRINT%20COLLECTION%2063%20Split%2035.pdf"@en .

