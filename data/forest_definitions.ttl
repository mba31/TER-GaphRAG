ex:Def_def_kyr_1999_1669 a ex:Definition ;
    rdfs:label ") - The installation of forest plantations on areas previously covered by forest..." ;
    ex:appliesTo ex:Country_Kyrgyzstan ;
    ex:country "Kyrgyzstan" ;
