    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forested land means an area of land predominately covered by trees other than trees planted for agricultural purposes"@en .

ex:Def_def_sou_1996_1444 a ex:Definition ;
    rdfs:label "Woodland - Tree canopy cover between 40-70%. A closed-to-open canopy community, ..." ;
    ex:appliesTo ex:Country_South_Africa ;
