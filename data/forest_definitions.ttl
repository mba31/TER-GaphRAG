ex:Def_def_bel_2006_817 a ex:Definition ;
    rdfs:label "Use Min. Area (ha) = 0.1 Min. Crown Cover (%) = 30 Min. Tree Height (m) = Min. S..." ;
    ex:appliesTo ex:Country_Belarus ;
