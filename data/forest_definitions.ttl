ex:Def_def_can_unknown_1101 a ex:Definition ;
    rdfs:label "“Forest land” means any uncultivated land in Saskatchewan on which trees or shru..." ;
    ex:appliesTo ex:Country_Canada ;
    ex:country "Canada" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "“Forest land” means any uncultivated land in Saskatchewan on which trees or shrubs are growing or standing or any barren, dry marsh or bog, and includes any highway over any such lands"@en .

ex:Def_def_can_unknown_1175 a ex:Definition ;
    rdfs:label "\"Forest land\" means land classified as forest land under section 4; = Forest lan..." ;
    ex:appliesTo ex:Country_Canada ;
    ex:country "Canada" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land classified as forest land under section 4; = Forest land. The chief forester must classify land as forest land if he or she considers that it will provide the greatest contribution to the social and economic welfare of British Columbia if predominantly maintained in successive crops of trees or forage, or both, or maintained as wilderness"@en .

ex:Def_def_can_unknown_1176 a ex:Definition ;
    rdfs:label "\"Forest land\" means land, other than a farm, that (a) is forest reserve land, ot..." ;
    ex:appliesTo ex:Country_Canada ;
    ex:country "Canada" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land, other than a farm, that (a) is forest reserve land, other than forest reserve land that is not used for the production and harvesting of timber, or (b) although not forest reserve land, has as its highest and best use the production and harvesting of timber"@en .

ex:Def_def_can_unknown_1177 a ex:Definition ;
    rdfs:label "Crown land or private land that is predominantly maintained in one or more succe..." ;
