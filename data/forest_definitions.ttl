    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "An area of land covered by trees; forests can be natural or planted"@en .

ex:Def_def_unk_unknown_79 a ex:Definition ;
    rdfs:label "An area of land covered largely with trees. Forests are vital parts of our globa..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "An area of land covered largely with trees. Forests are vital parts of our global ecosystem supplying oxygen, habitat for wildlife, timber and recreation areas"@en .

ex:Def_def_unk_unknown_8 a ex:Definition ;
    rdfs:label "Land cover generally refers to actual ground cover, eg, vegetation, crops, urban..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "Land cover generally refers to actual ground cover, eg, vegetation, crops, urban areas and open water. It also includes associations of the Earth's surface and its cover, such as forests, which are composites of various covers. The term reef zone is often used in reef mapping in place of land cover"@en .

ex:Def_def_unk_unknown_80 a ex:Definition ;
    rdfs:label "An extensive area of land covered with trees and undergrowth. Shorter Oxford Eng..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "An extensive area of land covered with trees and undergrowth. Shorter Oxford English Dictionary"@en .

ex:Def_def_unk_unknown_802 a ex:Definition ;
    rdfs:label "Forest - Tree canopy is greater than 10 m in height. Crowns are touching or over..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_802_criteria ;
    ex:hasSource ex:Source_Bellamy_J ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest - Tree canopy is greater than 10 m in height. Crowns are touching or overlapping. Ground layer not visible on airphotos. Source: Bellamy, J.A. Vanuatu Resource Information System. VANRIS Handbook. Via Adam Gerrand"@en .

ex:Def_def_unk_unknown_802_criteria ex:minHeight "10.0"^^xsd:float ;
    ex:minHeightSI "10.0"^^xsd:float .

ex:Def_def_unk_unknown_81 a ex:Definition ;
    rdfs:label "An extensive wood, or a large tract of land covered with trees. In America, the ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "An extensive wood, or a large tract of land covered with trees. In America, the word is usually applied to a wood of native growth, or a tract of woodland which has never been cultivated. It differs from wood or woods chiefly in extent"@en .

ex:Def_def_unk_unknown_82 a ex:Definition ;
    rdfs:label "Area of land covered by standing trees" ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "Area of land covered by standing trees"@en .

ex:Def_def_unk_unknown_83 a ex:Definition ;
    rdfs:label "Land covered by a closed stand of trees of one or more storeys, with an interlac..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_unknown_83_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "Land covered by a closed stand of trees of one or more storeys, with an interlaced upper canopy, rising to 7 - 40 m or more in height. The ground cover is dominated by herbs and shrubs, and lianes and epiphytes are characteristic. Dwarf forests are as defined but rise to less than 7 m in height. Sub-types are sub-alpine dwarf forest (2 500 - 3 500 m); lowland forest (<1 000 m); and groundwater forest"@en .

ex:Def_def_unk_unknown_83_criteria ex:minHeight "40.0"^^xsd:float ;
    ex:minHeightSI "40.0"^^xsd:float .

ex:Def_def_unk_unknown_84 a ex:Definition ;
    rdfs:label "Wood, Woods, area of land covered with trees. Babylon.com" ;
