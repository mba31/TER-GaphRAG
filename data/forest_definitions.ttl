ex:Def_def_den_unknown_1586 a ex:Definition ;
    rdfs:label "(Denmark) Forest means areas of 3 ha or more with woody plants which may on the ..." ;
    ex:appliesTo ex:Country_Denmark ;
    ex:country "Denmark" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_den_unknown_1586_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Denmark) Forest means areas of 3 ha or more with woody plants which may on the site of growth develop into tall standard (above 6 m). Woody plants also include many-stemmed mountain pine. www.mst.dk/rules/Ministerial%20Orders%20no%20longer%20in%20force/Chemicals%20not%20in%20force/05030500.doc"@en .

