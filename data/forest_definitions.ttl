ex:Def_def_eur_unknown_105 a ex:Definition ;
    rdfs:label "Ecosystems with a minimum of 10 per cent crown cover of trees and/or bamboos. Th..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Ecosystems with a minimum of 10 per cent crown cover of trees and/or bamboos. They usually contain wild flora, fauna and natural soil conditions, and are not subject to agricultural practices. Forests can be divided into two categories: natural and plantation forests and"@en .

