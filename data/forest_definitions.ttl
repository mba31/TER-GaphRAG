    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "(i) \"Forest\" means a biological community dominated by trees or other woody plants covering a land area of 1 acre or more.(ii) \"Forest\" includes an area that has been cut but not cleared of trees or other woody plants. Maryland 2007"@en .

