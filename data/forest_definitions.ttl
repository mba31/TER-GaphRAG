    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "A vegetation cover where trees are its main elements. They are divided into various types according to superficial and inner situation, and dominated by especial ecological conditions in respect of flora, fauna, climatic and edaphic factors"@en .

ex:Def_def_ira_unknown_539 a ex:Definition ;
    rdfs:label "FOREST: It is a land mainly covered by trees, shrubs and other woody plants. For..." ;
    ex:appliesTo ex:Country_Iran ;
    ex:country "Iran" ;
    ex:definitionType "Land Cover" ;
