    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest is land covered by trees with a minimum height of 3 m and the minimum width of the tree stand is 50 m. In addition, the tree crowns have to cover at least 20% of the area. Swiss Federal Research Institute (WSL) and Swiss Forest Monitoring, 2006"@en .

ex:Def_def_swi_2006_726_criteria ex:minCanopyCover "20.0"^^xsd:float ;
