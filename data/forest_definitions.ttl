    ex:hasCriteria ex:Def_def_unk_2005_78_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(World Bank 2005) Total Forest is defined as land with tree crown cover of more than 10 percent of the ground and area of more than 0.5 hectares. Tree height at maturity should exceed 5 meters. (source: Earthtrends, WRI) http://siteresources.worldbank.org/INTARD/Resources/devpol_final_text.pdf"@en .

