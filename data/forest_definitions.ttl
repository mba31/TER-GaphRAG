ex:Def_def_tha_1964_379 a ex:Definition ;
    rdfs:label "(Thailand. 1964) “Forest” means land including mountain, rivulet, marsh, canal, ..." ;
    ex:appliesTo ex:Country_Thailand ;
    ex:country "Thailand" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Thailand. 1964) “Forest” means land including mountain, rivulet, marsh, canal, swamp, waterway, lagoon, island, and sea shore in which nobody acquired by law; “National Reserved Forest” means forest determined to be national reserved forest under the provisions of this Act; “ http://thailawonline.com/en/thai-laws/laws-of-thailand/211-national-reserved-forest-act-be-2507-1964"@en .

ex:Def_def_tha_2001_1213 a ex:Definition ;
    rdfs:label "(Thailand 2001) Other wooded area; woodland. Area that has some forest character..." ;
    ex:appliesTo ex:Country_Thailand ;
    ex:country "Thailand" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Thailand 2001) Other wooded area; woodland. Area that has some forest characteristics but does not meet the definition of forest given above. Includes areas occupied by windbreaks groups of trees, fallow land, and shrubland. http://www.landcoalition.org/sites/default/files/legacy/legacypdf/08_gtz_land_tenure_systems.pdf"@en .

