ex:Def_def_unk_unknown_119 a ex:Definition ;
    rdfs:label "Forest systems: Systems in which trees are the predominant life forms. Statistic..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_119_criteria ;
