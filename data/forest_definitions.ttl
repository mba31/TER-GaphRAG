    ex:minCanopyCoverSI "30.0"^^xsd:float ;
    ex:minHeight "30.0"^^xsd:float ;
    ex:minHeightSI "30.0"^^xsd:float ;
    ex:minWidth "30.0"^^xsd:float ;
    ex:minWidthSI "30.0"^^xsd:float .

