    ex:minHeightSI "1.3"^^xsd:float .

ex:Def_def_unk_1998_1242 a ex:Definition ;
    rdfs:label "(UN-FAO 1998) Refers to change of land cover with depletion of tree crown cover ..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_1998_1242_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "(UN-FAO 1998) Refers to change of land cover with depletion of tree crown cover to less than 10%. Changes within the forest class (e.g. from closed to open forest) which negatively affect the stand or site and, in particular, lower the production capacity, are termed forest degradation http://unfcccbali.org/unfccc/component/option,com_glossary/Itemid,100/func,display/letter,D/catid,31/page,1/."@en .

ex:Def_def_unk_1998_1242_criteria ex:minCanopyCover "10.0"^^xsd:float ;
