ex:Def_def_geo_1999_107 a ex:Definition ;
    rdfs:label "(Georgia 1999) State Forest Fund (SFF): The integrity of state forest, land and ..." ;
    ex:appliesTo ex:Country_Georgia ;
    ex:country "Georgia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_geo_1999_107_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Georgia 1999) State Forest Fund (SFF): The integrity of state forest, land and other resources defined as SFF by the Georgian legislation (Forest Code of Georgia, 1999). Includes the land categories listed below: Forest: Part of geographic landscape, which includes the unity of trees (defined by the Georgian legislation as parts of forests), lands, bushes, grasses, animals and other objects, which are biologically inter-related and have an impact upon each other as well as environment. Forest lands: Open plantations, nurseries, clear-cut areas, fire damaged and dead stands, 0.1 ha and larger fields and forest farm yards. (President of Georgia, 1999). http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf"@en .

ex:Def_def_geo_1999_107_criteria ex:minArea "0.1"^^xsd:float ;
    ex:minAreaSI "0.1"^^xsd:float .

