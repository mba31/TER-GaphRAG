ex:Def_def_slo_1994_690 a ex:Definition ;
    rdfs:label "Cover Min. Area (ha) = 0.05 Min. Crown Cover (%) = Min. Tree Height (m) = Min. S..." ;
    ex:appliesTo ex:Country_Slovenia ;
    ex:country "Slovenia" ;
