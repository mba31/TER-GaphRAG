    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "(forest?) areas - - Areas both covered and not covered with the forest territories included into the National Forest Fund (stock). The main use of such lands is forest planting and growing. Source: Irina Yunusova irina@lesic.elcat.kg"@en .

ex:Def_def_lao_1996_272 a ex:Definition ;
    rdfs:label "All areas under the management of the Ministry of Agriculture and Forestry wheth..." ;
    ex:appliesTo ex:Country_Laos ;
    ex:country "Laos" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "All areas under the management of the Ministry of Agriculture and Forestry whether covered with forest or not, but not used for or defined as permanent agricultural land"@en .

ex:Def_def_lao_unknown_273 a ex:Definition ;
    rdfs:label "Living natural resources \"necessary for the preservation of the environment, wat..." ;
    ex:appliesTo ex:Country_Laos ;
    ex:country "Laos" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_LEX-FAOC004704 ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Living natural resources \"necessary for the preservation of the environment, water sources, soil, wildlife and the livelihood of the pluri-ethnical population\". Forest lands are all areas under the management of the Ministry of Agriculture and Forestry, whether covered or not by forests, if not used or defined as permanent agricultural land. Source: LEX-FAOC004704. LAOS: Decree of the Prime Minister on the Management and Use of Forests and Forest Land (No. 169/PM)"@en .

ex:Def_def_lat_1937_575 a ex:Definition ;
    rdfs:label "The Law on Forest Protection of Oct. 14, 1937 defined the forest by the followin..." ;
    ex:appliesTo ex:Country_Latvia ;
    ex:country "Latvia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_lat_1937_575_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "The Law on Forest Protection of Oct. 14, 1937 defined the forest by the following traits: i) land areas overgrown by forest ; ii) meadows, pastureland and other non-cultivated lands overgrown by forest, stocked to no less than a half of full density and encircled by forest; iii) felling coupes, irrespective of the situation with forest regeneration there; iv) all lands, irrespective of the tree age and density, where the owner has ceased other management activities to let the forest grow there. Stands on swampy sites, provided the tree height at the age of 60 years remained below 7 m, were not counted as forest. )"@en .

ex:Def_def_lat_1937_575_criteria ex:minHeight "7.0"^^xsd:float ;
    ex:minHeightSI "7.0"^^xsd:float .

ex:Def_def_lat_2000_576 a ex:Definition ;
    rdfs:label "According to the Forest Law of the Republic of Latvia adopted in 2000 (Item 2, P..." ;
    ex:appliesTo ex:Country_Latvia ;
    ex:country "Latvia" ;
