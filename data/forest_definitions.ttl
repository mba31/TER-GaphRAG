ex:Def_def_den_unknown_236 a ex:Definition ;
    rdfs:label "the basic definition of a forest is that the forest area must be minimum 0.5 ha...." ;
    ex:appliesTo ex:Country_Denmark ;
    ex:country "Denmark" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_den_unknown_236_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "the basic definition of a forest is that the forest area must be minimum 0.5 ha. There is no specific guideline on the crown cover or the height of the trees"@en .

