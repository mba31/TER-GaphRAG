ex:Def_def_den_2011_847 a ex:Definition ;
    rdfs:label "Land with tree crown cover (or equivalent stocking level) of more than 10% and a..." ;
    ex:appliesTo ex:Country_Denmark ;
    ex:country "Denmark" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_den_2011_847_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:region "Europe" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
