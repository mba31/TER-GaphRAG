    ex:hasCriteria ex:Def_def_tha_2001_737_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Closed forest. Forest in which the stand density is greater than 20 percent of the area and tree crowns approach general contact with one another. Open forest. Forest in which the tree canopy layer is discontinuous but covers at least 10 percent of the area and in which the grass layer is continuous"@en .

ex:Def_def_tha_2001_737_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

