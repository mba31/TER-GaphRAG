ex:Def_def_unk_2009_65 a ex:Definition ;
    rdfs:label "(UN 2009) the UN defines a forest as any area larger than 500 square metres with..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_United_Nations ;
    skos:note "(UN 2009) the UN defines a forest as any area larger than 500 square metres with crown cover of 10 per cent and trees capable of growing two metres high. The differences between native forests and monoculture industrial tree plantations cannot be identified by this definition (UN-REDD, 2009). http://www.equitybd.org/documents/cts_eng.pdf"@en .

