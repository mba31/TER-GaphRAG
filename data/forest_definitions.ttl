ex:Def_def_usa_2007_991 a ex:Definition ;
    rdfs:label "forest land—Land at least 120 feet wide and 1 acre in size with at least 10 perc..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2007_991_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "forest land—Land at least 120 feet wide and 1 acre in size with at least 10 percent cover (or equivalent stocking) by live trees of any size, including land that formerly had such tree cover and that will be naturally or artificially regenerated. Forest land includes transition zones, such as areas between forest and nonforest lands that have at least 10 percent cover (or equivalent stocking) with live trees and forest areas adjacent to urban and built-up lands. Roadside, streamside, and shelterbelt strips of trees must have a crown width of at least 120 feet and continuous length of at least 363 feet to qualify as forest land. Unimproved roads and trails, streams, and clearings in forest areas are classified as forest if they are less than 120 feet wide or an acre in size. Tree-covered areas in agricultural production settings, such as fruit orchards, or tree-covered areas in urban settings, such as city parks, are not considered forest land. NOTE: This definition does not apply to the data for western Texas, western Oklahoma, and interior Alaska, which, to date, have not had field verification of reported (Smith et al. 2009)"@en .

ex:Def_def_usa_2007_991_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_2008_1082 a ex:Definition ;
    rdfs:label "From a management standpoint, a forest is a collection of stands administered as..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Mississippi ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "From a management standpoint, a forest is a collection of stands administered as a unit"@en .

ex:Def_def_usa_2008_1286 a ex:Definition ;
    rdfs:label "Forestland -- Land which is currently producing (or, in some cases, capable of p..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Mississippi ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Forestland -- Land which is currently producing (or, in some cases, capable of producing) a forest"@en .

ex:Def_def_usa_2008_794 a ex:Definition ;
    rdfs:label "A forest is best defined as an ecosystem or assemblage of ecosystems dominated b..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2008_794_criteria ;
    ex:hasSource ex:Source_USA-FED-DS-AID ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "A forest is best defined as an ecosystem or assemblage of ecosystems dominated by trees and other woody vegetation. Forests (according to the U.S. National Vegetation Classification system) consist of trees with overlapping crowns forming 60% to 100% cover. Woodlands are more open, with 25% to 60% cover"@en .

ex:Def_def_usa_2008_794_criteria ex:minCanopyCover "25.0"^^xsd:float ;
    ex:minCanopyCoverSI "25.0"^^xsd:float .

ex:Def_def_usa_2009_1079 a ex:Definition ;
    rdfs:label "The term “Forest” means the Hawaii Experimental Tropical Forest" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Hawaii ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "The term “Forest” means the Hawaii Experimental Tropical Forest"@en .

ex:Def_def_usa_2009_1118 a ex:Definition ;
    rdfs:label "A biological community of plants and animals that is dominated by trees and othe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Florida ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "A biological community of plants and animals that is dominated by trees and other woody plants. Florida 2009"@en .

ex:Def_def_usa_2009_1140 a ex:Definition ;
    rdfs:label "\"Forest\" means a plant association predominantly of trees and other woody vegeta..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Minnesota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means a plant association predominantly of trees and other woody vegetation occupying an extensive area of land"@en .

ex:Def_def_usa_2009_1224 a ex:Definition ;
    rdfs:label "“forest\" means (1) a contiguous biological community dominated by trees and othe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maryland-Rockville ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "“forest\" means (1) a contiguous biological community dominated by trees and other woody plants covering a land area of five thousand (5,000) square feet or greater. (2) \"Forest\" includes:a. Areas that have at least one hundred (100) live trees per acre with at least fifty (50) percent of those trees having a two-inch or greater diameter at four and one-half (4.5) feet above the ground and larger; and b. Areas that have been cut but not cleared. (3) \"Forest\" does not include orchards. “Rockville, Maryland. 2009"@en .

ex:Def_def_usa_2009_1233 a ex:Definition ;
    rdfs:label "\"Forest land\" means land which is at least ten percent stocked by trees of any s..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Minnesota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land which is at least ten percent stocked by trees of any size and capable of producing timber, or of exerting an influence on the climate or on the water regime; land from which the trees described above have been removed to less than ten percent stocking and which has not been developed for other use; and afforested areas"@en .

ex:Def_def_usa_2009_1257 a ex:Definition ;
    rdfs:label "Forest land\" or \"forest\" means land supporting a stand or potential stand of tre..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-South_Carolina ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land\" or \"forest\" means land supporting a stand or potential stand of trees valuable for timber products, watershed or wildlife protection, recreational uses, or for other purposes. South Carolina South Carolina Code of Laws (Unannotated) Current through the end of the 2009 Session and"@en .

ex:Def_def_usa_2009_1479 a ex:Definition ;
    rdfs:label "Woodlands and Savannas are dominated by widely-spaced trees including junipers, ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Idaho ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Woodlands and Savannas are dominated by widely-spaced trees including junipers, oaks, mesquite and pines with an understory of grasses and forbs. Woodland ecosystems across the world take the names of the trees that dominate the landscape. Roselle, Lovina et al. 2009. Rangelands – An introduction to Idaho’s Wild Open Spaces. University of Idaho and Idaho Rangeland Resource Commission. 54 p"@en .

ex:Def_def_usa_2009_793 a ex:Definition ;
    rdfs:label "Areas dominated by trees. Wang, Y. Q.; Nugranad-Marzilli, J. 2009. Land cover ch..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-NPS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Areas dominated by trees. Wang, Y. Q.; Nugranad-Marzilli, J. 2009. Land cover change in Northeast Temperate Network parks 1973-2002. Natural Resource Technical Report NPS/NETN/NRTR — 2009/238. National Park Service, Fort Collins, Colorado"@en .

ex:Def_def_usa_2010_1013 a ex:Definition ;
    rdfs:label "Forest means any operation engaged in the outdoor production of any agricultural..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-GPO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest means any operation engaged in the outdoor production of any agricultural plant to produce wood fiber or timber products. USA WORKER PROTECTION STANDARD"@en .

ex:Def_def_usa_2010_1266 a ex:Definition ;
    rdfs:label "Land used for forestal use must be a minimum of twenty acres and must include st..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Virginia-Ablemarle_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land used for forestal use must be a minimum of twenty acres and must include standing timber and trees devoted to tree growth in such quantity and so spaced and maintained as to constitute a forest area. Requires a minimum of 20 or more contiguous unimproved acres exclusively devoted to forestal use with no livestock access. Forestal acreage with livestock access must be qualified under the agricultural use category. Forestal participants are required to have a forest management plan prepared by a forestry professional or a letter of intent stating that the land will be forested"@en .

ex:Def_def_usa_2010_1271 a ex:Definition ;
    rdfs:label "\"Forestland\" means all land which is capable of supporting a merchantable stand ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forestland\" means all land which is capable of supporting a merchantable stand of timber and is not being actively used for a use which is incompatible with timber growing. Forestland does not include agricultural land that is or was enrolled in the conservation reserve enhancement program by contract if such agricultural land was historically used for agricultural purposes and the landowner intends to continue to use the land for agricultural purposes in the future. As it applies to the operation of the road maintenance and abandonment plan element of the forest practices rules on small forest landowners, the term \"forestland\" excludes: (a) Residential home sites, which may include up to five acres; and (b) Cropfields, orchards, vineyards, pastures, feedlots, fish pens, and the land on which appurtenances necessary to the production, preparation, or sale of crops, fruit, dairy products, fish, and livestock exist"@en .

ex:Def_def_usa_2011_1114 a ex:Definition ;
    rdfs:label "\"Forest land\" means that portion of a parcel of land which constitutes a total o..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Connecticut ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest land\" means that portion of a parcel of land which constitutes a total of at least one contiguous acre on which there is no structure, maintained landscape area, accessway or other improvement and which is (A) occupied in random distribution by trees having a minimum diameter of three inches as measured from a point on the trunk which is four and one-half feet above the ground such trees comprising at least seven and one-half square feet of basal area and the crowns of such trees occupying no less than fifteen per cent of the total area; or (B) which is planted with at least five hundred trees per acre and is not maintained for Christmas tree or nursery stock production; and"@en .

ex:Def_def_usa_2015_1116 a ex:Definition ;
    rdfs:label "Forested area(s): A forest is defined as any area on a site with greater than or..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Delaware-Wilmington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forested area(s): A forest is defined as any area on a site with greater than or equal to one hundred (100) trees per acre"@en .

ex:Def_def_usa_2017_1170 a ex:Definition ;
    rdfs:label "“Forestry\" means managing forest lands and their related resources, including tr..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Wisconsin ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "“Forestry\" means managing forest lands and their related resources, including trees and other plants, animals, soil, water and air"@en .

ex:Def_def_usa_2019_1216 a ex:Definition ;
    rdfs:label "Forestland--means land used primarily for growth of trees to be harvested for co..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maine ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland--means land used primarily for growth of trees to be harvested for commercial use; may be either seedling, pole timber, or saw log stands. Forestland does not include ledge, marsh, open swamp, bog, water and similar areas that are unsuitable for growing a forest product or for harvesting for commercial use even though these areas may exist within forestlands"@en .

ex:Def_def_usa_2024_1137 a ex:Definition ;
    rdfs:label "“Forest” means a tract of land that is thick with trees and underbrush" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Michigan ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "“Forest” means a tract of land that is thick with trees and underbrush"@en .

ex:Def_def_usa_2032_1581 a ex:Definition ;
    rdfs:label "converting a bare or agricultural space by planting trees and plants; reforestat..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-CIA ;
    ex:sectionMain "2.14 STAND" ;
    ex:sectionSub "3.1.2 Land Cover" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "converting a bare or agricultural space by planting trees and plants; reforestation involves replanting trees on areas that have been cut or destroyed by fire"@en .

ex:Def_def_usa_2032_1618 a ex:Definition ;
    rdfs:label "Tthe destruction of vast areas of forest (e.g., unsustainable forestry practices..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-CIA ;
    ex:sectionMain "3.2 DEFORESTATION" ;
    ex:sectionSub "3.2.2 As a change in land cover" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "Tthe destruction of vast areas of forest (e.g., unsustainable forestry practices, agricultural and range land clearing, and the over exploitation of wood products for use as fuel) without planting new growth"@en .

ex:Def_def_usa_unknown_1002 a ex:Definition ;
    rdfs:label "Land for which a primary use is the growing and harvesting of forest tree specie..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BIA ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land for which a primary use is the growing and harvesting of forest tree species. Source: THE CONFEDERATED TRIBES OF THE GRAND RONDE COMMUNITY OF OREGON FOREST PRACTICES ORDINANCE TRIBAL CODE &sect; 6.20"@en .

ex:Def_def_usa_unknown_1006 a ex:Definition ;
    rdfs:label "Land that is now, or is capable of becoming, at least l0 percent stocked with fo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BLM ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land that is now, or is capable of becoming, at least l0 percent stocked with forest trees and that has not been developed for nontimber use. Source: Coos Bay Record of Decision - .(Streamnet online) and Medford Record of Decision and Resource Management Plan"@en .

ex:Def_def_usa_unknown_1009 a ex:Definition ;
    rdfs:label "Land currently supporting forest or land with potential to support forest that f..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1009_criteria ;
    ex:hasSource ex:Source_USA-FED-DI-GS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land currently supporting forest or land with potential to support forest that formerly had such tree cover and that will be naturally or artificially regenerated – Note 1) forest land includes (a) transition zones, such as areas between forested and non-forested lands that are at least 10 percent stocked with forest trees, and forest areas adjacent to urban and built-up lands; note 2) the minimum area for classification of forest land is 1 acre (0.4 ha); roadside, streamside, and shelterbelt strips of trees must have a crown width of at least 120 ft. (36.6 m); unimproved roads and trails, streams, and clearings in forest areas are classified as forest if less than 120 ft wide. (cf.) Forest (1.1.2.)"@en .

ex:Def_def_usa_unknown_1009_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float ;
