ex:Def_def_est_2005_327 a ex:Definition ;
    rdfs:label "(Estonia 2005) Forest land (= productive forest land, National definition) Minim..." ;
    ex:appliesTo ex:Country_Estonia ;
    ex:country "Estonia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_est_2005_327_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Estonia 2005) Forest land (= productive forest land, National definition) Minimum area 0.1 ha and 30% crown cover, with height more than 1.3 m, with average annual productivity more than 1 m3/ha of stem wood (incl. temporarily unstocked areas). Pärt E., Adermann V., Merenäk M., 2010. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf"@en .

