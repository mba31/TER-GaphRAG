    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Other wooded land then corresponds to: \"Non-productive forest land\" and \"wooded mire\". Non-productive forest land should have an average potential production of between 0.1 and 1.0 m3 per ha and year, regardless of the current stocking and it should have mineral soil. Wooded mire has the same production potential as non-productive forest land, with a peat soil. From: marit-viktoria.pettersen@sftospost.md.dep.telemax.no (European Communities 1997b - p. 832)"@en .

ex:Def_def_nor_unknown_1439_criteria ex:minHeight "1.0"^^xsd:float ;
    ex:minHeightSI "1.0"^^xsd:float .

ex:Def_def_nor_unknown_929 a ex:Definition ;
    rdfs:label "For the purpose of this Act, «forest land» means land which produces forest 2) o..." ;
    ex:appliesTo ex:Country_Norway ;
    ex:country "Norway" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "For the purpose of this Act, «forest land» means land which produces forest 2) or which on an overall farming- and forestry assessment is considered to be most suitable for forest production and is not being used for any other purpose"@en .

ex:Def_def_pak_1911_285 a ex:Definition ;
    rdfs:label "Forest land - Any land which has been declared to be forest by notification unde..." ;
    ex:appliesTo ex:Country_Pakistan ;
    ex:country "Pakistan" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Mumtaz_Ahmad_Section_Forest_Officer_Pakistan_Min ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Forest land - Any land which has been declared to be forest by notification under a Forest Act. Definition adopted from Glossary of Technical Terms for use in Indian Forestry - compiled by A.M.F. Caccia and revised by R.S. Troup, 1911. Source: Mumtaz Ahmad, Section Forest Officer, Pakistan Min. of Environment, Local Government, and Rural Development"@en .

ex:Def_def_pak_1927_1336 a ex:Definition ;
