    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Zona florestal - O espaço territorial que for reservado no plano de ordenamento do território a usos florestais, nomeadamente para a criação, restauração, conservação e aproveitamento do coberto florestal; LEX-FAOC013213. CAPE VERDE: Forestry Act (No. 48/V/98)"@en .

ex:Def_def_unk_1998_88 a ex:Definition ;
    rdfs:label "An ecosystem characterized by a more or less dense or extensive tree cover, ofte..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.3 As a land use type" ;
    skos:note "An ecosystem characterized by a more or less dense or extensive tree cover, often consisting of stands varying in characteristics such as species composition, structure, age class, and associated processes, and commonly including meadows streams, fish and wildlife. Note - forests include specialized kinds such as industrial forests, non-industrial private forests, plantations, public forests, production forests, and urban forests, as well as parks and wilderness (Helms 1998)"@en .

ex:Def_def_unk_1998_899 a ex:Definition ;
    rdfs:label "Forest - Any existing area of land under section 11 and any areas of land used f..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest - Any existing area of land under section 11 and any areas of land used for forestry, or declared forestry use, under sections 12, 13, and 14 of this Act. Forestry Act 1998. Via David May ISTF CVP Lesotho"@en .

ex:Def_def_unk_1999_1038 a ex:Definition ;
    rdfs:label "Forest is one of the main types of vegetation on the Earth, comprising trees, sh..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Forest is one of the main types of vegetation on the Earth, comprising trees, shrubs, grassland and other plants, including animals and microorganisms, which are biologically interrelated in their evolution and exert influence on one another and the environment. Forest Code of The Kyrgyz Republic"@en .

ex:Def_def_unk_1999_1387 a ex:Definition ;
    rdfs:label "A woody perennial, usually singlestemmed plant that has a definite crown shape a..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_1999_1387_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A woody perennial, usually singlestemmed plant that has a definite crown shape and reaches a mature height of at least 4 meters. The distinction between woody plants known as trees and those called shrubs is gradual. Some plants, such as oaks (Quercus spp.), may grow as either trees or shrubs (SRM 1999)"@en .

ex:Def_def_unk_1999_1387_criteria ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float .

ex:Def_def_unk_1999_143 a ex:Definition ;
    rdfs:label "Land with tree crown cover (or equivalent stocking level) of more than 10% and a..." ;
