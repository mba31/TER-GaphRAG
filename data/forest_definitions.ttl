    ex:region "Africa" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Indigenous forest is defined as \"a generally multilayered vegetation unit dominated by trees (largely evergreen or semi-deciduous) whose combined strata have overlapping crowns (i.e. the crown cover is greater than or equal to 75 percent), and where graminoids in the herbaceous stratum (if present) are generally rare\""@en .

ex:Def_def_sou_2002_702_criteria ex:minCanopyCover "75.0"^^xsd:float ;
    ex:minCanopyCoverSI "75.0"^^xsd:float .

