    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2008_1665 a ex:Definition ;
    rdfs:label "This process increases the capacity of the land to sequester carbon by replantin..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "3.4 FORESTATION" ;
    ex:sectionSub "3.5.1 Restoration of Land Cover" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "This process increases the capacity of the land to sequester carbon by replanting forest biomass in areas where forests have been previously harvested. Registration: The formal acceptance by the CDM Executive Board of a validated project as a CDM project activity"@en .

ex:Def_def_unk_2008_305 a ex:Definition ;
    rdfs:label "state forest means a forest belonging to the nation and in the territory of the ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "state forest means a forest belonging to the nation and in the territory of the nation, but without an owner. 2. A public forest means a forest held by a direct municipality, county (city), town, village or legal public entity. 3. A private forest means the ownership of a forest acquired by a private citizen or private legal entity. Chiayi Forest District Office. 2008"@en .

ex:Def_def_unk_2009_110 a ex:Definition ;
    rdfs:label "Forests are complex tree dominated ecosystems with particular structural biotic ..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Forests are complex tree dominated ecosystems with particular structural biotic and abiotic components, assembled within temporal and spatial limits and with a self sustained successional dynamic determined by its own biodiversity, including the determining anthropogenic interfaces, particularly with Indigenous Peoples and peoples who adopted their knowledge. Source: yvetogo@hotmail.com, 30 April 2009"@en .

ex:Def_def_unk_2009_121 a ex:Definition ;
    rdfs:label "Continuously forested areas with a land spanning of more than one hectare with t..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2009_121_criteria ;
    ex:hasSource ex:Source_Unknown ;
