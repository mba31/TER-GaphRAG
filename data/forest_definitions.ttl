    skos:note "Forestry Act (1941): “Forest is a land without occupants in accordance with the land law” (Praraachabanyat Paamai Po. So. 2484, Matraa 4 (1) [Forestry Act of 1941, Article 4, Section 1]"@en .

ex:Def_def_tha_1941_309 a ex:Definition ;
    rdfs:label "The Forest Act B.E. 2484 (1941) defines \"forest\" as any land which is not yet oc..." ;
    ex:appliesTo ex:Country_Thailand ;
    ex:country "Thailand" ;
    ex:definitionType "Administrative" ;
