ex:Def_def_usa_2007_1220 a ex:Definition ;
    rdfs:label "(i) \"Forest\" means a biological community dominated by trees or other woody plan..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
