    ex:minHeightSI "8.0"^^xsd:float .

ex:Def_def_yem_unknown_1621 a ex:Definition ;
    rdfs:label "Deforestation (Arabic : Zawal Al Ghabah, French : Déforestation, Spanish : defor..." ;
    ex:appliesTo ex:Country_Yemen ;
    ex:country "Yemen" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_yem_unknown_1621_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "3.2 DEFORESTATION" ;
    ex:sectionSub "3.2.2 As a change in land cover" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "Deforestation (Arabic : Zawal Al Ghabah, French : Déforestation, Spanish : deforestacion) – Aggression (negative action) leading to the removal of trees and stands from the forest. This agreesion, if not stopped in time, could put in jeopardy the preservation of the forest. The cause could be anthropic (cutting), fire (burning), or livestock (overgrazing). Mohammed Ellatifi, m.ellatifi@ellatifi.8m.com"@en .

ex:Def_def_yem_unknown_1621_criteria ex:minHeight "8.0"^^xsd:float ;
    ex:minHeightSI "8.0"^^xsd:float .

ex:Def_def_yem_unknown_1698 a ex:Definition ;
    rdfs:label "Reforestation (Arabic : I’adat tashjeer/tahreej, French : Reboisement) - Artific..." ;
    ex:appliesTo ex:Country_Yemen ;
    ex:country "Yemen" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_yem_unknown_1698_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "3.4 FORESTATION" ;
    ex:sectionSub "3.5.1 Restoration of Land Cover" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Reforestation (Arabic : I’adat tashjeer/tahreej, French : Reboisement) - Artificial creation (by man) of a forest on an land which has been forested before, but on which the forest has disappeared, using seedlings, vegetative materials or seeds (sowing) Mohammed Ellatifi, m.ellatifi@ellatifi.8m.com"@en .

ex:Def_def_yem_unknown_1698_criteria ex:minHeight "8.0"^^xsd:float ;
    ex:minHeightSI "8.0"^^xsd:float .

ex:Def_def_yem_unknown_809 a ex:Definition ;
    rdfs:label "(Local Arabic term for Forests: Ghabat or Ahraj) - Piece of land covered a veget..." ;
    ex:appliesTo ex:Country_Yemen ;
    ex:country "Yemen" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_yem_unknown_809_criteria ;
