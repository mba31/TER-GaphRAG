ex:Def_def_eur_2008_1599 a ex:Definition ;
    rdfs:label "Deforestation is the permanent destruction of forests and woodlands" ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "3.2 DEFORESTATION" ;
    ex:sectionSub "3.2.2 As a change in land cover" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "Deforestation is the permanent destruction of forests and woodlands"@en .

ex:Def_def_eur_2009_172 a ex:Definition ;
    rdfs:label "The forest type product allows to get as close as possible to the FAO forest def..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_eur_2009_172_criteria ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "The forest type product allows to get as close as possible to the FAO forest definition. In its original (20m) resolution it consists of two products: 1) a dominant leaf type product that has a MMU of 0.5 ha, as well as a 10% tree cover density threshold applied, and 2) a support layer that maps, based on the dominant leaf type product, trees under agricultural use and in urban context (derived from CLC and imperviousness 2009 data). For the final 100m product trees under agricultural use and urban context from the support layer are removed"@en .

ex:Def_def_eur_2009_172_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "20.0"^^xsd:float .

