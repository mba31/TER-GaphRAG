    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_eur_2013_1587 a ex:Definition ;
    rdfs:label "‘afforestation’ means the direct human-induced conversion of land that has not b..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.14 STAND" ;
    ex:sectionSub "3.1.3 Land Cover and Use" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "‘afforestation’ means the direct human-induced conversion of land that has not been forest for a period of at least 50 years to forest through planting, seeding and/or the human-induced promotion of natural seed sources, where the conversion has taken place after 31 December 1989"@en .

ex:Def_def_eur_2013_1625 a ex:Definition ;
    rdfs:label "‘deforestation’ means the direct human-induced conversion of forest to land that..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "3.2 DEFORESTATION" ;
    ex:sectionSub "3.2.3 As a change in land use" ;
    ex:sectionSubSub "3.1 AFFORESTATION - Afforestation may be a legal term or a process of stocking land. In the case of the latter, we group the definitions into those that imply a change in land cover only and those that imply a change in land cover and use. Four definitions specify \"crops\" implying that the trees will be later removed for commercial purposes. The time period for lands \"never having been forested\" vary from never to 30 to 100 years." ;
    skos:note "‘deforestation’ means the direct human-induced conversion of forest to land that is not forest, where the conversion has taken place after 31 December 1989"@en .

ex:Def_def_eur_2013_1662 a ex:Definition ;
    rdfs:label "‘reforestation’ means any direct human-induced conversion of land that is not fo..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "3.4 FORESTATION" ;
    ex:sectionSub "3.5.1 Restoration of Land Cover" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "‘reforestation’ means any direct human-induced conversion of land that is not forest to forest through planting, seeding and/or the human-induced promotion of natural seed sources, which is confined to land that was forest but ceased to be forest before 1 January 1990, and which has been reconverted to forest in the period after 31 December 1989"@en .

ex:Def_def_eur_2013_171 a ex:Definition ;
    rdfs:label "‘Forest’ means an area of land defined by the minimum values for area size, tree..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "‘Forest’ means an area of land defined by the minimum values for area size, tree crown cover or an equivalent stocking level, and potential tree height at maturity at the place of growth of the trees, as specified for each Member State in Annex V. It includes areas with trees, including groups of growing young natural trees, or plantations that have yet to reach the minimum values for tree crown cover or equivalent stocking level or minimum tree height as specified in Annex V, including any area that normally forms part of the forest area but on which there are temporarily no trees as a result of human intervention, such as harvesting, or as a result of natural causes, but which area can be expected to revert to forest"@en .

ex:Def_def_eur_unknown_1 a ex:Definition ;
    rdfs:label "Land cover corresponds to a (bio)physical description of the earth's surface. It..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "Land cover corresponds to a (bio)physical description of the earth's surface. It is that which overlays or currently covers the ground. This description enables various biophysical categories to be distinguished - basically, areas of vegetation (trees, bushes, fields, lawns), bare soil, hard surfaces (rocks, buildings) and wet areas and bodies of water (watercourses, wetlands). and"@en .

ex:Def_def_eur_unknown_102 a ex:Definition ;
    rdfs:label "Areas spanning more than 0.5 to 1.0 hectares (depending on national definitions)..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_eur_unknown_102_criteria ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Areas spanning more than 0.5 to 1.0 hectares (depending on national definitions) with trees higher than 5 meters and a canopy cover of more than 10 percent, or trees able to reach these thresholds in situ. It does not include land that is predominantly under agricultural or urban land use. Land registry systems should specify the concerned areas in terms of land use as „forest“"@en .

