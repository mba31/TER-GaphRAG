    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Czech Republic 1995) - stand shall mean the basic unit of spatial arrangement of the forest identifiable in the terrain and shown on a forestry map http://www.uhul.cz/images/ke_stazeni/legislativa_jazyky/Lesni_zakon_en.pdf"@en .

ex:Def_def_cze_1997_1366 a ex:Definition ;
    rdfs:label "(Czech Republic 1997) Land destined to fulfill the forest functions, that is: (a..." ;
    ex:appliesTo ex:Country_Czech_Republic ;
    ex:country "Czech Republic" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cze_1997_1366_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Czech Republic 1997) Land destined to fulfill the forest functions, that is: (a) land with forest stands and land after clear cutting ready for reforestation, forest line and soft road of a width less than 4 m; (b) forest roads, water surfaces, land above timber line and other land serving for forest management. Minimum area is 0.01 ha with a minimum width of 20 m and with no definition on crown cover or stand density. (European Communities 1997b - p. 1225)."@en .

