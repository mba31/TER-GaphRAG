ex:Def_def_hun_2006_219 a ex:Definition ;
    rdfs:label "(Hungary 2006) Definition: Forest should be consisted more than 50% of the tree ..." ;
    ex:appliesTo ex:Country_Hungary ;
    ex:country "Hungary" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_hun_2006_219_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Hungary 2006) Definition: Forest should be consisted more than 50% of the tree species (listed in the Forest Act) and forest cover is more than 30%. Mezőgazdasági Szakigazgatási Hivatal (MGSZH), 2006. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf"@en .

ex:Def_def_hun_2006_219_criteria ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float .

ex:Def_def_hun_2006_220 a ex:Definition ;
    rdfs:label "(Hungary 2006) Forest land (1000 ha) - With defined tree species, minimum block ..." ;
    ex:appliesTo ex:Country_Hungary ;
    ex:country "Hungary" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_hun_2006_220_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Hungary 2006) Forest land (1000 ha) - With defined tree species, minimum block size 0.5 ha, -Crown cover min. 50% (30% if protection function). Area: all forest where the forest block is at least 0.5 ha (all area which has “forest” cadastral status, plus all area where forest is found) Definition: Forest should be consisted more than 50% of the tree species (listed in the Forest Act) and forest cover is more than 30%. Mezőgazdasági Szakigazgatási Hivatal (MGSZH), 2006. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf"@en .

ex:Def_def_hun_2006_220_criteria ex:minArea "1000.0"^^xsd:float ;
    ex:minAreaSI "1000.0"^^xsd:float ;
    ex:minCanopyCover "50.0"^^xsd:float ;
    ex:minCanopyCoverSI "50.0"^^xsd:float .

