ex:Def_def_unk_1996_1261 a ex:Definition ;
    rdfs:label "The natural or artificial restocking of an area with forest trees. http://www.sf..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "The natural or artificial restocking of an area with forest trees. http://www.sfrc.ufl.edu/Class/for3162c/silvterm.pdf. Typically, refers to planting (Dunster and Dunster 1996)."@en .

ex:Def_def_unk_1996_1856 a ex:Definition ;
    rdfs:label "The natural or artificial restocking of an area with forest trees. http://www.sf..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
