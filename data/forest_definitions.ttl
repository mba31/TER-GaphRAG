ex:Def_def_aus_1975_1423 a ex:Definition ;
    rdfs:label "(and non-forest land) - Areas which are not under forest management and which ha..." ;
    ex:appliesTo ex:Country_Austria ;
    ex:country "Austria" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_aus_1975_1423_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(and non-forest land) - Areas which are not under forest management and which have a crown cover of less than 30%; areas stocked by shrubs (except coppice stands and areas which have been identified as protective forests); rows of trees (except wind belts); short rotation plantations, for instance for fuelwood production (with a rotation period of less than 30 years); Christmas tree cultures, forest nurseries, plantations for seeds of forest trees or fruits. (Austrian Forestry Act (Federal Legal Gazette no. 440/1975, as amended Federal Legal Gazette 231/1977, 142/1978 and 576/1987) From: Weiss Peter weissp@ubavie.gv.at)"@en .

