ex:Def_def_usa_2004_1113 a ex:Definition ;
    rdfs:label "The term \"forest land\" means any tract or tracts of land aggregating twenty-five..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Connecticut ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "The term \"forest land\" means any tract or tracts of land aggregating twenty-five acres or more in area bearing tree growth in such quantity and so spaced as to constitute in the opinion of the State Forester a forest area and maintained in the opinion of the State Forester in a state of proper forest condition and such land consists of (1) one tract of land of twenty-five or more contiguous acres, which acres may be in contiguous municipalities, (2) two or more tracts of land aggregating twenty-five acres or more in which no single component tract shall consist of less than ten acres or (3) any tract of land which is contiguous to a tract owned by the same owner which has been designated as forest land by the State Forester, provided land designated by the State Forester as forest land in accordance with section 12-107d prior to July 1, 1976, shall not be subject to the provisions of subdivisions (1) to (3), inclusive, of this subsection; Source: and and"@en .

ex:Def_def_usa_2004_1188 a ex:Definition ;
    rdfs:label "Land with a specified minimum tree crown cover and generally more than the speci..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land with a specified minimum tree crown cover and generally more than the specified minimum area, including land that formerly had such tree cover and that will be naturally or artificially regenerated. The trees should generally be able to reach a minimum specified tree height at maturity in situ. It may consist either of closed forest formations in which trees of various stories and undergrowth cover a high proportion of the ground, or of open forest formations with a continuous vegetation cover in which tree crown cover exceeds the minimum percent. Young natural stands and all plantations established for forestry purposes, which have yet to reach the minimum crown density or tree height, are included under forest, as are areas normally forming part of the forest area that is temporarily unstocked as a result of human intervention or natural causes, but which are expected to revert to forest"@en .

ex:Def_def_usa_2004_1274 a ex:Definition ;
    rdfs:label "Land used for growing trees, not including Christmas trees, for commercial purpo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington-Bainbridge_Island ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land used for growing trees, not including Christmas trees, for commercial purposes (as shown by record of income) that has long-term commercial significance; or unharvested forest land preserved in open space for the environmental benefits and maintenance of rural character"@en .

ex:Def_def_usa_2004_1481 a ex:Definition ;
    rdfs:label "Woodland is an area having woody plant species that produce canopy cover of at l..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_2004_1481_criteria ;
    ex:hasSource ex:Source_USA-STATE-Kansas ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Woodland is an area having woody plant species that produce canopy cover of at least 25% of the basal area. (2004)"@en .

ex:Def_def_usa_2004_1481_criteria ex:minCanopyCover "25.0"^^xsd:float ;
    ex:minCanopyCoverSI "25.0"^^xsd:float .

ex:Def_def_usa_2004_789 a ex:Definition ;
    rdfs:label "Includes areas dominated by single-stemmed, woody vegetation unbranched 2 to 3 f..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
