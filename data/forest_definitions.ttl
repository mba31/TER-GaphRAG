ex:Def_def_slo_unknown_1800 a ex:Definition ;
    rdfs:label "(Slovenia) Forest land is a forest or forest plot matching with the definition o..." ;
    ex:appliesTo ex:Country_Slovenia ;
    ex:country "Slovenia" ;
    ex:definitionType "Ecological" ;
