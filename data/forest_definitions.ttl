    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "titled forest is a forest located on land on which the land title is registered"@en .

ex:Def_def_ind_2000_1034 a ex:Definition ;
    rdfs:label "\"Forest means a unit of ecosystem….comprising biological resources, dominated by..." ;
    ex:appliesTo ex:Country_Indonesia ;
