ex:Def_def_uk_2014_1214 a ex:Definition ;
    rdfs:label "(UK) The definition of woodland in United Kingdom forestry statistics is land un..." ;
    ex:appliesTo ex:Country_UK ;
    ex:country "UK" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_uk_2014_1214_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(UK) The definition of woodland in United Kingdom forestry statistics is land under stands of trees with a canopy cover of at least 20% (or having the potential to achieve this), including integral open space, and including felled areas that are awaiting restocking. http://www.forestry.gov.uk/website/foreststats.nsf/byunique/sources.html. From Stefania Pizziran Research Gate 4 Feb 2014."@en .

ex:Def_def_uk_2014_1214_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float .

