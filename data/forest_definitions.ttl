    ex:sectionSub "2.3.1 General definitions" ;
    ex:sectionSubSub "2.3.1.2 As a land cover type" ;
    skos:note "(1980) Land on which the native vegetation (Climax or natural potential) is dominated by trees with at least 25 percent crown coverage at maturity of the trees. (SRM 1980)"@en .

ex:Def_def_unk_1981_1304 a ex:Definition ;
    rdfs:label "Applies to any tree the circumference of which is one metre or more at a point h..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
