    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Open stand of trees up to approximately 18 metres in height in which tree crowns cover at least 30 per cent of the land area but are, for the most part, not overlapping and"@en .

ex:Def_def_eur_unknown_1430_criteria ex:minHeight "18.0"^^xsd:float ;
    ex:minHeightSI "18.0"^^xsd:float .

ex:Def_def_eur_unknown_1431 a ex:Definition ;
    rdfs:label "Other wooded land are areas which have some characteristics of forests but which..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Other wooded land are areas which have some characteristics of forests but which are not forests as defined above. They include open woodland and scrub, shrub and brushland"@en .

