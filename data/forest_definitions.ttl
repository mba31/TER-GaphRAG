    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "“Communal Forest” means an area set aside legally or temporarily by regulation for the sustainable use of non-timber forest products by local communities on a non-commercial basis"@en .

ex:Def_def_uk_unknown_277 a ex:Definition ;
    rdfs:label "Law defines ‘communal forest’ as “A small described forest area immediately adja..." ;
    ex:appliesTo ex:Country_UK ;
    ex:country "UK" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
