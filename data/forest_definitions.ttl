    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Min. Area (ha) = 1.0, Min Crown Cover (%) = 30; Min. Tree Height (m) = 5 Min. Strip Width (m) = ns - Sasaki & Putz 2009 and"@en .

ex:Def_def_cos_2006_417_criteria ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_cos_2012_418 a ex:Definition ;
    rdfs:label "The definition submitted to the CDM (minimum canopy cover of 30%, minimum height..." ;
    ex:appliesTo ex:Country_Costa_Rica ;
    ex:country "Costa Rica" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cos_2012_418_criteria ;
    ex:hasSource ex:Source_United_Nations ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "The definition submitted to the CDM (minimum canopy cover of 30%, minimum height of 5 meters, minimum size of 1 hectare) is used as a preliminary definition for its REDD+ program, but Costa Rica has also reserved the right to change the definition and revise its reference level once a final decision is made and adopted"@en .

ex:Def_def_cos_2012_418_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "1.0"^^xsd:float ;
    ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_cos_2014_419 a ex:Definition ;
    rdfs:label "According to Costa Rica’s Emissions Reduction Project Idea Note (ER-PIN) for des..." ;
    ex:appliesTo ex:Country_Costa_Rica ;
    ex:country "Costa Rica" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cos_2014_419_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "According to Costa Rica’s Emissions Reduction Project Idea Note (ER-PIN) for design purposes of the National Forest Inventory and the MRV for REDD+, Costa Rica has used the definition of forest that it uses for CDM projects: “Forest is an area of land with a minimum size of 1.0 ha, with a canopy cover over 30%, and presenting trees with the potential to reach a minimum height of 5 meters at maturity in situ. A forest may consist of tight formations where trees of various strata and undergrowth cover a high proportion of the ground, or open formations with canopy cover over 30%. Young natural stands and all plantations that have not yet reached a canopy cover of 30%, or a height of 5 meters are considered forest”. the definition of “forest” used in the construction of the proposed FREL is:  Minimum area: 1.00 ha;  Minimum forest canopy cover: 30%;  Minimum height of trees: 5.00 m. This definition is consistent with the definition of “forest” that Costa Rica reported under the Clean Development Mechanism (CDM) and is also consistent with the definition of “forest” used in the context of the national GHG inventory. However, this definition is not consistent with Costa Rica’s reports to FAO’s Forest Resources Assessment (FRA)"@en .

ex:Def_def_cos_2014_419_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "1.0"^^xsd:float ;
    ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_cos_unknown_413 a ex:Definition ;
    rdfs:label "Central American country, “forest” is defined for fiscal etc. reasons in the nat..." ;
    ex:appliesTo ex:Country_Costa_Rica ;
    ex:country "Costa Rica" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
