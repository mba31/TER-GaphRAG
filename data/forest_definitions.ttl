    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(1980) An area on which trees often small and characteristically short-boled relative to their depth of crown, usually form an open canopy, and the intervening areas are occupied by herbaceous and shrubby vegetation. (SRM 1980)"@en .

ex:Def_def_unk_1980_74 a ex:Definition ;
    rdfs:label "(1980) Land on which the native vegetation (Climax or natural potential) is domi..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
