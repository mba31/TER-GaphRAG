ex:Def_def_hun_unknown_876 a ex:Definition ;
    rdfs:label "Forest land - Area of 0.15 ha or more covered with wood – including land with sp..." ;
    ex:appliesTo ex:Country_Hungary ;
    ex:country "Hungary" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_hun_unknown_876_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest land - Area of 0.15 ha or more covered with wood – including land with spontaneous afforestation, land temporarily utilized for other purposes - together with glades and fire strips located in it. Includes forest plantations (seed sowing, planting or coppice sprouting) of 0.15 ha or more. Includes: Forest lands smaller than the limit if surrounded by a real estate registered in a sector other than forestry; and Land directly serving forestry activities (listed explicitly in §9)"@en .

ex:Def_def_hun_unknown_876_criteria ex:minArea "0.15"^^xsd:float ;
    ex:minAreaSI "0.15"^^xsd:float .

ex:Def_def_ind_1879_244 a ex:Definition ;
    rdfs:label "\" Reserved Forest\" means waste land which has been declared as* reserved forest ..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_ind_1879_244_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "\" Reserved Forest\" means waste land which has been declared as* reserved forest at settlement or by any subsequent order of competent authority. * \"'Village Forest\" means such waste land as has been set apart under section 8 or section 9"@en .

ex:Def_def_ind_1879_244_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "20.0"^^xsd:float .

ex:Def_def_ind_1927_245 a ex:Definition ;
    rdfs:label "“forest land” means a piece of land notified by the Government as the forest lan..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "“forest land” means a piece of land notified by the Government as the forest land to develop, protect and conserve forest and includes a rangeland and wasteland"@en .

ex:Def_def_ind_1927_246 a ex:Definition ;
    rdfs:label "Forest is defined as a tract of land that is legally proclaimed to be a forest u..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Forest is defined as a tract of land that is legally proclaimed to be a forest under the forest laws (mainly 1865 and 1927) and is notified as forest in the government gazette"@en .

ex:Def_def_ind_1947_247 a ex:Definition ;
    rdfs:label "\"forest\" means any land which the State Government may, by notification, declare..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "\"forest\" means any land which the State Government may, by notification, declare to be forest for the purposes of this Act and shall be deemed to include any land which is entered as forest or jungle or jungle- Jhori or described by any synonymous term in any record-of-rights finally published under any law for the time being in force unless it is proved that such entry in respect of the land is incorrect ; BIHAR PRIVATE Forest ACT 1947 [Act No IX of 1948]"@en .

ex:Def_def_ind_1960_1104 a ex:Definition ;
    rdfs:label "The Management & Control of Forests), Act 1958, amended in 1960,“Forest is and s..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "The Management & Control of Forests), Act 1958, amended in 1960,“Forest is and shall be deemed to be a forest if in the area there are reasonable number of trees, say not less than 25 trees per acre, reserved or any other forest produce growing on such area, which have been or are capable of being exploited for purposes of business or trade.”"@en .

ex:Def_def_ind_1967_259 a ex:Definition ;
    rdfs:label "Forest under the BFL (Basic Forestry Law) is defined as any kind of land-cover a..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Forest under the BFL (Basic Forestry Law) is defined as any kind of land-cover area (with or without tress), which is stated by the government as forest. It may be in the form of forest area or area without trees which the government as forest has designated"@en .

ex:Def_def_ind_1978_1074 a ex:Definition ;
    rdfs:label "“Forest” means any reserved forest within the meaning of the Kerala Forest Act. ..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "“Forest” means any reserved forest within the meaning of the Kerala Forest Act. 1961 (4 of 1962) and includes any forest vested in the Government under section 3 of the Kerala Private Forests (Vesting and assignment) Act. 1971 (26 of 1971)"@en .

ex:Def_def_ind_1980_248 a ex:Definition ;
    rdfs:label "Any land recorded as forest in any of the land records is legally a forest land...." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Forest_Conservation_Act_1980_From_Vivek_K ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Any land recorded as forest in any of the land records is legally a forest land. This legal connotation provides a working definition of forest land to the forest managers in India for all the practical purposes. This definition disregards whether there is any vegetation on that land or not. [Source: Forest Conservation Act, 1980, From: \"Vivek K. Varma\" v.varma@landfood.unimelb.edu.au Date: Fri, 17 Jul 1998 02:28:29 -0400 (EDT)]"@en .

ex:Def_def_ind_1980_249 a ex:Definition ;
    rdfs:label ") The term “Forest land’ mentioned in Section 2 of the Act refers to reserved fo..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note ") The term “Forest land’ mentioned in Section 2 of the Act refers to reserved forest, protected forest or any area recorded as forest in the Government records. Lands which are notified under Section 4 of the Indian Forest Act would also come within the purview of the Act. (Supreme Court’s Judgment in NTPC’s case). It would also include “Forest” as understood in the dictionary sense. (Supreme Court order dated: 12.12.1996 in WP No. 202/1995 – Annexure-I)… The term “forest” shall not be applicable to the plantations raised on private lands, except notified private forests"@en .

ex:Def_def_ind_1996_519 a ex:Definition ;
    rdfs:label "An extensive are covered by trees and bushes with no agriculture" ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "An extensive are covered by trees and bushes with no agriculture"@en .

ex:Def_def_ind_1997_520 a ex:Definition ;
    rdfs:label "For forest cover assessments - all lands with a tree canopy density of more than..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_ind_1997_520_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "For forest cover assessments - all lands with a tree canopy density of more than 10 percent though they may not be statutorily notified as forest. Thus the forest cover assessments would leave out barren \"forest\" areas but include plantations done outside forest reserves. T P Singh tpsingh@teri.res.in and Forest Survey of India. 1997. The state of Forest Report (Ministry of Environment and Forests. Dehra Dun, India.)"@en .

ex:Def_def_ind_1997_520_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_ind_1998_260 a ex:Definition ;
    rdfs:label "Hutan ialah suatu lapangan bertumbuhan pohon-pohon yang secara keseluruhan merup..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Decision_of_the_Minister_of_Forestry_and_Plantations_on_social_forest_ry_Keputus ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "Hutan ialah suatu lapangan bertumbuhan pohon-pohon yang secara keseluruhan merupakan persekutuan hidup alam hayati beserta alam lingkungannya dan yang ditetapkan oleh Pemerintah sebagai hutan. (Translation: A forest is an area growing trees which as a whole forms a living natural community and natural living environment, which is designated by the government as being forest). Source: Decision of the Minister of Forestry and Plantations on social forest(ry) (Keputusan Menteri Kehutanan dan Perkebunan tentang hutan kemasyarakatan, Number 677/Kpts-II/1998) based on the Forestry Law provided by Nico Smith, MSc. Lecturer at FakultasI Kehutanan Universitas Muhammadiyah Sumatra Barat"@en .

ex:Def_def_ind_1998_529 a ex:Definition ;
    rdfs:label "an area growing trees which as a whole forms a living natural community and a na..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:region "Europe" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "an area growing trees which as a whole forms a living natural community and a natural living environment, which is designated by the government as being a forest\" (Nico Smith 1999)"@en .

ex:Def_def_ind_1998_880 a ex:Definition ;
    rdfs:label "Hutan adalah hamparan lahan yang berisi atau yang dikehendaki akan berisi pepoho..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Nico_Smith_MSc ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Hutan adalah hamparan lahan yang berisi atau yang dikehendaki akan berisi pepohonan, unsur-unsur hayati lainnya, dan non-hayati yang secara keseluruhan merupakan satu kesatuan ekosistem. (Rancangan Undang-Undang Nomor .... Tahun 1998 tentang Kehutanan). (Translation: A forest is a spread out area filled with or planned to be filled with trees, other living (biological) and non-living elements which as a whole form a ecosystem unit. (Law on Forestry, Number ... Year 1998))Other terms used in this law are: - Sumberdaya hutan (forest resource) - Kawasan hutan (forest area) - Kawasan hutan negara (state forest land) - Kawasan hutan adat (traditional forest land) - Kawasan hutan produksi (production forest) - Kawasan hutan lindung (conservation/protected forest). Source: Nico Smith, MSc. Lecturer at Fakultas Kehutanan Universitas Muhammadiyah Sumatra Barat"@en .

ex:Def_def_ind_1998_881 a ex:Definition ;
    rdfs:label "the legal definition of forest in Indonesia is: \"a spread out area filled with o..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:region "Europe" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "the legal definition of forest in Indonesia is: \"a spread out area filled with or planned to be filled with trees, other living (biological) and non-living elements which as a whole form an ecosystem unit\" (Law on Forestry 1998, Tr. Nico Smith 1999)"@en .

ex:Def_def_ind_1999_1073 a ex:Definition ;
    rdfs:label "“Forest” means a reserved forest or protected forest, duly notified as such unde..." ;
    ex:appliesTo ex:Country_India ;
    ex:country "India" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.1 As a declared, legal, or administrative unit" ;
    skos:note "“Forest” means a reserved forest or protected forest, duly notified as such under the Act; “AUTHORITATIVE ENGLISH TEXT OF THIS DEPARTMENT NOTIFICATION No. FFE-A(C) 7-1/96-II DATED 17.11.1999 AS REQUIRED UNDER CLAUSE (3) OF ARTICLE 348 OF THE CONSTITUTION OF INDIA. GOVERNMENT OF HIMACHAL PRADESH FOREST DEPARTMENT NOTIFICATION No. FFE-A(C) 7-1/96-II Dated Shimla-2, the 17-11-1999 and"@en .

ex:Def_def_ind_1999_261 a ex:Definition ;
    rdfs:label "‘forest area’ means a certain area designated or stipulated by the government to..." ;
    ex:appliesTo ex:Country_Indonesia ;
    ex:country "Indonesia" ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "‘forest area’ means a certain area designated or stipulated by the government to be retained as permanent forest, and ‘state forest’ means a forest located on ‘lands bearing no ownership rights’ (the Indonesian phrase is ‘tanah yang tidak dibebani hak atas tanah’). and Moniaga, Sandra 2009. Fighting over the land and forest. Inside Indonesia"@en .

ex:Def_def_ind_1999_262 a ex:Definition ;
    rdfs:label "titled forest is a forest located on land on which the land title is registered" ;
