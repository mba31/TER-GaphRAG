ex:Def_def_eur_2000_1560 a ex:Definition ;
    rdfs:label "(EU 2000). Forest land is defined as land with tree crown cover (stand density) ..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_eur_2000_1560_criteria ;
    ex:hasSource ex:Source_European_Union ;
    skos:note "(EU 2000). Forest land is defined as land with tree crown cover (stand density) of more than about 20% of the area. Continuous forest with trees usually growing to more than about 7 m in height and able to produce wood. This includes both closed forest formations where trees of various storeys and undergrowth cover a high proportion of the ground, and open forest formations with a continuous grass layer in which tree synusiae cover at least 10% of the ground. http://europa.eu.int/estatref/info/sdds/en/for/for_res.htm#toc"@en .

ex:Def_def_eur_2000_1560_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float ;
    ex:minHeight "7.0"^^xsd:float ;
    ex:minHeightSI "7.0"^^xsd:float .

