ex:Def_def_unk_2010_543 a ex:Definition ;
    rdfs:label "To define area as a forest it has to pass these minimum requirements: - tree cro..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_unk_2010_543_criteria ;
