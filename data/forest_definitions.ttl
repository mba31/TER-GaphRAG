    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Working trees - those intentionally established in rural and urban landscapes to achieve specific functions (Perry et al. 2005)"@en .

ex:Def_def_unk_2005_146 a ex:Definition ;
    rdfs:label "Land spanning more than 0.5 hectares with trees higher than 5 meters and a canop..." ;
