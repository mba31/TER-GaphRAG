ex:Def_def_aus_1999_1422 a ex:Definition ;
    rdfs:label "Wooded Land - Land with vegetation with a projected foliage cover of less than 1..." ;
    ex:appliesTo ex:Country_Australia ;
    ex:country "Australia" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
