ex:Def_def_aus_1992_343 a ex:Definition ;
    rdfs:label "An area, incorporating all living and non-living components, that is dominated b..." ;
    ex:appliesTo ex:Country_Australia ;
    ex:country "Australia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_aus_1992_343_criteria ;
    ex:hasSource ex:Source_Ross_Penny_Ross ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "An area, incorporating all living and non-living components, that is dominated by trees having usually a single stem and a mature or potentially mature stand height exceeding 2 metres, and with existing or potential projected crown cover of overstorey strata about equal to or greater than 20 percent. This definition includes both native and plantation regardless of age. (From: \"Ross Penny\"Ross.Penny@nre.vic.gov.au the definition of forest used by the National Forest Inventory (and based on the 1992 Australian National Forest Policy Statement). We include all of the 'tree-forming' mallees (a plant of the genus Eucalyptus) in our definition of forest. From: Roger.Hnatiuk@brs.gov.au. It is also sufficiently broad to encompass areas of trees that are sometimes described as woodlands. From:Jim.Stevenson@affa.gov.au This definition includes Australia's diverse native forests and plantations, regardless of age. It is also sufficiently broad to encompass areas of trees that are sometimes described as woodlands. and Karol.Andrzejewski@affa.gov.au NFI (1992) definition of Forest (from National Forest Policy Statement)"@en .

ex:Def_def_aus_1992_343_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float ;
    ex:minHeight "2.0"^^xsd:float ;
    ex:minHeightSI "2.0"^^xsd:float .

ex:Def_def_aus_1996_344 a ex:Definition ;
    rdfs:label "Forest is defined as areas dominated by trees having usually a single stem and a..." ;
