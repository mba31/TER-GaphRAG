ex:Def_def_unk_unknown_158 a ex:Definition ;
    rdfs:label "Forest Cover - All the trees and other woody plants (underbrush) covering the gr..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_United_Nations ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Forest Cover - All the trees and other woody plants (underbrush) covering the ground in a forest. It includes (a) trees and all shrubs, (b) herbs and shrubs growing thereunder or in openings in the forest or brush fields, (c) litter or fallen leaves, branches, fallen trees and other vegetable material on the forest floor and (d) the rich humus of partially decayed vegetable matter at the surface and top layer of the soil. United Nations Statistical Division"@en .

