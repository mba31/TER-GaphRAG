ex:Def_def_alb_unknown_1283 a ex:Definition ;
    rdfs:label "(Albania) ‘Forest’ is defined as dense woodland with a surface larger than 1000 ..." ;
    ex:appliesTo ex:Country_Albania ;
    ex:country "Albania" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_alb_unknown_1283_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "(Albania) ‘Forest’ is defined as dense woodland with a surface larger than 1000 m2 with a density of forest trees and shrubs not less than 30 %, which produces wood material and has influence on the surrounding environment. ‘Land with forest vegetation’ is defined as forest wood area with a density of forest trees and shrubs from 5 to 30 % which are not registered in the cadastra as other land estates. Forest estate includes also open areas up to 2 ha. such as openings, rocks and sandbank which are in forests, the surfaces occupied by forest shelterbelts, wood lots and shrub surfaces. LEX-FAOC004693. ALBANIA: Law No. 7623 for forestry and forest police service. http://faolex.fao.org/faolex1/"@en .

ex:Def_def_alb_unknown_1283_criteria ex:minArea "2.0"^^xsd:float ;
    ex:minAreaSI "2.0"^^xsd:float ;
    ex:minHeight "1000.0"^^xsd:float ;
    ex:minHeightSI "1000.0"^^xsd:float .

