ex:Def_def_sou_2084_1048 a ex:Definition ;
    rdfs:label "Under the Forest Act, not only does the definition of forest include all biologi..." ;
    ex:appliesTo ex:Country_South_Africa ;
    ex:country "South Africa" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:region "Africa" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Under the Forest Act, not only does the definition of forest include all biological organisms, it also includes the desire to “do anything in a state forest for which a licence is required” (which could apply to hunting) (sec. 29)"@en .

ex:Def_def_sou_unknown_704 a ex:Definition ;
    rdfs:label "forests of all kinds - Government policy in South Africa is formulated to includ..." ;
    ex:appliesTo ex:Country_South_Africa ;
    ex:country "South Africa" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_sou_unknown_704_criteria ;
