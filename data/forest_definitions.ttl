ex:Def_def_nor_1993_1508 a ex:Definition ;
    rdfs:label "(Norway 1993) Land which produces forest or which on an overall farming- and for..." ;
    ex:appliesTo ex:Country_Norway ;
    ex:country "Norway" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_The_Norwegian_Forest_and_Forest_Protection_Act_of_May_21_1965_with_amendments_la ;
    skos:note "(Norway 1993) Land which produces forest or which on an overall farming- and forestry assessment is considered to be most suitable for forest production and is not being used for any other purpose. [Source: The Norwegian Forest and Forest Protection Act of May 21, 1965 with amendments, latest by the Act no. 96 of June 11, 1993. http://www.nijos.no/panorama/!skog.htm From: \"Maksym Polyakov\" <mpoliak@pcomp.usau.kiev.ua Date: Mon, 15 Jun 1998 19:27:19 +0300 (MSD)]"@en .

