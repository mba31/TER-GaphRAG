    ex:minHeightSI "50.0"^^xsd:float .

ex:Def_def_uni_2010_976 a ex:Definition ;
    rdfs:label "The definition of woodland in United Kingdom forestry statistics and in National..." ;
    ex:appliesTo ex:Country_United_Kingdom ;
    ex:country "United Kingdom" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_uni_2010_976_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "The definition of woodland in United Kingdom forestry statistics and in National Inventory is land under stands of trees with a canopy cover of at least 20% (or having the potential to achieve this), including integral open space, and including felled areas that are awaiting restocking. There is no minimum size for a woodland"@en .

ex:Def_def_uni_2010_976_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float .

