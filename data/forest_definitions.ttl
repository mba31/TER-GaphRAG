    skos:note "Clearing of tree formations and their replacement by non-forest land uses. (UN Glossary of Environment Statistics)"@en .

ex:Def_def_unk_unknown_1644 a ex:Definition ;
    rdfs:label "To clear an area, other than purely temporarily, of forest. Clear cutting (even ..." ;
