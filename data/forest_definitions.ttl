ex:Def_def_cam_1994_828 a ex:Definition ;
    rdfs:label "Cameroon is based on the 1994 Forest Code, in which community forests are define..." ;
    ex:appliesTo ex:Country_Cameroon ;
    ex:country "Cameroon" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cam_1994_828_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Cameroon is based on the 1994 Forest Code, in which community forests are defined as forest areas in the ‘non-Permanent Forest Domain’ (NPFD), a land use designation that permits timber extraction, agriculture, mining, and other utilisation activities. Each community forest must not exceed 5,000 hectares, and must be managed by village communities following a simplified management plan that excludes the use of heavy machinery"@en .

ex:Def_def_cam_1994_828_criteria ex:minArea "0.0"^^xsd:float ;
    ex:minAreaSI "0.0"^^xsd:float .

ex:Def_def_cam_2000_1025 a ex:Definition ;
    rdfs:label "\"Forest\" means natural ecosystems, land, water, plants, and micro-organisms etc...." ;
    ex:appliesTo ex:Country_Cambodia ;
    ex:country "Cambodia" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cam_2000_1025_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest\" means natural ecosystems, land, water, plants, and micro-organisms etc. which are dominated by woody plants or bamboo of more than ten (10%) percent and has a size of 0.5 hectare or more, including dryland and wetland forest formations and any non-treed wetlands covering most part of land or open land within a forest that form ten (10%) of that ecosystem. All stages of natural forest succession and planted trees for forestry purposes with a leaf density smaller than ten (10%) percent or former forest land that were degraded by human action or natural acts but is expected to be repaired/improved shall be deemed forest"@en .

