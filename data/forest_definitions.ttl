ex:Def_def_eur_2010_100 a ex:Definition ;
    rdfs:label "Continuously forested areas are defined as areas where trees have reached, or ca..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_eur_2010_100_criteria ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Continuously forested areas are defined as areas where trees have reached, or can reach, at least heights of five metres, making up a crown cover of more than 30 percent….They would normally include forest, forest plantations and other tree plantations such as palm oil. Short rotation coppice [the practice of repeatedly cutting young tree stems down] may qualify if it fulfils the height and canopy cover criteria. Phillips, Leigh. 2010. Palm oil plantations are now 'forests,' says EU. EUObserver.com"@en .

ex:Def_def_eur_2010_100_criteria ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float .

ex:Def_def_eur_2010_101 a ex:Definition ;
    rdfs:label "Continuously forested areas are defined as areas where trees have reached, or ca..." ;
    ex:appliesTo ex:Country_European_Union ;
    ex:country "European Union" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_eur_2010_101_criteria ;
    ex:hasSource ex:Source_European_Union ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Continuously forested areas are defined as areas where trees have reached, or can reach, at least heights of 5 metres, making up a crown cover of more than 30%. They would normally include natural forest, forest plantations and other tree plantations such as oil palm. This means, for example, that a change from forest to oil palm plantation would not per se constitute a breach of the criterion (para 4.2.3, draft communication).”"@en .

ex:Def_def_eur_2010_101_criteria ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float ;
