    ex:hasCriteria ex:Def_def_can_unknown_1306_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Canada-Ontario-Halton Region) Forest means woodlands as defined by The Woodlands Improvement Act, covering a ground area of 10ha or more. http://www.region.halton.on.ca/ppw/OfficialPlan/definitions/cont1.htm"@en .

ex:Def_def_can_unknown_1306_criteria ex:minArea "10.0"^^xsd:float ;
    ex:minAreaSI "10.0"^^xsd:float .

ex:Def_def_can_unknown_1383 a ex:Definition ;
    rdfs:label "(Canada) Afforestation - The conversion of land that has not been forested for a..." ;
    ex:appliesTo ex:Country_Canada ;
    ex:country "Canada" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Canada) Afforestation - The conversion of land that has not been forested for at least 50 years to forested land through human activities such as planting and seeding. http://carbon.cfs.nrcan.gc.ca/definitions_e.html"@en .

ex:Def_def_can_unknown_1392 a ex:Definition ;
    rdfs:label "(Canada) Deforestation - The conversion of forested land to nonforested land as ..." ;
    ex:appliesTo ex:Country_Canada ;
