    ex:hasSource ex:Source_Unknown ;
    skos:note "Traub, Berthold et al. 1998. Effects of Different Definitions on Forest Area Estimation in National Forest Inventories in Europe. Integrated Tools Proceedings, Boise Idaho, 16-20 August. -176-184. http://www.nrs.fs.fed.us/pubs/gtr/gtr_nc212/gtr_nc212_176.pdf"@en .

ex:Def_def_usa_1999_1087 a ex:Definition ;
    rdfs:label "(USA-STATE-Iowa 1999) \"Forest\" means stands of native or introduced trees contai..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Iowa ;
    skos:note "(USA-STATE-Iowa 1999) \"Forest\" means stands of native or introduced trees containing at least two hundred trees per acre and located on privately owned land. However, a stand of fruit trees is not a forest. http://www.legis.state.ia.us/IACODE/1999SUPPLEMENT/161A/42.html"@en .

