    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "1.3"^^xsd:float ;
    ex:minHeightSI "1.3"^^xsd:float .

ex:Def_def_est_1998_447 a ex:Definition ;
    rdfs:label "Forest Act (FA) (1998) forest is defined as a site of woody vegetation with an a..." ;
    ex:appliesTo ex:Country_Estonia ;
    ex:country "Estonia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_est_1998_447_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest Act (FA) (1998) forest is defined as a site of woody vegetation with an area of at least 0,5 ha which meets at least one of the following criteria: 1) the height of the trees is at least 1,3 m and the canopy density at least 30 per cent; 2) it is managed for obtaining timber or other forest produce, or woody vegetation is maintained there for the use in the ways specified in this Act"@en .

