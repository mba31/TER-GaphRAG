ex:Def_def_lit_2001_903 a ex:Definition ;
    rdfs:label "Forest –a land area not less than 0.1 hectare in size covered with trees, the he..." ;
    ex:appliesTo ex:Country_Lithuania ;
    ex:country "Lithuania" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
