ex:Def_def_unk_2007_185 a ex:Definition ;
    rdfs:label "Land spanning more than 0.5 hectares with trees higher than 5 metres and a canop..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2007_185_criteria ;
    ex:hasSource ex:Source_UNEP ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "Land spanning more than 0.5 hectares with trees higher than 5 metres and a canopy cover of more than 10 per cent, or trees able to reach these thresholds in situ. It does not include land that is predominantly under agricultural or urban land use"@en .

ex:Def_def_unk_2007_185_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

ex:Def_def_unk_2007_203 a ex:Definition ;
    rdfs:label "(and Woodlands) - Land under natural or planted stands of trees, whether product..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.3 As a land use type" ;
    skos:note "(and Woodlands) - Land under natural or planted stands of trees, whether productive or not. This category includes land from which forests have been cleared but that will be reforested in the foreseeable future, but it excludes woodland or forest used only for recreation purposes"@en .

ex:Def_def_unk_2007_223 a ex:Definition ;
    rdfs:label "A forest is a community of trees and bushes, which extend on a large area and ma..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A forest is a community of trees and bushes, which extend on a large area and maintain a close interrelationship in ways that their canopy, fauna, soil and climatic conditions create a special ecosystem. Forested lands have similar characteristics to forests, but vegetation is more sparse. They are however very important in maintaining biological balance. Most of these areas, if protected from human activity, will often grow into forests"@en .

ex:Def_def_unk_2007_239 a ex:Definition ;
    rdfs:label "\"forest land\" means a land that is demarcated for the purpose of forest developm..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Administrative" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.1 As a declared, legal, or administrative unit" ;
    skos:note "\"forest land\" means a land that is demarcated for the purpose of forest development and conservation"@en .

