    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Trees with separated crowns, generally <10 m tall. A clearly visible layer of herbs and/or grasses. Source: Bellamy, J.A. Vanuatu Resource Information System. VANRIS Handbook. Via Adam Gerrand"@en .

ex:Def_def_unk_unknown_1484_criteria ex:minHeight "10.0"^^xsd:float ;
    ex:minHeightSI "10.0"^^xsd:float .

ex:Def_def_unk_unknown_1488 a ex:Definition ;
    rdfs:label "An area or biotic community dominated by widely-spaced trees of short stature gr..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
