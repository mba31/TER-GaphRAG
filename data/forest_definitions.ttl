ex:Def_def_unk_2001_130 a ex:Definition ;
    rdfs:label "Forest is a land area of more than 0.5 ha, with a tree canopy cover of more than..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_2001_130_criteria ;
    ex:hasSource ex:Source_UNEP ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "Forest is a land area of more than 0.5 ha, with a tree canopy cover of more than 10 percent, which is not primarily under agriculture or other specific non-forest land use. In the case of young forest or regions where tree growth is climatically suppressed, the trees should be capable of reaching a height of 5 m in situ, and of meeting the canopy cover requirement. ftp://ftp.fao.org/docrep/fao/009/j9345e/j9345e00.pdf"@en .

