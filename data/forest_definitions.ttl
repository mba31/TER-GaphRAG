ex:Def_def_usa_2003_982 a ex:Definition ;
    rdfs:label "Land with a specified minimum tree crown cover and generally more than the speci..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land with a specified minimum tree crown cover and generally more than the specified minimum area, including land that formerly had such tree cover and that will be naturally or artificially regenerated. The trees should generally be able to reach a minimum specified tree height at maturity in situ. It may consist either of closed forest formations in which trees of various stories and undergrowth cover a high proportion of the ground, or of open forest formations with a continuous vegetation cover in which tree crown cover exceeds the minimum percent. Young natural stands and all plantations established for forestry purposes, which have yet to reach the minimum crown density or tree height, are included under forest, as are areas normally forming part of the forest area that is temporarily unstocked as a result of human intervention or natural causes, but which are expected to revert to forest. Limiting measures for qualification as forest land vary by country. Current minimum area, cover, and tree height needed to be classified as forest by country"@en .

ex:Def_def_usa_2003_983 a ex:Definition ;
    rdfs:label "Forest land, as defined by the U.S. Forest Service, includes land at least 10 pe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2003_983_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-ERS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest land, as defined by the U.S. Forest Service, includes land at least 10 percent of which is stocked by trees of any size, or land formerly having had such tree cover that will be naturally or artificially regenerated. Forest land includes transition zones, such as areas between heavily forested and nonforested lands that are at least 10 percent stocked with forest trees and forest areas adjacent to urban and built-up lands. The total includes pinyon-juniper and chaparral areas in the West and afforested areas"@en .

ex:Def_def_usa_2003_983_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_usa_2003_984 a ex:Definition ;
    rdfs:label "Forest-use land (total forest land exclusive of forested areas in parks and othe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2003_984_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-ERS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Forest-use land (total forest land exclusive of forested areas in parks and other special uses), 642 million acres (ERS 2003)"@en .

ex:Def_def_usa_2003_984_criteria ex:minHeight "642.0"^^xsd:float ;
    ex:minHeightSI "642.0"^^xsd:float .

ex:Def_def_usa_2003_993 a ex:Definition ;
    rdfs:label "A land cover/land use category that is at least 10 percent stocked by singlestem..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_2003_993_criteria ;
