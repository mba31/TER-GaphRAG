ex:Def_def_unk_1990_1244 a ex:Definition ;
    rdfs:label "Changes of land use which lead to a depletion of tree crown to less than 10% (th..." ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "Changes of land use which lead to a depletion of tree crown to less than 10% (this definition relates to the definition of forests as ecosystems with a minimum 10% cover of trees). (FAO, 1990) http://www.spcforests.org/Library/usestatus/usestatus.htm"@en .

