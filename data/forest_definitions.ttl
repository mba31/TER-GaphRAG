    ex:sectionMain "2.1 LAND COVER" ;
    skos:note "The characteristics of a land surface as determined by its spectral signature (the unique way in which a given type of land cover reflects and absorbs light)"@en .

ex:Def_def_usa_unknown_779 a ex:Definition ;
    rdfs:label "A stand of trees where trees are no more than 60 feet apart. Based upon excavate..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_unknown_779_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "A stand of trees where trees are no more than 60 feet apart. Based upon excavated roots of some mature trees and determined that a forest could not be a forest if the trees were more than about 20 meters apart. This definition assumed that the trees were mature. This was a definition for the USA. Source: \"J. Foster\" <borealis@mail.wellsgray.net from an article in Journal of Forestry"@en .

ex:Def_def_usa_unknown_779_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "20.0"^^xsd:float .

ex:Def_def_usa_unknown_780 a ex:Definition ;
    rdfs:label "Treeland. Areas on which vegetation is dominated by trees, provided these areas ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-5-Agency1982 ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Treeland. Areas on which vegetation is dominated by trees, provided these areas do not qualify as Built-up land or Cultivated cropland: Examples are areas consisting of such species as Douglas fir, Ponderosa pine, slash pine, oak, aspen, ash, and maple"@en .

ex:Def_def_usa_unknown_782 a ex:Definition ;
    rdfs:label "Forest land is characterized by a predominance of tree cover and is further divi..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-Census_Bureau1995 ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest land is characterized by a predominance of tree cover and is further divided by the U.S. Census into timberland and non-timberland. By definition, the former must be capable of producing 20 cubic feet of industrial wood per acre per year and remain legally open to timber production"@en .

ex:Def_def_usa_unknown_783 a ex:Definition ;
    rdfs:label "Any area dominated by trees, that is not normally subject to inundation during t..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_unknown_783_criteria ;
    ex:hasSource ex:Source_USA-FED-Corps_of_Engineers ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Any area dominated by trees, that is not normally subject to inundation during the growing season or is only periodically influenced by flooding. (Trees understood to be more than 20 feet tall)"@en .

ex:Def_def_usa_unknown_783_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "6.096"^^xsd:float .

ex:Def_def_usa_unknown_786 a ex:Definition ;
    rdfs:label "For the purpose of developing ecological site descriptions, a spatially defined ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA-NRCS ;
