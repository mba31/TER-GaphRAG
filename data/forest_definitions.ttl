ex:Def_def_uni_2010_1515 a ex:Definition ;
    rdfs:label "(United Kingdom 2010) The definition of woodland in United Kingdom forestry stat..." ;
    ex:appliesTo ex:Country_United_Kingdom ;
    ex:country "United Kingdom" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_uni_2010_1515_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(United Kingdom 2010) The definition of woodland in United Kingdom forestry statistics and in National Inventory is land under stands of trees with a canopy cover of at least 20% (or having the potential to achieve this), including integral open space, and including felled areas that are awaiting restocking. There is no minimum size for a woodland. http://uk-air.defra.gov.uk/reports/cat07/1010151419_ukghgi-90-08_main_chapters_Issue3_r.pdf"@en .

ex:Def_def_uni_2010_1515_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float .

