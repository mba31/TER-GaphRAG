ex:Def_def_cro_2010_1006 a ex:Definition ;
    rdfs:label "(Croatia 2010) National definition: Forest is defined as the land covered by for..." ;
    ex:appliesTo ex:Country_Croatia ;
    ex:country "Croatia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_cro_2010_1006_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Croatia 2010) National definition: Forest is defined as the land covered by forest trees formed as forest stand over an area larger than 10 ars (1 ar = 100 m2). Separate forest tree groups over an area up to 10 ars, forest nurseries, windbreaks, tree avenues, and parks in settlements are not considered forests. Faculty of forestry University of Zagreb, Ministry for regional development of forestry and water management, 2010. http://www.efi.int/files/attachments/publications/annex_1_to_efi_technical_report_88__2013.pdf"@en .

ex:Def_def_cro_2010_1006_criteria ex:minHeight "100.0"^^xsd:float ;
    ex:minHeightSI "100.0"^^xsd:float .

