    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest means a unit of ecosystem….comprising biological resources, dominated by trees in their natural forms and environment….\". Indonesia"@en .

ex:Def_def_ind_2000_263 a ex:Definition ;
    rdfs:label "Forest area means a certain area which is designated and/or stipulated by govern..." ;
    ex:appliesTo ex:Country_Indonesia ;
