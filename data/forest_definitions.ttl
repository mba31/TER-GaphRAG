    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_uk_unknown_1449_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Small Islands) Forest is defined as land with tree crown cover of more than 10 percent and area of more than 0.5 ha whose primary use is forestry. The trees should be able to reach a minimum height of 5 metres at maturity in situ. http://cfa.juice-e.co.uk/Example%20paper/Example%20paper.htm"@en .

ex:Def_def_uk_unknown_1449_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
