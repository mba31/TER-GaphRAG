ex:Def_def_ukr_2006_767 a ex:Definition ;
    rdfs:label "In Ukraine's forest are forest areas, including those protective plantings linea..." ;
    ex:appliesTo ex:Country_Ukraine ;
    ex:country "Ukraine" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_ukr_2006_767_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "In Ukraine's forest are forest areas, including those protective plantings linear type, area of not less than 0.1 ha. In Ukraine the forest area does not include: green spaces within settlements (parks, gardens, squares, boulevards, etc.) that are not included in the prescribed manner to the forest; individual trees and groups of trees, shrubs on land, homestead, cottage and garden areas. Supreme Council of Ukraine, 2006"@en .

ex:Def_def_ukr_2006_767_criteria ex:minArea "0.1"^^xsd:float ;
    ex:minAreaSI "0.1"^^xsd:float .

