    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Canada – BC) Production forest - the forest used for production of various commodities, for example timber. [BC's official definition at http://www.for.gov.bc.ca/PAB/PUBLCTNS/GLOSSARY/P.htm]"@en .

ex:Def_def_can_unknown_1807 a ex:Definition ;
