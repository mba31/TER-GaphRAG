    skos:note "Clearing an area of forest for another long-term use. ( )"@en .

ex:Def_def_can_unknown_1653 a ex:Definition ;
    rdfs:label "Regeneration (reforestation): The renewal of a tree crop either by natural means..." ;
    ex:appliesTo ex:Country_Canada ;
    ex:country "Canada" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "3.4 FORESTATION" ;
    ex:sectionSub "3.5.1 Restoration of Land Cover" ;
    ex:sectionSubSub "3.5 REFORESTATION - Reforestation is sorted by restoration of land cover and land cover and use. Several specified the planting of \"crops.\"" ;
    skos:note "Regeneration (reforestation): The renewal of a tree crop either by natural means (seeded on-site from adjacent stands or deposited by wind, birds, or animals) or by planted seedlings or direct seeding"@en .

ex:Def_def_can_unknown_1654 a ex:Definition ;
    rdfs:label "The natural or artificial restocking (i.e., planting, seeding) of an area with f..." ;
    ex:appliesTo ex:Country_Canada ;
