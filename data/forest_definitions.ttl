ex:Def_def_unk_2010_1464 a ex:Definition ;
    rdfs:label "Land with tree canopy cover of more than 5 percent and area of more than 0.5 hec..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_2010_1464_criteria ;
    ex:hasSource ex:Source_United_Nations ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Land with tree canopy cover of more than 5 percent and area of more than 0.5 hectares. Trees, defined by Ecoregion, should be able to reach a minimum height of 2m at maturity in situ. Generally, woodland trees will not excede 5m in height at maturity. Source: Brad Smith, USDA Forest Service, May 2002"@en .

ex:Def_def_unk_2010_1464_criteria ex:minArea "0.5"^^xsd:float ;
