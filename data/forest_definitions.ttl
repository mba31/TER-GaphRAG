    skos:note "Land covered by trees and/or shrubs which is not destined to fulfil forest functions e.g., the belts on river banks. (European Communities 1997b - p. 1225)"@en .

ex:Def_def_cze_unknown_235 a ex:Definition ;
    rdfs:label "Forest - Forest stand with its environment and land designated for the fulfilmen..." ;
