ex:Def_def_unk_unknown_169 a ex:Definition ;
    rdfs:label "Total forest area includes both natural forests and plantations. Total Forest is..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_unknown_169_criteria ;
