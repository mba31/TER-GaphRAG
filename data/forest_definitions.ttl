    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Definition: Forest should be consisted more than 50% of the tree species (listed in the Forest Act) and forest cover is more than 30%. Mezőgazdasági Szakigazgatási Hivatal (MGSZH), 2006"@en .

ex:Def_def_hun_2006_509_criteria ex:minCanopyCover "30.0"^^xsd:float ;
    ex:minCanopyCoverSI "30.0"^^xsd:float .

ex:Def_def_hun_2006_510 a ex:Definition ;
    rdfs:label "Forest land (1000 ha) - With defined tree species, minimum block size 0.5 ha, -C..." ;
    ex:appliesTo ex:Country_Hungary ;
