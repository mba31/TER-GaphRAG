ex:Def_def_unk_1969_818 a ex:Definition ;
    rdfs:label "Forest means any land under forest which no person has acquired a permanent heri..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
