ex:Def_def_hun_unknown_512 a ex:Definition ;
    rdfs:label "By law forest means area covered by woody vegetation with area bigger than 0,15 ..." ;
    ex:appliesTo ex:Country_Hungary ;
    ex:country "Hungary" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
