    ex:definitionType "Land Use" ;
    ex:geographicScope "International" ;
    ex:hasSource ex:Source_UN-FAO ;
    skos:note "(Bhutan 1969) Forest means any land under forest which no person has acquired a permanent heritable and transferable right of use and occupancy. http://extwprlegs1.fao.org/docs/pdf/bhu2744.pdf"@en .

ex:Def_def_unk_1973_1563 a ex:Definition ;
    rdfs:label "(UN-ESCO 1973) The standard international definition of “forest” is an area with..." ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "International" ;
    ex:hasCriteria ex:Def_def_unk_1973_1563_criteria ;
    ex:hasSource ex:Source_United_Nations ;
    skos:note "(UN-ESCO 1973) The standard international definition of “forest” is an area with >25 percent canopy cover by trees (UNESCO 1973; “savannah” is usually considered to be a grass-dominated system with sparse trees [by the UNESCO definition, <25 percent cover]). http://pdf.usaid.gov/pdf_docs/PNADL906.pdf"@en .

ex:Def_def_unk_1973_1563_criteria ex:minCanopyCover "25.0"^^xsd:float ;
    ex:minCanopyCoverSI "25.0"^^xsd:float .

