    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forests are characterised by forest trees (high and coppice forests) that produce or are able to produce at least 1 m3 of commercial timber per hectare per year"@en .

ex:Def_def_gre_unknown_500_criteria ex:minHeight "1.0"^^xsd:float ;
    ex:minHeightSI "1.0"^^xsd:float .

ex:Def_def_gua_1996_501 a ex:Definition ;
    rdfs:label "Native or autochthon ecosystem, intervened or not, regenerated through natural s..." ;
