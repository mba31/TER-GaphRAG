    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Central American country, “forest” is defined for fiscal etc. reasons in the national forest act (Act 3 Ley Forestal No. 7575) as a native ecosystem, with human interventions or not, regenerated through succession or other forest techniques, covering an area of 2 or more hectares, characterized by the presence of mature trees of different ages, species or aspects, with one or more layers covering more than 70% of the surface area and with more than 70 trees per hectare of dbh 15cm or more”"@en .

ex:Def_def_cos_unknown_413_criteria ex:minCanopyCover "70.0"^^xsd:float ;
    ex:minCanopyCoverSI "70.0"^^xsd:float .

ex:Def_def_cos_unknown_414 a ex:Definition ;
    rdfs:label "The Forestry Law considers as forest any extension of land of two ha or greater ..." ;
    ex:appliesTo ex:Country_Costa_Rica ;
    ex:country "Costa Rica" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "The Forestry Law considers as forest any extension of land of two ha or greater with at least 60 trees per hectare"@en .

