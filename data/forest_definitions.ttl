ex:Def_def_slo_unknown_1598 a ex:Definition ;
    rdfs:label "(Slovenia) Forest - A land overgrown with forest trees - stands or other plants ..." ;
    ex:appliesTo ex:Country_Slovenia ;
    ex:country "Slovenia" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_slo_unknown_1598_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Slovenia) Forest - A land overgrown with forest trees - stands or other plants - which provides any of the functions of forests. Includes: land defined as forests in the forest management plan, and forest infrastructure not allocated into a separate lot. Excludes: individual trees and groups of forest trees smaller than 0.05 ha, non-native riverain and windbelt trees, avenues, parks, plantations of forest trees, pens for rearing game, pastures overgrown with forest trees. Definition applies also to forest trees outside forests insofar as they are specifically defined. http://www.fris.sk/Phare/Projects/ManagementOfForestInEurope/PDF/annex2.pdf"@en .

ex:Def_def_slo_unknown_1598_criteria ex:minArea "0.05"^^xsd:float ;
    ex:minAreaSI "0.05"^^xsd:float .

