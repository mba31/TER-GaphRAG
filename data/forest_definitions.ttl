ex:Def_def_uk_2010_1326 a ex:Definition ;
    rdfs:label "(UK 2010) ‘Ancient woodland in England is defined as an area that has been woode..." ;
    ex:appliesTo ex:Country_UK ;
    ex:country "UK" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(UK 2010) ‘Ancient woodland in England is defined as an area that has been wooded continuously since at least 1600 AD. Ancient woodland is divided into ancient semi-natural woodland and plantations on ancient woodland sites. Both types of stand are classed as ancient woods.’ http://www.highweald.org/downloads/publications/1068-rother-district-ancient-woodland-inventory/file.html"@en .

