ex:Def_def_unk_2005_1462 a ex:Definition ;
    rdfs:label "Woodland or forest - This includes woodlot or timber tracts, natural or planted,..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Woodland or forest - This includes woodlot or timber tracts, natural or planted, constituting part of the holding which have or will have value as wood, timber, other forest products or for protection. Forest tree nurseries should be included in this category. Rows, belts and small clumps of trees, bamboo and other woody vegetation should be included in woodland and forest"@en .

