    skos:note "You will note that some of the definitions contain a minimum height for a plant to be classed as a tree. If taken literally, newly planted or established seedlings would not be considered \"trees\" under these definitions. If they are not considered trees, what are they?"@en .

ex:Def_def_unk_unknown_1456 a ex:Definition ;
    rdfs:label "Wooded land, which is not classified as forest, spanning more than 0.5 hectares,..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_unknown_1456_criteria ;
    ex:hasSource ex:Source_UNEP ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Wooded land, which is not classified as forest, spanning more than 0.5 hectares, with trees higher than 5 metres and a canopy cover of 5-10 per cent, or trees able to reach these thresholds in situ, or with a combined cover of shrubs, bushes and trees above 10 per cent. It does not include areas used predominantly for agricultural or urban purposes"@en .

ex:Def_def_unk_unknown_1456_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "5.0"^^xsd:float ;
    ex:minHeightSI "5.0"^^xsd:float .

