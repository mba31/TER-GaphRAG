ex:Def_def_gre_unknown_499 a ex:Definition ;
    rdfs:label "Forest is defined as land with tree crown cover (stand density) of more than abo..." ;
    ex:appliesTo ex:Country_Greece ;
    ex:country "Greece" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_gre_unknown_499_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "Forest is defined as land with tree crown cover (stand density) of more than about 20% of the area, and with trees which usually grow to more than about 7 m in height and are able to produce wood. This includes both, closed forest formations where trees of various storeys and undergrowth cover a high proportion of the ground, and open forest formations with a continuous grass layer in which tree synusia cover at least 10% of the ground"@en .

ex:Def_def_gre_unknown_499_criteria ex:minCanopyCover "20.0"^^xsd:float ;
    ex:minCanopyCoverSI "20.0"^^xsd:float ;
    ex:minHeight "7.0"^^xsd:float ;
    ex:minHeightSI "7.0"^^xsd:float .

