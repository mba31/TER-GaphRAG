    skos:note "Any area of land predominantly covered by trees, and includes areas planted with trees except when such planting is carried out for agricultural purposes. [LEX-FAOC018884] SOLOMON ISLANDS: Forests Act (No. 3 of 1999). Date of text: 24 September 1999"@en .

ex:Def_def_sol_2004_955 a ex:Definition ;
    rdfs:label "Forested land means an area of land predominately covered by trees other than tr..." ;
    ex:appliesTo ex:Country_Solomon_Islands ;
    ex:country "Solomon Islands" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
