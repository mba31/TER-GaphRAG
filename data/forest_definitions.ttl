    ex:minAreaSI "0.5"^^xsd:float ;
    ex:minHeight "1.3"^^xsd:float ;
    ex:minHeightSI "1.3"^^xsd:float .

ex:Def_def_est_1998_1709 a ex:Definition ;
    rdfs:label "(Estonia 1998) Forest Act (FA) (1998) forest is defined as a site of woody veget..." ;
    ex:appliesTo ex:Country_Estonia ;
    ex:country "Estonia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_est_1998_1709_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Estonia 1998) Forest Act (FA) (1998) forest is defined as a site of woody vegetation with an area of at least 0,5 ha which meets at least one of the following criteria: 1) the height of the trees is at least 1,3 m and the canopy density at least 30 per cent; 2) it is managed for obtaining timber or other forest produce, or woody vegetation is maintained there for the use in the ways specified in this Act. http://www.keskkonnainfo.ee/publications/16285_PDF.pdf"@en .

ex:Def_def_est_1998_1709_criteria ex:minArea "5.0"^^xsd:float ;
    ex:minAreaSI "5.0"^^xsd:float ;
    ex:minHeight "3.0"^^xsd:float ;
    ex:minHeightSI "3.0"^^xsd:float .

