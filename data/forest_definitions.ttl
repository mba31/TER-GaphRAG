    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Woodland forest is a transition zone between prairie and bottomland. It is dominated by shrubs, vigorous grasses,and native tree species"@en .

ex:Def_def_usa_unknown_1499 a ex:Definition ;
    rdfs:label "Upland and bottomland forests or idle areas over grown with trees having canopy ..." ;
