ex:Def_def_aus_1998_1086 a ex:Definition ;
    rdfs:label "There are many definitions of what constitutes a forest or woody vegetation. A c..." ;
    ex:appliesTo ex:Country_Australia ;
    ex:country "Australia" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "There are many definitions of what constitutes a forest or woody vegetation. A common definition used by foresters is 20 per cent crown cover which equates to approximately 12 per cent foliage projective cover (FPC) (NFI, 1998)"@en .

ex:Def_def_aus_1998_345 a ex:Definition ;
    rdfs:label "Forest - A land area, incorporating all living and non-living components, domina..." ;
    ex:appliesTo ex:Country_Australia ;
