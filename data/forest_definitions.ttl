    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.2 International definitions" ;
    ex:sectionSubSub "2.3.2.2 As a land cover type" ;
    skos:note "The standard international definition of “forest” is an area with >25 percent canopy cover by trees (UNESCO 1973; “savannah” is usually considered to be a grass-dominated system with sparse trees [by the UNESCO definition, <25 percent cover])"@en .

ex:Def_def_unk_1973_134_criteria ex:minCanopyCover "25.0"^^xsd:float ;
    ex:minCanopyCoverSI "25.0"^^xsd:float .

ex:Def_def_unk_1973_1429 a ex:Definition ;
    rdfs:label "Land with an open cover of trees, the crowns of which do not form a thickly inte..." ;
    ex:appliesTo ex:Country_Unknown ;
