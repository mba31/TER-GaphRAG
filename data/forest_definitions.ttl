    ex:minWidthSI "36.6"^^xsd:float .

ex:Def_def_usa_unknown_1010 a ex:Definition ;
    rdfs:label "Any land that is capable of producing or has produced forest growth or, if lacki..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DOE ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Any land that is capable of producing or has produced forest growth or, if lacking forest growth, has evidence of a former forest and is not now in other use"@en .

ex:Def_def_usa_unknown_1012 a ex:Definition ;
    rdfs:label "Land that is at least 10 percent stocked by forest trees of any size, including ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-EPA ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Land that is at least 10 percent stocked by forest trees of any size, including land that formerly had tree cover and that will be naturally or artificially regenerated. The minimum area for classification of forest land is one acre"@en .

ex:Def_def_usa_unknown_1014 a ex:Definition ;
    rdfs:label "Those ecosystems that have a tree crown density (crown closure percentage) of 10..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-NASA ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.3 As a land use type" ;
    skos:note "Those ecosystems that have a tree crown density (crown closure percentage) of 10% or more and are stocked with trees capable of producing timber or other wood products. This includes land from which trees have been removed to less than 10%, but which have not been developed for other uses. and"@en .

ex:Def_def_usa_unknown_1059 a ex:Definition ;
    rdfs:label "Forestland ecological sites are separated from rangeland ecological sites based ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1059_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-NRCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Forestland ecological sites are separated from rangeland ecological sites based on the historic climax plant community that occupied the site before the arrival of European settlers. An Ecological Site Type of \"Forestland\" is assigned and described where this historic vegetation was dominated by a 25% overstory canopy of trees, as determined by crown perimeter-vertical projection. A tree is defined as a woody-stemmed plant that can grow to 4 meters in height at maturity"@en .

ex:Def_def_usa_unknown_1059_criteria ex:minHeight "4.0"^^xsd:float ;
    ex:minHeightSI "4.0"^^xsd:float .

ex:Def_def_usa_unknown_1060 a ex:Definition ;
    rdfs:label "Land on which the historic climax plant community is dominated by trees" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DA-NRCS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Land on which the historic climax plant community is dominated by trees"@en .

ex:Def_def_usa_unknown_1061 a ex:Definition ;
    rdfs:label "(2) \"forest\" means an ecosystem of at least one acre in size, including timberla..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-DI-BIA ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "(2) \"forest\" means an ecosystem of at least one acre in size, including timberland and woodland, which - (A) is characterized by a more or less dense and extensive tree cover, (B) contains, or once contained, at least ten percent tree crown cover, and (C) is not developed or planned for exclusive nonforest use"@en .

ex:Def_def_usa_unknown_1064 a ex:Definition ;
    rdfs:label "Terrestrial ecosystem (biome) with enough average annual precipitation (at least..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_USA-FED-OOP ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Terrestrial ecosystem (biome) with enough average annual precipitation (at least 76 centimeters or 30 inches) to support growth of various species of trees and smaller forms of vegetation. Office of Policy : Inventory of U.S. Greenhouse Gas Emissions and Sinks. Annex T: Glossary Term Detail"@en .

ex:Def_def_usa_unknown_1109 a ex:Definition ;
    rdfs:label "An assemblage of woody vegetation typically attaining positions in a plant commu..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA-FS-SRS ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "An assemblage of woody vegetation typically attaining positions in a plant community at the tallest level; attains height and diameter growth of canopy-layer trees within established averages for the species"@en .

ex:Def_def_usa_unknown_1111 a ex:Definition ;
    rdfs:label "Forest - a large area of land primarily covered with trees as well as the other ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Arkansas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest - a large area of land primarily covered with trees as well as the other organisms, soil, water and air associated with them. Source: Principles of Silviculture, Frederick F. Baker Jim Grant jim.grant@mail.state.ar.us no official definitions in Arkansas law"@en .

ex:Def_def_usa_unknown_1115 a ex:Definition ;
    rdfs:label "\"Forest\" means a biological community dominated by trees covering a contiguous a..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Delaware ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means a biological community dominated by trees covering a contiguous area of land and includes any definition thereof developed by the Department of Agriculture Forest Service. A \"forest\" may be identified by the diversity of the tree species composing it or by its type. A \"forest type\" is a forest composed of associations of tree species that have similar ecological requirements"@en .

ex:Def_def_usa_unknown_1120 a ex:Definition ;
    rdfs:label "Closed forest--Generally, a unit of vegetation with overstory trees whose crowns..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1120_criteria ;
    ex:hasSource ex:Source_USA-STATE-Hawaii ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Closed forest--Generally, a unit of vegetation with overstory trees whose crowns are mostly touching. Plant communities with trees having a crown cover of 60 percent or more are considered closed forests"@en .

ex:Def_def_usa_unknown_1120_criteria ex:minCanopyCover "60.0"^^xsd:float ;
    ex:minCanopyCoverSI "60.0"^^xsd:float .

ex:Def_def_usa_unknown_1121 a ex:Definition ;
    rdfs:label "\"Forest\" means forestland occupied by forest trees and associated wildlife speci..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Hawaii-Kauai_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means forestland occupied by forest trees and associated wildlife species, and timber thereon"@en .

ex:Def_def_usa_unknown_1122 a ex:Definition ;
    rdfs:label "Forest land means any land which has enough forest growth, standing or down, to ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Idaho ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest land means any land which has enough forest growth, standing or down, to constitute, in the judgement of the Department, an insect or disease infestation breeding ground of a nature to constitute a menace, injurious and dangerous to the forest resources in the district or zone of infestation"@en .

ex:Def_def_usa_unknown_1123 a ex:Definition ;
    rdfs:label "Includes areas that are predominantly covered with trees and woody vegetation" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Includes areas that are predominantly covered with trees and woody vegetation"@en .

ex:Def_def_usa_unknown_1124 a ex:Definition ;
    rdfs:label "Forest means a dense growth of trees and underbrush covering a large tract of la..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest means a dense growth of trees and underbrush covering a large tract of land, or a significant portion of a large tract of land"@en .

ex:Def_def_usa_unknown_1125 a ex:Definition ;
    rdfs:label "Generally, land with trees on it. Foresters define as forestland any land stocke..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1125_criteria ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Generally, land with trees on it. Foresters define as forestland any land stocked with trees of any size that cover 16.7% of the land area. The Changing Illinois Environment: Critical Trends"@en .

ex:Def_def_usa_unknown_1125_criteria ex:minCanopyCover "16.7"^^xsd:float ;
    ex:minCanopyCoverSI "16.7"^^xsd:float .

ex:Def_def_usa_unknown_1128 a ex:Definition ;
    rdfs:label "\"Forestland\" means stands of native or introduced forest plantation of at least ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Iowa ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forestland\" means stands of native or introduced forest plantation of at least three acres, including trees located on privately owned land. However, a stand of fruit trees or Christmas trees is not forestland"@en .

ex:Def_def_usa_unknown_1130 a ex:Definition ;
    rdfs:label "\"Forest land\" means lands dominated by canopy forming trees, or from a postminin..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kentucky ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest land\" means lands dominated by canopy forming trees, or from a postmining land use standpoint, areas planted throughout with trees"@en .

ex:Def_def_usa_unknown_1131 a ex:Definition ;
    rdfs:label "\"Forest\" means a concentration of trees and related vegetation in nonurban areas..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kentucky ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means a concentration of trees and related vegetation in nonurban areas characterized by natural terrain and drainage patterns"@en .

ex:Def_def_usa_unknown_1132 a ex:Definition ;
    rdfs:label "Forest - an ecosystem characterized by a more or less dense and extensive tree c..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kentucky ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest - an ecosystem characterized by a more or less dense and extensive tree cover, often consisting of composition, structure, age class, and associated processes, and commonly including meadows, streams, fish, and wildlife. The State of Kentucky does not have the terms Forest, Forestland, or Tree officially defined in State Statute or Regulation. The Division of Forestry utilizes the Society of American Forester's definitions for these terms as listed in John A. Helms' The Dictionary of Forestry. Steve.Kull@mail.state.ky.us"@en .

ex:Def_def_usa_unknown_1133 a ex:Definition ;
    rdfs:label "Forest - A large area of land primarily covered with trees as well as the other ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Louisiana ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest - A large area of land primarily covered with trees as well as the other organisms, soil, water and air associated with them"@en .

ex:Def_def_usa_unknown_1134 a ex:Definition ;
    rdfs:label "“Forest” means:(i) a biological community dominated by trees or other woody plan..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1134_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "“Forest” means:(i) a biological community dominated by trees or other woody plants covering a land area of 1 acre or more, or (ii) an area that has been cut but not cleared of trees or other woody plants. and"@en .

ex:Def_def_usa_unknown_1134_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float .

ex:Def_def_usa_unknown_1135 a ex:Definition ;
    rdfs:label "A biological community dominated by trees and other woody plants covering a land..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1135_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "A biological community dominated by trees and other woody plants covering a land area of at least 10,000 square feet as long as there are at least 100 live trees per acre with at least 50 percent of those trees having a 2-inch or greater diameter at 4.5 feet above the ground. Areas that have been cut but not cleared of stumps or the root mat may also be included. \"Forest\" does not include orchards. and"@en .

ex:Def_def_usa_unknown_1135_criteria ex:minCanopyCover "50.0"^^xsd:float ;
    ex:minCanopyCoverSI "50.0"^^xsd:float ;
    ex:minHeight "4.5"^^xsd:float ;
    ex:minHeightSI "1.3716000000000002"^^xsd:float .

ex:Def_def_usa_unknown_1136 a ex:Definition ;
    rdfs:label "A dense growth of trees, together with other plants, covering a large area. Acco..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maryland-Rockville ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "A dense growth of trees, together with other plants, covering a large area. According to the Forest and Tree Preservation Ordinance of the City of Rockville, a forest must cover a land area of 10,000 square feet or greater"@en .

ex:Def_def_usa_unknown_1138 a ex:Definition ;
    rdfs:label "Upland Forest - Natural areas dominated by tree cover that is generally over 6 m..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1138_criteria ;
    ex:hasSource ex:Source_USA-STATE-Michigan ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Upland Forest - Natural areas dominated by tree cover that is generally over 6 meters, or 20 feet, in height. The forest cover must occur in an upland setting with an understory of natural plant material or ground cover. If the understory has been altered to accommodate an agricultural or urban land use activity, such as a pasture or park, the area would be assigned to the appropriate land use type. Forest cover occurring in wetland environments would be assigned to the forested wetland group"@en .

ex:Def_def_usa_unknown_1138_criteria ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "6.0"^^xsd:float .

ex:Def_def_usa_unknown_1139 a ex:Definition ;
    rdfs:label "Forestland use areas are generally at least ten percent stocked by trees of any ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Michigan-Alpena_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forestland use areas are generally at least ten percent stocked by trees of any size"@en .

ex:Def_def_usa_unknown_1141 a ex:Definition ;
    rdfs:label "Forest Includes areas with at least two-thirds or more of the total canopy cover..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Minnesota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest Includes areas with at least two-thirds or more of the total canopy cover composed of predominantly woody deciduous or coniferous species"@en .

ex:Def_def_usa_unknown_1142 a ex:Definition ;
    rdfs:label "Forested: Areas where two-thirds or more of the total canopy cover is composed o..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Minnesota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forested: Areas where two-thirds or more of the total canopy cover is composed of predominantly woody deciduous and coniferous species and areas of regenerated or young forest where commercial timber has been completely or partially removed by logging, other management activities or natural events; includes woodlots, shelterbelts and plantation"@en .

ex:Def_def_usa_unknown_1146 a ex:Definition ;
    rdfs:label "\"Forest\" means a tract of land with trees and underbrush" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Montana ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means a tract of land with trees and underbrush"@en .

ex:Def_def_usa_unknown_1147 a ex:Definition ;
    rdfs:label "\"Forest\" means forest land and the timber on the land" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Montana ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means forest land and the timber on the land"@en .

ex:Def_def_usa_unknown_1149 a ex:Definition ;
    rdfs:label "“Forest” means and includes any forest, bushland, grassland, salt marsh, and any..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-New_Jersey ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "“Forest” means and includes any forest, bushland, grassland, salt marsh, and any combination thereof"@en .

ex:Def_def_usa_unknown_1150 a ex:Definition ;
    rdfs:label "Forested - that tree species with an average height greater than 20 feet are the..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1150_criteria ;
    ex:hasSource ex:Source_USA-STATE-New_Jersey ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forested - that tree species with an average height greater than 20 feet are the predominant vegetation present"@en .

ex:Def_def_usa_unknown_1150_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "6.096"^^xsd:float .

ex:Def_def_usa_unknown_1153 a ex:Definition ;
    rdfs:label "\"Forest\" means an area of land normally supporting a growth of planted tree cove..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-North_Dakota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means an area of land normally supporting a growth of planted tree cover, woodlands, or windbreaks"@en .

ex:Def_def_usa_unknown_1154 a ex:Definition ;
    rdfs:label "Forest Lands have a tree-crown areal density (crown closure percentage) of 10 pe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Ohio ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest Lands have a tree-crown areal density (crown closure percentage) of 10 percent or more, are stocked with trees capable of producing timber or other wood products, and exert an influence on the climate or water regime"@en .

ex:Def_def_usa_unknown_1155 a ex:Definition ;
    rdfs:label "\"Forestland\" means any woodland, brushland, timberland, grazing land or clearing..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forestland\" means any woodland, brushland, timberland, grazing land or clearing that, during any time of the year, contains enough forest growth, slashing or vegetation to constitute, in the judgment of the forester, a fire hazard, regardless of how the land is zoned or taxed. As used in this subsection, \"clearing\" means any grassland, improved area, lake, meadow, mechanically or manually cleared area, road, rocky area, stream or other similar forestland opening that is surrounded by or contiguous to forestland and that has been included in areas classified as forestland under ORS 526.305 to 526.370 and"@en .

ex:Def_def_usa_unknown_1156 a ex:Definition ;
    rdfs:label "Forests are a biological community dominated by trees and other woody plants cov..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Pennsylvania-Centre_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forests are a biological community dominated by trees and other woody plants covering a land area of one acre or more. This also includes forests that have been cut but not cleared. In other areas, Forests are a biological community dominated by trees and other woody plants covering a land area of 10,000 square feet or greater"@en .

ex:Def_def_usa_unknown_1157 a ex:Definition ;
    rdfs:label "Any tract or contiguous tracts of land, ten (10) acres or larger, exclusive of h..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Rhode_Island ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Any tract or contiguous tracts of land, ten (10) acres or larger, exclusive of house site, bearing a dense growth of trees, including underbrush and young regenerating forest and ancillary habitat areas having either the quality of self perpetuation, or being dependent upon its development by the planting and replanting of trees in stands of closely growing timber, actively managed under a stewardship plan approved by the director"@en .

ex:Def_def_usa_unknown_1158 a ex:Definition ;
    rdfs:label "From a fire management perspective - Lands shall be construed as \"forest land\" w..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-South_Carolina ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "From a fire management perspective - Lands shall be construed as \"forest land\" which have enough forest growth, standing or down, or have sufficient inflammable debris or, outside of corporate limits, to constitute, in the judgement of the State Commission of Forestry, a fire menace to itself or adjoining lands"@en .

ex:Def_def_usa_unknown_1161 a ex:Definition ;
    rdfs:label "\"Forest\" means a tract of land thick with trees and underbrush. and" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Texas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest\" means a tract of land thick with trees and underbrush. and"@en .

ex:Def_def_usa_unknown_1162 a ex:Definition ;
    rdfs:label "(3) \"Forest land\" means land on which the trees are potentially valuable for tim..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Texas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "(3) \"Forest land\" means land on which the trees are potentially valuable for timber products, protection of watersheds, wildlife habitat, recreational uses, or for other purposes, but does not include land within the incorporated limits of a village, town, or city. and"@en .

ex:Def_def_usa_unknown_1163 a ex:Definition ;
    rdfs:label "Deciduous or evergreen trees dominant; mostly greater than 30 feet tall with clo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1163_criteria ;
    ex:hasSource ex:Source_USA-STATE-Texas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Deciduous or evergreen trees dominant; mostly greater than 30 feet tall with closed crowns or nearly so (71 to 100 percent canopy cover); midstory generally apparent except in managed monoculture"@en .

ex:Def_def_usa_unknown_1163_criteria ex:minHeight "30.0"^^xsd:float ;
    ex:minHeightSI "9.144"^^xsd:float .

ex:Def_def_usa_unknown_1164 a ex:Definition ;
    rdfs:label "Areas, groves, or stands of mature or largely mature (i.e., greater than six inc..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Utah-Tremonton ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Areas, groves, or stands of mature or largely mature (i.e., greater than six inches caliper) trees covering an area greater than one-quarter acre; or groves of mature trees (greater than 12 inches caliper) consisting of more than 10 individual trees"@en .

ex:Def_def_usa_unknown_1166 a ex:Definition ;
    rdfs:label "\"Forest land\" means land on which forest trees are found. Under Authority of Dep..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Virginia ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "\"Forest land\" means land on which forest trees are found. Under Authority of Department of Forestry. § 10.1-1178. Definitions. \"Starr, James\" starrj@dof.state.va.us"@en .

ex:Def_def_usa_unknown_1167 a ex:Definition ;
    rdfs:label "For Gypsy Moth Spraying - Any spray block proposed for treatment under this prog..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1167_criteria ;
    ex:hasSource ex:Source_USA-STATE-Virginia ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "For Gypsy Moth Spraying - Any spray block proposed for treatment under this program must contain an area that meets the following definition of susceptible forest. A susceptible forest is a wooded area where the trees are 25 feet or more in height and 50% or more of the surface area, when viewed from above, is covered by the tree crowns of moderately or highly susceptible hardwood tree species. Any block that does not contain a forested area as defined will not be accepted for treatment under this program. Residential or other qualified properties with only scattered ornamental trees and shrubs or only a few large shade trees are not acceptable. However, residential or other qualified properties, even if they do not contain trees directly around them, are acceptable if they are less than 200 feet from a susceptible forest"@en .

ex:Def_def_usa_unknown_1167_criteria ex:minHeight "25.0"^^xsd:float ;
    ex:minHeightSI "7.62"^^xsd:float .

ex:Def_def_usa_unknown_1169 a ex:Definition ;
    rdfs:label "(a) \"Timberland\" means any surface real property except farm woodlots of not les..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-West_Virginia ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "(a) \"Timberland\" means any surface real property except farm woodlots of not less than ten contiguous acres which is primarily in forest and which, in consideration of their size, has sufficient numbers of commercially valuable species of trees to constitute at least forty percent normal stocking of forest trees which are well distributed over the growing site"@en .

ex:Def_def_usa_unknown_1171 a ex:Definition ;
    rdfs:label "Forest -We informally use the FS definition of >10% crown cover to define forest..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1171_criteria ;
    ex:hasSource ex:Source_USA-STATE-Wyoming ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.2 As a land cover type" ;
    skos:note "Forest -We informally use the FS definition of >10% crown cover to define forest vs nonforest. To the best of my knowledge there is no definition either in statute or in any written documents. \"Howard Pickerd\" HPICKE@state.wy.us"@en .

ex:Def_def_usa_unknown_1171_criteria ex:minCanopyCover "10.0"^^xsd:float ;
    ex:minCanopyCoverSI "10.0"^^xsd:float .

ex:Def_def_usa_unknown_1186 a ex:Definition ;
    rdfs:label "Land not currently developed for nonforest use and having a stocking value of at..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1186_criteria ;
    ex:hasSource ex:Source_USA-FED-DA-FS-NC ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land not currently developed for nonforest use and having a stocking value of at least 10.0 of all live forest trees of any size or formerly having a stocking value of at least 10.0. Unimproved roads and trails, streams or other bodies of water or clearings in forest areas will be classed as forest if less than 120 feet wide. The minimum area for classification of forest land is one acre and 120 feet in width. Roadside, streamside, and shelterbelt strips of timber must be at least 120 feet wide to qualify as forest land. Also see definitions for land area, commercial forest land, noncommercial forest land, productive-reserved forest land, stocking, unproductive forest land, and water. North Central FIA manual 9/99 – terms not in National Manual"@en .

ex:Def_def_usa_unknown_1186_criteria ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_unknown_1189 a ex:Definition ;
    rdfs:label "An area managed for the production of timber and other forest products, or maint..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DA_R8 ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "An area managed for the production of timber and other forest products, or maintained under woody vegetation for indirect benefits as protection of a watershed, recreation, or wildlife habitat"@en .

ex:Def_def_usa_unknown_1190 a ex:Definition ;
    rdfs:label "Land bearing a stand of trees of any stature, including seedlings, and of specie..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1190_criteria ;
    ex:hasSource ex:Source_USA-FED-EPA-R3 ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land bearing a stand of trees of any stature, including seedlings, and of species attaining a minimum of 6 feet average height at maturity or land from which such a stand has been removed but on which no other use has been substituted. The term is commonly limited to land not in farms; forests on farms are commonly called woodland or farm forest"@en .

ex:Def_def_usa_unknown_1190_criteria ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "1.8288000000000002"^^xsd:float .

ex:Def_def_usa_unknown_1191 a ex:Definition ;
    rdfs:label "\"Forest land\" means land stocked or having been stocked with forest trees of any..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Alaska ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land stocked or having been stocked with forest trees of any size and not currently developed for nonforest use, regardless of whether presently available or accessible for commercial purposes, and includes any such land under state, municipal, or private ownership"@en .

ex:Def_def_usa_unknown_1193 a ex:Definition ;
    rdfs:label "Land bearing forest growth, or land from which the forest has been removed, and ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Arkansas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land bearing forest growth, or land from which the forest has been removed, and is in any stage of forest growth, or production, or maintains the potential for forest growth"@en .

ex:Def_def_usa_unknown_1194 a ex:Definition ;
    rdfs:label "\"Forestland\" means the land: (1) can support 10 percent or more tree cover with ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-California ;
    ex:region "California" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forestland\" means the land: (1) can support 10 percent or more tree cover with trees native to California, including native oaks, (generally but not always this is Site V (Dunning) and better timberland); and (2) is zoned to allow forest resource management"@en .

ex:Def_def_usa_unknown_1195 a ex:Definition ;
    rdfs:label "‘‘Forest’’ means lands that support, or can support,’’ at least 10 percent tree ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-California ;
    ex:region "California" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "‘‘Forest’’ means lands that support, or can support,’’ at least 10 percent tree canopy cover and that allow for management of one or more forest resources including timber, fish and wildlife, biodiversity, water quality, recreation, aesthetics and other public benefits. and"@en .

ex:Def_def_usa_unknown_1196 a ex:Definition ;
    rdfs:label "“Forest Land” means lands, which are suited for and are appropriately retained f..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-California-Mendocino_County ;
    ex:region "California" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "“Forest Land” means lands, which are suited for and are appropriately retained for the growing, harvesting and production of timber and forest and timber-related products. The classification includes lands eligible to be zoned Timberland Production (TPZ), including lands which have the present or future potential for timber production, intermixed smaller parcels and other contiguous lands, the inclusion of which is necessary for the protection and efficient management of forest resource lands"@en .

ex:Def_def_usa_unknown_1197 a ex:Definition ;
    rdfs:label "\"Forest land\" means land of which at least ten percent is stocked by forest tree..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Colorado ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land of which at least ten percent is stocked by forest trees of any size and includes land that formerly had such tree cover and that will be naturally or artificially regenerated. \"Forest land\" includes roadside, streamside, and shelterbelt strips of timber which have a crown width of at least one hundred twenty feet. \"Forest land\" includes unimproved roads and trails, streams, and clearings which are less than one hundred twenty feet wide"@en .

ex:Def_def_usa_unknown_1199 a ex:Definition ;
    rdfs:label "``Forest\" means land stocked by trees of any size used in the production of fore..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Florida ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "``Forest\" means land stocked by trees of any size used in the production of forest products, or forest land that has been harvested and is not currently developed for nonforest use. and"@en .

ex:Def_def_usa_unknown_1200 a ex:Definition ;
    rdfs:label "Timberland - Must be a minimum of 20 acres in size and in planted pines or a pre..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1200_criteria ;
    ex:hasSource ex:Source_USA-STATE-Florida-Hernando_Co ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Timberland - Must be a minimum of 20 acres in size and in planted pines or a predominantly natural stand of pines. A forestry management plan must be implemented and followed and a copy of the plan kept on file with the Property Appraiser's Office. Larger tracts will be reviewed and approved based on the merchantability of the timber and whether or not management has been sufficient. This guideline covers both hard wood and mixed tracts. Christmas tree production will be considered as nursery land"@en .

ex:Def_def_usa_unknown_1200_criteria ex:minArea "20.0"^^xsd:float ;
    ex:minAreaSI "8.09372"^^xsd:float .

ex:Def_def_usa_unknown_1202 a ex:Definition ;
    rdfs:label "Forestland means privately owned land being held and used primarily for the cont..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Idaho ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland means privately owned land being held and used primarily for the continuous purpose of growing and harvesting trees of a marketable species"@en .

ex:Def_def_usa_unknown_1206 a ex:Definition ;
    rdfs:label "\"Forest\" means an area whose principal crop is trees. and" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest\" means an area whose principal crop is trees. and"@en .

ex:Def_def_usa_unknown_1207 a ex:Definition ;
    rdfs:label "\"Forestry\" means land used or managed for the long-term production of wood, wood..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forestry\" means land used or managed for the long-term production of wood, wood fiber, or wood-derived products. Allowable support facilities include water impoundments, access and fire control lanes, erosion control structures such as grassed waterways, downdrains, terraces and sediment ponds, and other incidental facilities related to sound multiple use management of the forest resource"@en .

ex:Def_def_usa_unknown_1208 a ex:Definition ;
    rdfs:label "Land used or managed for the long-term production of wood, wood fiber or wood de..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land used or managed for the long-term production of wood, wood fiber or wood derived products. Land used for facilities in support of forest harvest and management operations that is adjacent to or an integral part of these operations is also included"@en .

ex:Def_def_usa_unknown_1211 a ex:Definition ;
    rdfs:label "Forest land - Land at least 10% stocked by forest trees of any size, or formerly..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1211_criteria ;
    ex:hasSource ex:Source_USA-STATE-Kansas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land - Land at least 10% stocked by forest trees of any size, or formerly having such tree cover, and not currently developed for non-forest use. Stocking is measured by comparing specified standards with basal area and /or number of trees, age or size and spacing. The minimum area classification for forest land is 1 acre. Roadside, streamside, and shelterbelt strips of timber must have a crown width of at least 120 feet to qualify as forest land. \"An Analysis of the Forest Resources of Kansas\", Leatherberry, Schmidt, Strickler & Aslin, USDA/FS NCRS NC-334. Robert L. Atchison ratchiso@oznet.ksu.edu"@en .

ex:Def_def_usa_unknown_1211_criteria ex:minArea "1.0"^^xsd:float ;
    ex:minAreaSI "0.404686"^^xsd:float ;
    ex:minHeight "120.0"^^xsd:float ;
    ex:minHeightSI "36.576"^^xsd:float .

ex:Def_def_usa_unknown_1212 a ex:Definition ;
    rdfs:label "Forest land\" means land used or managed for the long-term production of wood, wo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kentucky ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land\" means land used or managed for the long-term production of wood, wood fiber, or wood derived products. Land used for facilities in support of forest harvest and management operations which is adjacent to or an integral part of these operations is also included"@en .

ex:Def_def_usa_unknown_1213 a ex:Definition ;
    rdfs:label "Forestland - land at least 10 percent stocked by forest trees of any size, inclu..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Kentucky ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland - land at least 10 percent stocked by forest trees of any size, including land that formerly had such cover and that will be naturally or artificially regenerated. The State of Kentucky does not have the terms Forest, Forestland, or Tree officially defined in State Statute or Regulation. The Division of Forestry utilizes the Society of American Forester's definitions for these terms as listed in John A. Helms' The Dictionary of Forestry. Steve.Kull@mail.state.ky.us"@en .

ex:Def_def_usa_unknown_1214 a ex:Definition ;
    rdfs:label "\"Forest land\" means land used for the production of forest products" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maine ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land used for the production of forest products"@en .

ex:Def_def_usa_unknown_1215 a ex:Definition ;
    rdfs:label "Forest land. \"Forest land\" means land used primarily for growth of trees to be h..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maine ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land. \"Forest land\" means land used primarily for growth of trees to be harvested for commercial use, but does not include ledge, marsh, open swamp, bog, water and similar areas, which are unsuitable for growing a forest product or for harvesting for commercial use even though these areas may exist within forest lands. Source"@en .

ex:Def_def_usa_unknown_1221 a ex:Definition ;
    rdfs:label "Land bearing forest growth or land from which the forest has been removed but wh..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Maryland ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land bearing forest growth or land from which the forest has been removed but which shows evidence of past forest occupancy and which is not now in other use"@en .

ex:Def_def_usa_unknown_1223 a ex:Definition ;
    rdfs:label "\"Forest\" means a biological community dominated by trees and other woody plants ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1223_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland-Easton ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest\" means a biological community dominated by trees and other woody plants covering a land area of 10,000 square feet or greater. B. \"Forest\" includes: (1) Areas that have at least 100 live trees per acre with at least 50 percent of those trees having a 2-inch or greater diameter at 4.5 feet above the ground and larger; and (2) Areas that have been cut but not cleared. C. \"Forest\" does not include orchards"@en .

ex:Def_def_usa_unknown_1223_criteria ex:minCanopyCover "50.0"^^xsd:float ;
    ex:minCanopyCoverSI "50.0"^^xsd:float ;
    ex:minHeight "4.5"^^xsd:float ;
    ex:minHeightSI "1.3716000000000002"^^xsd:float .

ex:Def_def_usa_unknown_1225 a ex:Definition ;
    rdfs:label "A biological community dominated by trees and other woody plants covering a land..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1225_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland-Rockville ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "A biological community dominated by trees and other woody plants covering a land area of 10,000 square feet or greater. Forest includes: (1) Areas that have at least 100 trees per acre with at least 50 percent of those trees having a 2-inch or greater dbh. (2) Forest areas that have been cut, but not cleared. Forest does not include orchards"@en .

ex:Def_def_usa_unknown_1225_criteria ex:minCanopyCover "50.0"^^xsd:float ;
    ex:minCanopyCoverSI "50.0"^^xsd:float .

ex:Def_def_usa_unknown_1226 a ex:Definition ;
    rdfs:label "Forest Land means land with at least 15% of the area occupied by the crowns of f..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Massachusetts ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest Land means land with at least 15% of the area occupied by the crowns of forest trees of any size that contains at least 7.5 square feet of basal area per acre; or that is a plantation containing at least 500 trees per acre; or land recently harvested that is in the process of regeneration"@en .

ex:Def_def_usa_unknown_1227 a ex:Definition ;
    rdfs:label "Forest Lands: (1) To be eligible for classification, land must meet the followin..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1227_criteria ;
    ex:hasSource ex:Source_USA-STATE-Massachusetts ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest Lands: (1) To be eligible for classification, land must meet the following criteria: (a) be a parcel of land containing ten or more adjacent or contiguous acres; (b) be at least 16 and 7/8% stocked with forest products and contain at least 7 and 5/10 square feet of basal area per acre by forest trees of any size; or formerly had such tree cover and is not currently developed for nonforest use, or is a plantation containing at least 500 trees per acre; and (c) has no subdivision plan on file. (2) The following areas may be included in the calculation of acreage: (a) certain permanent or temporary wetlands, water courses and submerged areas and other minor unproductive areas deemed by the State Forester to be comparable with forest production; (b) cleared rightsofway not exceeding 20 feet in width, including road bed, brushed out road edges, and other reasonable improvements to reduce erosion of the rightofway and to protect forest land, wetlands and stream crossings, or when the primary purpose of the improvement is for forest protection and access for forest management. The maximum width may be exceeded for turnouts, turn arounds or for temporary storage areas for forest products. Source: 304 CMR 8.00: CHAPTER 61, FOREST CLASSIFICATION"@en .

ex:Def_def_usa_unknown_1227_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "6.096"^^xsd:float .

ex:Def_def_usa_unknown_1228 a ex:Definition ;
    rdfs:label "Land that is at least sixteen and seven-tenths per cent stocked, that contains a..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1228_criteria ;
    ex:hasSource ex:Source_USA-STATE-Massachusetts ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land that is at least sixteen and seven-tenths per cent stocked, that contains at least seven and five-tenths square feet of basal area per acre by forest trees of any size; or that formerly had such tree cover and is not currently developed for non-forest use; or that is a plantation containing at least five hundred trees per acre. [Source Chapter 61 Massachusetts Taxation Law"@en .

ex:Def_def_usa_unknown_1228_criteria ex:minHeight "61.0"^^xsd:float ;
    ex:minHeightSI "61.0"^^xsd:float .

ex:Def_def_usa_unknown_1229 a ex:Definition ;
    rdfs:label "\"Forest land\" means a tract of land or the timber rights in that land owned or o..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1229_criteria ;
    ex:hasSource ex:Source_USA-STATE-Michigan ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means a tract of land or the timber rights in that land owned or occupied by a member, which land is at least 10% occupied by forest tree species with a growth potential of 50 cubic feet per acre per year and consists of 40 acres or more. Forest land includes land from which forest tree species have been removed and have not been restocked, but does not include land converted to uses other than the growing of forest tree species or land currently zoned for uses incompatible with forest practices"@en .

ex:Def_def_usa_unknown_1229_criteria ex:minArea "40.0"^^xsd:float ;
    ex:minAreaSI "16.18744"^^xsd:float .

ex:Def_def_usa_unknown_1230 a ex:Definition ;
    rdfs:label "\"Forest land\" means timbered land, potential timber-producing land, cutover or b..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Michigan ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means timbered land, potential timber-producing land, cutover or burned timber land or grass lands not including lands devoted to agriculture"@en .

ex:Def_def_usa_unknown_1231 a ex:Definition ;
    rdfs:label "(d) \" Forest land\" means a tract of land that may include nonproductive land tha..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Michigan ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "(d) \" Forest land\" means a tract of land that may include nonproductive land that is intermixed with productive land that is an integral part of a managed forest and that meets all the following: (i) Does not have material natural resources other than those resources suitable for forest growth or the potential for forest growth. (ii) Is not used for agricultural, mineral extraction except as provided in section 51113, grazing, industrial, developed recreational, residential, resort, commercial, or developmental purposes. (iii) The owner agrees to develop, maintain, and actively manage the land as a commercial forest through planting, natural reproduction, or other silvicultural practices. Source"@en .

ex:Def_def_usa_unknown_1234 a ex:Definition ;
    rdfs:label "Forest land or forest. Forest land or forest, means land on which occurs a stand..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Minnesota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land or forest. Forest land or forest, means land on which occurs a stand or potential stand of trees valuable for timber products, watershed or wildlife protection, recreational uses or other purposes, and shall include lands owned or controlled by the state of Minnesota"@en .

ex:Def_def_usa_unknown_1236 a ex:Definition ;
    rdfs:label "\"Forest land\" means contiguous land of 15 acres or more in one ownership that is..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1236_criteria ;
    ex:hasSource ex:Source_USA-STATE-Montana ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means contiguous land of 15 acres or more in one ownership that is capable of producing timber that can be harvested in commercial quantity and is producing timber unless the trees have been removed by man through harvest, including clearcuts, or by natural disaster, including but not limited to fire. Forest land includes land: a) that has not been converted to another use; and b) on which the annual net wood production equals or exceeds 25 cubic feet an acre at the culmination of mean annual increment"@en .

ex:Def_def_usa_unknown_1236_criteria ex:minArea "15.0"^^xsd:float ;
    ex:minAreaSI "6.07029"^^xsd:float .

ex:Def_def_usa_unknown_1237 a ex:Definition ;
    rdfs:label "“Forest” or “forest land” means land on which occurs a stand or potential stand ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Nevada ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "“Forest” or “forest land” means land on which occurs a stand or potential stand of trees valuable for timber products, watershed or wildlife protection, recreational uses or for other purposes"@en .

ex:Def_def_usa_unknown_1238 a ex:Definition ;
    rdfs:label "Land which is at least 10 percent occupied by forest trees of any size or former..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Nevada ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land which is at least 10 percent occupied by forest trees of any size or formerly having had such tree cover and not currently developed for non-forest use. Lands developed for non-forest use include areas for crops, improved pasture, residential, or administrative areas, improved roads of any width, and adjoining road clearing and power line clearing of any width. Water Words Dictionary, Lake and Water Words Glossary, and (36 CFR 219.3)"@en .

ex:Def_def_usa_unknown_1239 a ex:Definition ;
    rdfs:label "Forest land means land primarily devoted to and suitable for forest crop product..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-New_York ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land means land primarily devoted to and suitable for forest crop production under accepted evenaged or unevenaged forest management systems through natural regeneration or through forestation and sufficiently stocked with forest trees to produce a merchantable forest crop within 30 years of time of original certification. Forest land shall consist of a stand or stands of commercial species of forest trees which contain at least either 500 stems per acre or 60 square feet of basal area per acre which shall be evenly distributed over the area of the stand. The department may approve a smaller number of planted trees per acre if the resulting spacing between trees is appropriate for satisfactory growth for the species being planted. For natural seedlings to be part of a stand, they must be at least one foot in height, and planted trees must be at least in their third growing season on the site"@en .

ex:Def_def_usa_unknown_1241 a ex:Definition ;
    rdfs:label "Individually owned forestland consisting of one or more tracts, one of which con..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1241_criteria ;
    ex:hasSource ex:Source_USA-STATE-North_Carolina ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Individually owned forestland consisting of one or more tracts, one of which consists of at least 20 acres that are in actual production and are not included in a farm unit"@en .

ex:Def_def_usa_unknown_1241_criteria ex:minArea "20.0"^^xsd:float ;
    ex:minAreaSI "8.09372"^^xsd:float .

ex:Def_def_usa_unknown_1242 a ex:Definition ;
    rdfs:label "Land that is a part of a forest unit that is actively engaged in the commercial ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-North_Carolina ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land that is a part of a forest unit that is actively engaged in the commercial growing of trees under a sound management program. Forestland includes wasteland that is a part of the forest unit, but the wasteland included in the unit shall be appraised under the use-value schedules as wasteland. A forest unit may consist of more than one tract of forestland, but at least one of the tracts must meet the requirements in G.S. 105-277.3(a)(3), and each tract must be under a sound management program. and"@en .

ex:Def_def_usa_unknown_1243 a ex:Definition ;
    rdfs:label "Forestland means land that is a part of a forest unit that is actively engaged i..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1243_criteria ;
    ex:hasSource ex:Source_USA-STATE-North_Carolina-Counties ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland means land that is a part of a forest unit that is actively engaged in the commercial growing of trees under a sound management program. Forestland includes wasteland that is a part of the forest unit, but the wasteland included in the unit shall be appraised under the use value schedules as wasteland. The requirements for a forestland deferment are as follows: May consist of more than one tract of forestland, but at least one of the tracts must meet the qualification requirements and each tract must be under a sound management program. One tract must consist of at least 20 acres that are in actual production and are not included in a farm unit. If individually owned, the property must be the owner's residence or have been owned by the current owner or a relative of the current owner for four years preceding January 1 of the year in which the benefit is claimed. and"@en .

ex:Def_def_usa_unknown_1243_criteria ex:minArea "20.0"^^xsd:float ;
    ex:minAreaSI "8.09372"^^xsd:float .

ex:Def_def_usa_unknown_1246 a ex:Definition ;
    rdfs:label "\"Forests\" means forest land that is at least ten percent (10%) stocked by forest..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oklahoma ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forests\" means forest land that is at least ten percent (10%) stocked by forest trees of any size, whether of commercial or noncommercial species, or formerly having such tree cover and not currently developed for nonforest use, including woodlands, woodlots, windbreaks and shelterbelts; Source: &sect;2-1301-102"@en .

ex:Def_def_usa_unknown_1247 a ex:Definition ;
    rdfs:label "\"Forestland\" means land zoned in a county comprehensive plan for forest or farm ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forestland\" means land zoned in a county comprehensive plan for forest or farm use that is capable of producing commercial hardwood or softwood timber, regardless of the vegetation currently on the land"@en .

ex:Def_def_usa_unknown_1248 a ex:Definition ;
    rdfs:label "“Forestland\" means forestland that is a parcel of land of more than 10 acres tha..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1248_criteria ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "“Forestland\" means forestland that is a parcel of land of more than 10 acres that has been zoned in the comprehensive plan for exclusive farm use, forest use or farm and forest use and that is, as of the assessment date for which value for the forest homesite is being determined: (a) Land that has as its highest and best use the growing and harvesting of trees of a marketable species; (b) Land that has been designated as forestland under ORS 321.257 to 321.390 or 321.805 to 321.825; or (c) Land that has been classified under ORS 321.705 to 321.765"@en .

ex:Def_def_usa_unknown_1248_criteria ex:minArea "10.0"^^xsd:float ;
    ex:minAreaSI "4.04686"^^xsd:float .

ex:Def_def_usa_unknown_1249 a ex:Definition ;
    rdfs:label "Any land that is capable of producing or has produced forest growth or, if lacki..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Any land that is capable of producing or has produced forest growth or, if lacking forest growth, has evidence of a former forest and is not now in other use"@en .

ex:Def_def_usa_unknown_1250 a ex:Definition ;
    rdfs:label "Forestland” means land used for the growing and harvesting of forest tree specie..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland” means land used for the growing and harvesting of forest tree species, regardless of how the land is zoned, taxed or how any state statutes or local ordinances, rules or regulations are applied. and"@en .

ex:Def_def_usa_unknown_1251 a ex:Definition ;
    rdfs:label "Land that is used for the growing and harvesting of forest tree species" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land that is used for the growing and harvesting of forest tree species"@en .

ex:Def_def_usa_unknown_1252 a ex:Definition ;
    rdfs:label "Forest lands are (1) lands composed of existing and potential forest lands suita..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon-Klamath_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest lands are (1) lands composed of existing and potential forest lands suitable for commercial forest uses; (2) other forested lands needed for watershed protection, wildlife and fish habitat, and recreation; (3) lands where extreme conditions of climate, soil and topography require the maintenance of vegetative cover irrespective of use; and (4) other forested lands in urban and agricultural areas that provide urban buffers, wind breaks, wildlife and fish habitat, livestock, scenic corridors and recreation use"@en .

ex:Def_def_usa_unknown_1253 a ex:Definition ;
    rdfs:label "Land used for the long-term production of wood, wood fiber or wood-derived produ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Pennsylvania ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land used for the long-term production of wood, wood fiber or wood-derived products; watershed protection or site stabilization and for the production, protection and management of species of fish and wildlife. Land used for facilities in support of forestry and watershed management operations which is adjacent to or an integral part of these operations is also included"@en .

ex:Def_def_usa_unknown_1254 a ex:Definition ;
    rdfs:label "“Forestland” means any tract or contiguous tracts of land, five (5) acres or mor..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Rhode_Island ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "“Forestland” means any tract or contiguous tracts of land, five (5) acres or more bearing a dense growth of trees, young regenerating forest, and having either the quality of selfperpetuation, or being dependent upon its development by the planting and replanting"@en .

ex:Def_def_usa_unknown_1255 a ex:Definition ;
    rdfs:label "I.2.c. Forestland - In this report, forestland is defined in the same way as \"co..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Rhode_Island ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "I.2.c. Forestland - In this report, forestland is defined in the same way as \"commercial forestland,\" and is based on the standard definition developed by the USDA Forest Service. According to the Forest Service, \"Commercial forestland is land that is capable of producing more than 20 cubic feet of biomass per acre per year.\""@en .

ex:Def_def_usa_unknown_1256 a ex:Definition ;
    rdfs:label "The term \"forest land\" means any tract or contiguous tracts of land, ten (10) ac..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Rhode_Island ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "The term \"forest land\" means any tract or contiguous tracts of land, ten (10) acres or larger bearing a dense growth of trees, including any underbrush thereon, and having either the quality of self perpetuation, or being dependent upon its development by the planting and replanting of trees in stands of closely growing timber, actively managed under a forest management plan approved by the director of environmental management. and"@en .

ex:Def_def_usa_unknown_1259 a ex:Definition ;
    rdfs:label "\"Forest land\" means land constituting a forest unit engaged in the growing of tr..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Tennessee ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land constituting a forest unit engaged in the growing of trees under a sound program of sustained yield management or any tract of fifteen (15) or more acres having tree growth in such quantity and quality and so managed as to constitute a forest; Source: and"@en .

ex:Def_def_usa_unknown_1260 a ex:Definition ;
    rdfs:label "\"Forest land\" means land on which the trees are potentially valuable for timber ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Texas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "\"Forest land\" means land on which the trees are potentially valuable for timber products, protection of watersheds, wildlife habitat, recreational uses, or for other purposes, but does not include land within the incorporated limits of a village, town, or city"@en .

ex:Def_def_usa_unknown_1261 a ex:Definition ;
    rdfs:label "Forest land” means land on which the trees are potentially valuable for timber p..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Texas ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land” means land on which the trees are potentially valuable for timber products"@en .

ex:Def_def_usa_unknown_1262 a ex:Definition ;
    rdfs:label "(9) \"Managed forest land\" means any land, exclusive of any housesite, which is a..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1262_criteria ;
    ex:hasSource ex:Source_USA-STATE-Vermont ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "(9) \"Managed forest land\" means any land, exclusive of any housesite, which is at least 25 acres in size and which is under active forest management for the purpose of growing and harvesting repeated forest crops in accordance with accepted forest management practices. There shall be a presumption that land is under active forest management if at least 50 percent of the land: (A) is certified to be a \"tree farm\" under the American Tree Farm System; (B) has qualified for a federal cost-sharing forest improvement program, and that program has actually been carried out within the past five years; (C) is certified by the county forester as conforming with accepted forest management practices; or (D) conforms with such criteria for managed forest land as are accepted by the board; Source: Vt. Stat. Ann. tit. 32, &sect;&sect; 3751 to 3775"@en .

ex:Def_def_usa_unknown_1262_criteria ex:minArea "25.0"^^xsd:float ;
    ex:minAreaSI "10.11715"^^xsd:float .

ex:Def_def_usa_unknown_1263 a ex:Definition ;
    rdfs:label "Forest land means any land, exclusive of any housesite, which is under active fo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Vermont ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forest land means any land, exclusive of any housesite, which is under active forest management for the purpose of growing and harvesting repeated forest crops"@en .

ex:Def_def_usa_unknown_1267 a ex:Definition ;
    rdfs:label "To qualify for this category, the property must be a minimum of twenty acres and..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Virginia-Loudoun_Coounty ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "To qualify for this category, the property must be a minimum of twenty acres and must meet the standards for productive forestland or nonproductive forestland"@en .

ex:Def_def_usa_unknown_1272 a ex:Definition ;
    rdfs:label "(3) \"Timber land\" means any parcel of land that is five or more acres or multipl..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "(3) \"Timber land\" means any parcel of land that is five or more acres or multiple parcels of land that are contiguous and total five or more acres which is or are devoted primarily to the growth and harvest of forest crops for commercial purposes. Wash. Rev. Code secs. 84.34.010 to - .922"@en .

ex:Def_def_usa_unknown_1273 a ex:Definition ;
    rdfs:label "State Tax Assessment- Any parcel of land twenty or more acres in size or multipl..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "State Tax Assessment- Any parcel of land twenty or more acres in size or multiple parcels of land that are contiguous and total twenty acres or more in size that is primarily used for the growth and harvesting of timber"@en .

ex:Def_def_usa_unknown_1275 a ex:Definition ;
    rdfs:label "Timber Land means any parcel of land that is five or more acres or multiple parc..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington-San_Juan_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Timber Land means any parcel of land that is five or more acres or multiple parcels of land that are contiguous and total five or more acres which is or are devoted primarily to the growth and harvest of forest crops for commercial purposes"@en .

ex:Def_def_usa_unknown_1276 a ex:Definition ;
    rdfs:label "Land designated as ‘forest land’ means any parcel of land twenty or more acres i..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington-San_Juan_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Land designated as ‘forest land’ means any parcel of land twenty or more acres in size or multiple parcels of land that are contiguous and total twenty acres or more in size that is primarily used for the growth and harvesting of timber. Forest land refers only to the land"@en .

ex:Def_def_usa_unknown_1277 a ex:Definition ;
    rdfs:label "Forestland means all land in contiguous ownership of 20 or more acres; which is ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington-Stevens_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.3 As a land use type" ;
    skos:note "Forestland means all land in contiguous ownership of 20 or more acres; which is primarily devoted to and used for growing and harvesting timber"@en .

ex:Def_def_usa_unknown_1282 a ex:Definition ;
    rdfs:label "\"Forest land\" means timberland defined pursuant to subdivision (g), and other la..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-California ;
    ex:region "California" ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest land\" means timberland defined pursuant to subdivision (g), and other lands that have been withdrawn from timber production, such as units of the state park system, national parks, and wilderness areas"@en .

ex:Def_def_usa_unknown_1285 a ex:Definition ;
    rdfs:label "\"Forest land\" means land which is at least ten percent stocked by trees of any s..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1285_criteria ;
    ex:hasSource ex:Source_USA-STATE-Minnesota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest land\" means land which is at least ten percent stocked by trees of any size and capable of producing timber, or of exerting an influence on the climate or on the water regime; land from which the trees described above have been removed to less than ten percent stocking and which has not been developed for other use; and afforested areas. Source: Section: 88.01 continued"@en .

ex:Def_def_usa_unknown_1285_criteria ex:minHeight "26.0"^^xsd:float ;
    ex:minHeightSI "26.0"^^xsd:float .

ex:Def_def_usa_unknown_1287 a ex:Definition ;
    rdfs:label "\"Forest land\" means land that has enough timber, standing or down, slash, or bru..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Montana ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest land\" means land that has enough timber, standing or down, slash, or brush to constitute in the judgment of the department a fire menace to life or property. Grassland and agricultural areas are included when those areas are intermingled with or contiguous to and no further than one-half mile from areas of forest land. and"@en .

ex:Def_def_usa_unknown_1288 a ex:Definition ;
    rdfs:label "Nebraska accepts the definitions of forestland, forest, etc. as defined in the U..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Nebraska ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Nebraska accepts the definitions of forestland, forest, etc. as defined in the U.S. Forest Service's Forest Inventory and Analysis program. ghergenr@unlnotes.unl.edu"@en .

ex:Def_def_usa_unknown_1289 a ex:Definition ;
    rdfs:label "\"Forestland'' means all lands in this state, except those owned and managed by t..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-New_Hampshire ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forestland'' means all lands in this state, except those owned and managed by the United States of America, which by reason of their location and character of soil have the capacity to grow trees and the continuance of which under forest cover is of substantial importance to the public interest"@en .

ex:Def_def_usa_unknown_1290 a ex:Definition ;
    rdfs:label "A \"forest\" means and includes any forest, brush land, grass land, salt marsh, wo..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-New_Jersey ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A \"forest\" means and includes any forest, brush land, grass land, salt marsh, wooded area and any combination thereof, including but not limited to, an open space area, public lands, wetlands, park lands, natural habitats, a State conservation area, a wildlife refuge area or any other designated undeveloped open space whether or not it is subject to specific protection under law"@en .

ex:Def_def_usa_unknown_1291 a ex:Definition ;
    rdfs:label "\"Forest land\" includes not only lands which may be covered with tree growth but ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-New_York ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest land\" includes not only lands which may be covered with tree growth but also lands which are best adapted to forests"@en .

ex:Def_def_usa_unknown_1292 a ex:Definition ;
    rdfs:label "\"Forest\" means an area of land normally supporting a growth of planted tree cove..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-North_Dakota ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest\" means an area of land normally supporting a growth of planted tree cover, woodlands, or windbreaks"@en .

ex:Def_def_usa_unknown_1293 a ex:Definition ;
    rdfs:label "\"Forestland\" means any woodland, brushland, timberland, grazing land or clearing..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forestland\" means any woodland, brushland, timberland, grazing land or clearing, which, during any time of the year, contains enough forest growth, slashing or vegetation to constitute, in the opinion of the forester, a fire hazard, regardless of how the land is zoned or taxed. Source: 526.005 Definitions"@en .

ex:Def_def_usa_unknown_1294 a ex:Definition ;
    rdfs:label "Forest land is land which either is being held or used predominantly to grow and..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Oregon-Yamhill_County ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Forest land is land which either is being held or used predominantly to grow and harvest trees of a; marketable species and has been designated as forest land or is land the highest and best use of which is to grow and harvest such trees. A. Land may qualify if the designated area is at least two contiguous acres of bare land or two contiguous acres plus one homesite of improved land in one ownership. B. The land must meet one of the following stocking requirements: 1.Trees of a marketable species must be growing on the land, and there must be at least a minimum number of these trees per acre according to the rules established by the state forester. Call the state forester, extension service or your county assessor for more information. 2.If the land does not meet the requirements in (1) above, the owner must give the assessor a written management plan for establishing trees to meet the minimum stocking requirements. At least one-fifth (20 percent), but not less than two acres, of the area in the plan shall be planted by December 31 of the first assessment year that the land is designated as forest land. Each additional year thereafter, a minimum of 1/5 (20 percent) of the area shall be planted, in addition to the previous year's requirements. At the end of the fifth year after designation is approved by the assessor, 100 percent of the area in the plan must be planted. Extensions to planting requirements may be granted by the assessor if a loss of planted stock occurs due to conditions beyond the control of the land owner"@en .

ex:Def_def_usa_unknown_1295 a ex:Definition ;
    rdfs:label "Forests are defined as ecosystems dominated by trees, but with other components ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Pennsylvania ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Forests are defined as ecosystems dominated by trees, but with other components such as shrubs, herbs, mammals, birds, insects, microscopic creatures, soil, air, water, and the interactive processes that bind them together"@en .

ex:Def_def_usa_unknown_1359 a ex:Definition ;
    rdfs:label "A woody plant which at maturity is usually 6 m (20 feet) or more in height and g..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1359_criteria ;
    ex:hasSource ex:Source_USA-FED-DI-FWS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A woody plant which at maturity is usually 6 m (20 feet) or more in height and generally has a single trunk, unbranched for 1 m or more above the ground, and a more or less definite crown; e.g., red maple (Acer rubrum), northern white cedar (Thuja occidentalis)"@en .

ex:Def_def_usa_unknown_1359_criteria ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "6.0"^^xsd:float .

ex:Def_def_usa_unknown_1361 a ex:Definition ;
    rdfs:label "\"Tree\" means a tree or other object of natural growth" ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Airports ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Tree\" means a tree or other object of natural growth"@en .

ex:Def_def_usa_unknown_1362 a ex:Definition ;
    rdfs:label "Tree - a woody plant at least 8 feet tall with one well-defined stem and a more ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1362_criteria ;
    ex:hasSource ex:Source_USA-STATE-Arkansas ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Tree - a woody plant at least 8 feet tall with one well-defined stem and a more or less definitely formed crown. Other definitions say a woody plant from 12 - 15 feet tall with one well-defined stem and a more or less definitely formed crown. Several sources. The SAF definition is one stem and 15 feet. Other definitions ranged from 8 - 15 feet. Jim Grant jim.grant@mail.state.ar.us no official definitions in Arkansas law"@en .

ex:Def_def_usa_unknown_1362_criteria ex:minHeight "8.0"^^xsd:float ;
    ex:minHeightSI "2.4384"^^xsd:float .

ex:Def_def_usa_unknown_1363 a ex:Definition ;
    rdfs:label "\"Tree\" or \"trees\" means any tree, standing or felled, living or dead, and includ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Illinois ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Tree\" or \"trees\" means any tree, standing or felled, living or dead, and includes both those trees included within the definition of \"timber\" in Section 2 of the \"Timber Buyers Licensing Act\" and Christmas trees. The term does not apply to trees or parts of trees that have been cut into firewood"@en .

ex:Def_def_usa_unknown_1364 a ex:Definition ;
    rdfs:label "Forest trees. The ash, black cherry, black walnut, butternut, catalpa, coffee tr..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Iowa ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Forest trees. The ash, black cherry, black walnut, butternut, catalpa, coffee tree, the elms, hackberry, the hickories, honey locust, Norway and Carolina poplars, mulberry, the oaks, sugar maple, cottonwood, soft maple, osage orange, basswood, black locust, European larch and other coniferous trees, and all other forest trees introduced into the state for experimental purposes, shall be considered forest trees within the meaning of this chapter. In forest reservations which are artificial groves, the willows, box elder, and other poplars shall be included among forest trees for the purposes of this chapter when they are used as protecting borders not exceeding two rows in width around a forest reservation, or when they are used as nurse trees for forest trees in such forest reservation, the number of such nurse trees not to exceed one hundred on each acre; provided that only box elder shall be used as nurse trees. Source: 427C.5"@en .

ex:Def_def_usa_unknown_1365 a ex:Definition ;
    rdfs:label "A woody plant usually having one or more erect perennial stems, a stem diameter ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1365_criteria ;
    ex:hasSource ex:Source_USA-STATE-Kansas ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A woody plant usually having one or more erect perennial stems, a stem diameter at breast height of at least 3 inches, a more or less definitely formed crown of foliage, and a height of at least 13 feet at maturity. Robert L. Atchison ratchiso@oznet.ksu.edu"@en .

ex:Def_def_usa_unknown_1365_criteria ex:minHeight "13.0"^^xsd:float ;
    ex:minHeightSI "3.9624"^^xsd:float .

ex:Def_def_usa_unknown_1366 a ex:Definition ;
    rdfs:label "A woody perennial plant, typically large and with a well-defined stem or stems c..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1366_criteria ;
    ex:hasSource ex:Source_USA-STATE-Kentucky ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A woody perennial plant, typically large and with a well-defined stem or stems carrying a more or less definite crown (usually more that 12 feet in height at maturity). The State of Kentucky does not have the terms Forest, Forestland, or Tree officially defined in State Statute or Regulation. The Division of Forestry utilizes the Society of American Forester's definitions for these terms as listed in John A. Helms' The Dictionary of Forestry. Steve.Kull@mail.state.ky.us"@en .

ex:Def_def_usa_unknown_1366_criteria ex:minHeight "12.0"^^xsd:float ;
    ex:minHeightSI "3.6576000000000004"^^xsd:float .

ex:Def_def_usa_unknown_1368 a ex:Definition ;
    rdfs:label "\"Tree\" means a large, branched woody plant having one or several self-supporting..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1368_criteria ;
    ex:hasSource ex:Source_USA-STATE-Maryland-Easton ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Tree\" means a large, branched woody plant having one or several self-supporting stems or trunks that reach a height of at least 20 feet at maturity"@en .

ex:Def_def_usa_unknown_1368_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "6.096"^^xsd:float .

ex:Def_def_usa_unknown_1371 a ex:Definition ;
    rdfs:label "A woody plant which at maturity is usually 6 meters (20 feet) or more in height ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1371_criteria ;
    ex:hasSource ex:Source_USA-STATE-Nevada ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A woody plant which at maturity is usually 6 meters (20 feet) or more in height and generally has a single trunk, unbranched for 1 m or more above the ground, and a more or less definite crown; e.g., red maple (Acer rubrum), northern white cedar (Thuja occidentalis). Water Words Dictionary and Lake and Water Words Glossary"@en .

ex:Def_def_usa_unknown_1371_criteria ex:minHeight "6.0"^^xsd:float ;
    ex:minHeightSI "6.0"^^xsd:float .

ex:Def_def_usa_unknown_1373 a ex:Definition ;
    rdfs:label "\"Forest trees\" means only those trees which are a part of and constitute a stand..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Virginia ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest trees\" means only those trees which are a part of and constitute a stand of potential, immature, or mature commercial timber trees. The term \"forest trees\" includes shade trees of any species around houses, along highways and within cities and towns if the trees constitute an insect or disease menace to nearby timber trees or timber stands. Under Authority of Department of Forestry. § 10.1-1178. Definitions. \"Starr, James\" starrj@dof.state.va.us"@en .

ex:Def_def_usa_unknown_1374 a ex:Definition ;
    rdfs:label "Real Estate - TREE. A tree is single woody stem of a species presently or prospe..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Virginia ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Real Estate - TREE. A tree is single woody stem of a species presently or prospectively suitable for commercial industrial wood products. Standards for Classification of Real Estate As Devoted To Forest Use Under The Virginia Land Use Assessment Law Under the authority of 58.1-3229, et. seq. of the Code of Virginia \"Starr, James\" starrj@dof.state.va.us"@en .

ex:Def_def_usa_unknown_1375 a ex:Definition ;
    rdfs:label "\"Forest trees\" does not include hardwood trees cultivated by agricultural method..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-STATE-Washington ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Forest trees\" does not include hardwood trees cultivated by agricultural methods in growing cycles shorter than fifteen years if the trees were planted on land that was not in forest use immediately before the trees were planted and before the land was prepared for planting the trees. \"Forest trees\" includes Christmas trees, but does not include Christmas trees that are cultivated by agricultural methods, as that term is defined in RCW 84.33.035"@en .

ex:Def_def_usa_unknown_1376 a ex:Definition ;
    rdfs:label "A woody plant which at maturity is 20 feet or more in height, with a single trun..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1376_criteria ;
    ex:hasSource ex:Source_USA-STATE-Wisconsin ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.4.1 Definitions" ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "A woody plant which at maturity is 20 feet or more in height, with a single trunk, unbranched for at least several feet above the ground and having a more or less definite crown"@en .

ex:Def_def_usa_unknown_1376_criteria ex:minHeight "20.0"^^xsd:float ;
    ex:minHeightSI "6.096"^^xsd:float .

ex:Def_def_usa_unknown_1474 a ex:Definition ;
    rdfs:label "Those lands with 5 percent or greater crown cover in tree species not typically ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DI-BLM ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Those lands with 5 percent or greater crown cover in tree species not typically used in commercially processed wood products, including such species as pinyon pine, juniper, white oak, live oak, and black spruce. Stocking can be measure by either crown density, stem density, or basal area. Include land that formerly had such tree cover and that will be managed to be naturally or artificially regenerated to tree cover"@en .

ex:Def_def_usa_unknown_1475 a ex:Definition ;
    rdfs:label "Woodland, which is defined as \"forest land,\" includes deciduous, evergreen, and ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1475_criteria ;
    ex:hasSource ex:Source_USA-FED-DI-GS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Woodland, which is defined as \"forest land,\" includes deciduous, evergreen, and mixed forest land, and orchards. The woodland data layer identifies deforestation or reforestation resulting from urbanization or conservation. The woodland is compiled using criteria based on tint and spectral reflectance. The minimum mapping unit for woodland is 10 acres. The classification scheme adopted for woodland is a modification of the Anderson Level II classification system. All woodland areas are collected as polygons, compiled into one separate coverage, and assigned category 44"@en .

ex:Def_def_usa_unknown_1475_criteria ex:minArea "10.0"^^xsd:float ;
    ex:minAreaSI "4.04686"^^xsd:float .

ex:Def_def_usa_unknown_1476 a ex:Definition ;
    rdfs:label "Open formations of small to medium height trees; tree height over 10 m and tree ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_usa_unknown_1476_criteria ;
    ex:hasSource ex:Source_USA-FED-DI-GS ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Open formations of small to medium height trees; tree height over 10 m and tree cover generally between 50 and 75 percent; canopies are often contiguous, with open areas between trees; grass understory can be scattered to dense, often associated with other herbaceous plants"@en .

ex:Def_def_usa_unknown_1476_criteria ex:minCanopyCover "75.0"^^xsd:float ;
    ex:minCanopyCoverSI "75.0"^^xsd:float ;
    ex:minHeight "10.0"^^xsd:float ;
    ex:minHeightSI "10.0"^^xsd:float .

ex:Def_def_usa_unknown_1477 a ex:Definition ;
    rdfs:label "\"Woodlands\" is defined in CSR 38-2-2.134 to mean commercial woodlands where the ..." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasSource ex:Source_USA-FED-DI-OSM ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "\"Woodlands\" is defined in CSR 38-2-2.134 to mean commercial woodlands where the postmining land use would result in the development of a commercial product for which flat or gently rolling land is essential to facilitate the operation of mechanical harvesting equipment"@en .

ex:Def_def_usa_unknown_1478 a ex:Definition ;
    rdfs:label "A unit of vegetation dominated by trees whose crowns generally are not touching...." ;
    ex:appliesTo ex:Country_USA ;
    ex:country "USA" ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
