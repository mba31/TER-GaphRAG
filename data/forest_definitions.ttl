ex:Def_def_unk_2009_707 a ex:Definition ;
    rdfs:label "“Forest” mean any land containing a vegetation association dominated by trees of..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "“Forest” mean any land containing a vegetation association dominated by trees of any size, whether exploitable or not, capable of producing wood or other products, potentially capable of influencing climate, exercising an influence on the soil, water regime, and providing habitat for wildlife, and includes woodlands; (CAMP Task Team, 2013)"@en .

ex:Def_def_unk_2010_1463 a ex:Definition ;
    rdfs:label "Other wooded land - Land not classified as “Forest”, spanning more than 0.5 hect..." ;
    ex:appliesTo ex:Country_Unknown ;
    ex:definitionType "Ecological/Miscellaneous" ;
    ex:geographicScope "Local/State" ;
    ex:hasCriteria ex:Def_def_unk_2010_1463_criteria ;
    ex:hasSource ex:Source_UN-FAO ;
    ex:sectionMain "2.4 TREE" ;
    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "Other wooded land - Land not classified as “Forest”, spanning more than 0.5 hectares; with trees higher than 5 meters and a canopy cover of 5-10 percent, or trees able to reach these thresholds in situ; or with a combined cover of shrubs, bushes and trees above 10 percent. It does not include land that is predominantly under agricultural or urban land use. FRA 2010"@en .

ex:Def_def_unk_2010_1463_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
