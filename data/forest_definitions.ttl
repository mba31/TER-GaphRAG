    ex:sectionSub "2.5 WOODS, WOODLAND, OTHER WOODED LANDS (OWL)." ;
    ex:sectionSubSub "2.3.4.4 Ecological/Miscellaneous Definitions" ;
    skos:note "An area or biotic community dominated by widely-spaced trees of short stature growing on warm, dry sites. In the Southwest, common woodland species are oak, pinyon, and juniper; these woodlands usually occur below 8,000 feet elevation"@en .

ex:Def_def_unk_unknown_1488_criteria ex:minHeight "0.0"^^xsd:float ;
    ex:minHeightSI "0.0"^^xsd:float .

ex:Def_def_unk_unknown_1489 a ex:Definition ;
    rdfs:label "An area primarily covered with trees" ;
