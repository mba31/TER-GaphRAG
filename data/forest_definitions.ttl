ex:Def_def_cos_unknown_181 a ex:Definition ;
    rdfs:label "(Costa Rica ) Central American country, “forest” is defined for fiscal etc. reas..." ;
    ex:appliesTo ex:Country_Costa_Rica ;
    ex:country "Costa Rica" ;
    ex:definitionType "Land Use" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_cos_unknown_181_criteria ;
    ex:hasSource ex:Source_Unknown ;
    skos:note "(Costa Rica ) Central American country, “forest” is defined for fiscal etc. reasons in the national forest act (Act 3 Ley Forestal No. 7575) as a native ecosystem, with human interventions or not, regenerated through succession or other forest techniques, covering an area of 2 or more hectares, characterized by the presence of mature trees of different ages, species or aspects, with one or more layers covering more than 70% of the surface area and with more than 70 trees per hectare of dbh 15cm or more”. http://wiki.awf.forst.uni-goettingen.de/wiki/index.php/Forest_Definition"@en .

ex:Def_def_cos_unknown_181_criteria ex:minCanopyCover "70.0"^^xsd:float ;
    ex:minCanopyCoverSI "70.0"^^xsd:float .

