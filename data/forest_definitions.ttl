    ex:country "Peru" ;
    ex:definitionType "Land Cover" ;
    ex:geographicScope "National" ;
    ex:hasCriteria ex:Def_def_per_2010_656_criteria ;
    ex:hasSource ex:Source_Unknown ;
    ex:sectionMain "2.3 FOREST/FOREST LAND" ;
    ex:sectionSub "2.3.3 National definitions" ;
    ex:sectionSubSub "2.3.3.2 As a land cover type" ;
    skos:note "a forest within the CDM context is defined as “Land with canopy cover of more than 30 per cent of the area and a minimum area of 0.5 ha. Trees must reach a minimum height of 5m at maturity in situ.”"@en .

ex:Def_def_per_2010_656_criteria ex:minArea "0.5"^^xsd:float ;
    ex:minAreaSI "0.5"^^xsd:float ;
